+def clear_step(*, prefix: str, teacher_name: str, step: int) -> None:
+    """Cleaner (driver): clear one step partition from TQ (best-effort).
+
+    A missing partition or any TQ failure only logs a warning.
+    """
+    partition_id = step_partition_id(prefix, teacher_name, step)
+    try:
+        init_full_vocab_tq()
+
+        import transfer_queue as tq
+
+        # kv_clear requires explicit keys. List all keys in the partition first.
+        keys_info = tq.kv_list(partition_id=partition_id)
+        if partition_id in keys_info:
+            all_keys = list(keys_info[partition_id].keys())
+            if all_keys:
+                tq.kv_clear(keys=all_keys, partition_id=partition_id)
+                logger.info("[FVKL-TQ] clear_step: cleared %d keys from %s", len(all_keys), partition_id)
+            else:
+                logger.info("[FVKL-TQ] clear_step: no keys to clear in %s", partition_id)
+        else:
+            logger.info("[FVKL-TQ] clear_step: partition %s not found", partition_id)
+    except Exception as exc:
