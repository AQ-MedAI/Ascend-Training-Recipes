+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""CPU numerical tests for the full-vocabulary forward-KL distillation kernel.
+
+Target: ``_VocabParallelFullVocabKL`` in
+``verl/trainer/distillation/megatron/full_vocab_kl.py`` (implemented in
+parallel; expected contract)::
+
+    class _VocabParallelFullVocabKL(torch.autograd.Function):
+        # forward(ctx, student_logits_shard (b, s, V/tp),
+        #         teacher_hidden (b, s, H) bf16,
+        #         teacher_lm_head_shard (V/tp, H) bf16,
+        #         chunk_tokens: int) -> kl (b, s) fp32
+
+The student rebuilds full-vocab teacher logits on the fly as
+``teacher_hidden @ teacher_lm_head.T`` and computes the per-token forward KL
+``KL(teacher || student) = sum_v q_v * (log q_v - log p_v)``.
+
+NOTE: the tests are guarded by ``pytest.importorskip`` so environments without
+torch/megatron-core skip cleanly. If the final signature of
+``_VocabParallelFullVocabKL`` ever diverges from the contract above, adjust the
+``_apply_full_vocab_kl`` helper below — the reference math stays valid.
+
+Like ``_VocabParallelKLDivergence`` (verl/trainer/distillation/megatron/losses.py),
+the kernel uses megatron TP collectives (all_reduce over
+``get_tensor_model_parallel_group()``), so the tests initialize a single-process
+gloo group plus ``megatron.core.parallel_state`` with TP=1 instead of mocking —
+the numerical contract *is* the thing under test. At TP=1 the "shard" inputs are
+simply the full vocab / full lm_head.
+"""
+
+import os
+
+os.environ.setdefault("KMP_DUPLICATE_LIB_OK", "TRUE")
+
+import socket
+
+import pytest
+import torch
+
+full_vocab_kl = pytest.importorskip(
+    "verl.trainer.distillation.megatron.full_vocab_kl",
+    reason="full_vocab_kl.py is implemented in parallel; enable once it lands.",
+)
+
+_VocabParallelFullVocabKL = full_vocab_kl._VocabParallelFullVocabKL
+
+_B, _S, _V, _H = 2, 8, 32, 16
+
+
+@pytest.fixture(scope="module", autouse=True)
+def tp1_parallel_state():
+    """Single-process gloo group + megatron parallel_state with TP=1.
+
+    The kernel's TP all-reduce/all-gather collectives are identity ops at
+    world size 1, so this exercises the real distributed code paths on CPU.
+    """
+    try:
+        import torch.distributed as dist
+
+        if not dist.is_initialized():
+            os.environ.setdefault("MASTER_ADDR", "127.0.0.1")
+            if "MASTER_PORT" not in os.environ:
+                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+                    sock.bind(("127.0.0.1", 0))
+                    os.environ["MASTER_PORT"] = str(sock.getsockname()[1])
+            dist.init_process_group(backend="gloo", rank=0, world_size=1)
+
+        from megatron.core import parallel_state as mpu
+
+        if not mpu.model_parallel_is_initialized():
+            mpu.initialize_model_parallel(tensor_model_parallel_size=1)
+    except Exception as exc:  # megatron-core or gloo unavailable in this env
+        pytest.skip(f"cannot initialize single-process TP=1 parallel state: {exc}")
+    yield
+
+
+def _apply_full_vocab_kl(student_logits, teacher_hidden, teacher_lm_head, chunk_tokens):
+    """Single entry point wrapping the colleague's autograd Function (TP=1: shards are full)."""
+    return _VocabParallelFullVocabKL.apply(student_logits, teacher_hidden, teacher_lm_head, chunk_tokens)
+
+
+def _make_inputs(seed=42):
+    """Random inputs at the contract dtypes: student fp32, teacher hidden/lm_head bf16."""
+    g = torch.Generator().manual_seed(seed)
+    student_logits = torch.randn(_B, _S, _V, generator=g, dtype=torch.float32)
+    teacher_hidden = torch.randn(_B, _S, _H, generator=g, dtype=torch.float32).to(torch.bfloat16)
+    teacher_lm_head = torch.randn(_V, _H, generator=g, dtype=torch.float32).to(torch.bfloat16)
+    return student_logits, teacher_hidden, teacher_lm_head
+
+
+def _reference_kl(student_logits, teacher_hidden, teacher_lm_head):
+    """fp64 naive reference: KL(q || p) with p=student, q=teacher full-vocab distributions."""
+    teacher_logits = teacher_hidden.double() @ teacher_lm_head.double().T  # (b, s, V)
+    log_p = torch.log_softmax(student_logits.double(), dim=-1)
+    log_q = torch.log_softmax(teacher_logits, dim=-1)
+    q = log_q.exp()
+    return (q * (log_q - log_p)).sum(dim=-1)  # (b, s)
+
+
+def test_forward_matches_naive_reference(tp1_parallel_state):
+    student_logits, teacher_hidden, teacher_lm_head = _make_inputs()
+
+    kl = _apply_full_vocab_kl(student_logits, teacher_hidden, teacher_lm_head, chunk_tokens=4096)
+
+    assert kl.shape == (_B, _S), f"expected kl shape ({_B}, {_S}), got {tuple(kl.shape)}"
+    assert kl.dtype == torch.float32, f"expected fp32 kl output, got {kl.dtype}"
+    ref = _reference_kl(student_logits, teacher_hidden, teacher_lm_head)
+    torch.testing.assert_close(kl.double(), ref, rtol=0, atol=1e-4)
+
+
+def test_backward_matches_p_minus_q(tp1_parallel_state):
+    """d KL(q||p) / d student_logits = p - q (softmax grads through -sum q log p)."""
+    student_logits, teacher_hidden, teacher_lm_head = _make_inputs(seed=123)
+    student_logits.requires_grad_(True)
+
+    kl = _apply_full_vocab_kl(student_logits, teacher_hidden, teacher_lm_head, chunk_tokens=4096)
+    kl.sum().backward()
+
+    teacher_logits = teacher_hidden.float() @ teacher_lm_head.float().T
+    p = torch.softmax(student_logits.detach().float(), dim=-1)
+    q = torch.softmax(teacher_logits, dim=-1)
+    grad_ref = p - q
+    # bf16 teacher inputs + fp32 kernel accumulation: loosen to 1e-3.
+    torch.testing.assert_close(student_logits.grad, grad_ref, rtol=0, atol=1e-3)
+
+
+def test_chunk_tokens_boundary_invariance(tp1_parallel_state):
+    """chunk_tokens=3 does not divide b*s=16; result must match the unchunked run."""
+    student_logits, teacher_hidden, teacher_lm_head = _make_inputs(seed=7)
+
+    kl_chunked = _apply_full_vocab_kl(student_logits, teacher_hidden, teacher_lm_head, chunk_tokens=3)
+    kl_single = _apply_full_vocab_kl(student_logits, teacher_hidden, teacher_lm_head, chunk_tokens=10**9)
+
+    # Chunking is a memory/perf knob only; per-token bf16 GEMM tile sizes may
+    # change fp32 accumulation order, so allow a tight (not bitwise) tolerance.
+    torch.testing.assert_close(kl_chunked, kl_single, rtol=1e-5, atol=1e-5)
+
+
+def test_zero_teacher_hidden_rows_no_nan(tp1_parallel_state):
+    """Padding rows carry all-zero teacher hidden states -> uniform teacher logits.
+
+    The KL for those rows is log(V) - H(p) (finite); nothing may turn NaN/Inf.
+    """
+    student_logits, teacher_hidden, teacher_lm_head = _make_inputs(seed=99)
+    teacher_hidden = teacher_hidden.clone()
+    teacher_hidden[0, -3:] = 0  # padding rows at the tail of sample 0
+    teacher_hidden[1, -1:] = 0
+
+    kl = _apply_full_vocab_kl(student_logits, teacher_hidden, teacher_lm_head, chunk_tokens=4096)
+
+    assert torch.isfinite(kl).all(), f"non-finite KL for zero teacher-hidden rows: {kl}"
+    ref = _reference_kl(student_logits, teacher_hidden, teacher_lm_head)
+    torch.testing.assert_close(kl.double(), ref, rtol=0, atol=1e-4)
