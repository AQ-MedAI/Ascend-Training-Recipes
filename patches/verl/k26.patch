+"""Full-vocabulary forward-KL distillation loss for the Megatron student.
+
+The teacher exports its pre-lm_head hidden states ``[seq_len - 1, H]`` (bf16) to
+TransferQueue; the student reads them back per sample (see
+``verl.trainer.distillation.full_vocab_tq``), rebuilds full-vocab teacher logits
+on the fly with the frozen teacher lm_head shard (this TP rank's ``[V/tp, H]``
+slice read lazily from the teacher checkpoint), and computes the exact
+full-vocabulary forward KL per token::
+
+    KL(q || p) = sum_v q_v * (log q_v - log p_v),   d KL / d z_v = p_v - q_v
+
+where ``p`` is the student softmax and ``q`` the teacher softmax, both normalized
+across the full (tensor-parallel-sharded) vocabulary with the same
+all-reduce max / all-reduce sum-exp primitives as
+``verl.trainer.distillation.megatron.losses.vocab_parallel_log_softmax``.
+
+Row alignment
+-------------
+Student logits arrive as ``(b, seqlen/cp, vocab/tp)`` in the packed (``thd``) or
+padded (``bshd``) layout produced by ``preprocess_thd_engine`` /
+``preprocess_bshd_engine`` on the nested ``input_ids``. Teacher hidden state row
+``t`` of sample ``i`` is the pre-lm_head activation at sequence position ``t``
+(predicting token ``t + 1``), so it aligns 1:1 with student logits row ``t`` for
+``t in [0, S_i - 1)``; the student's last row of each sample has no teacher
+target and is filled with zeros (its loss is dropped by the downstream response
+mask, exactly like the top-k path). The hidden rows are re-packed with the same
+preprocess functions used for the model inputs, so CP zigzag/contiguous
+splitting and alignment padding are inherited identically.
+
+Memory discipline: teacher/student logits are rebuilt chunk by chunk along the
+flattened token dimension (``full_vocab_chunk_tokens`` rows at a time), so at
+most one ``[chunk_tokens, V/tp]`` fp32 block is materialized per side. The
+backward pass recomputes the same chunks instead of saving them.
+"""
+
+import glob
+import json
+import logging
+import os
+
+import torch
+from tensordict import TensorDict
+
+from verl.models.mcore.util import preprocess_bshd_engine, preprocess_thd_engine
+from verl.trainer.distillation.megatron.losses import vocab_parallel_log_softmax
+from verl.utils import tensordict_utils as tu
+from verl.workers.config import DistillationConfig, DistillationLossConfig
+
+logger = logging.getLogger(__name__)
+
+TEACHER_HIDDEN_ARTIFACT_FIELD = "teacher_full_vocab_artifact"
+
+# Candidate weight names for the teacher's output projection, in resolution order.
+# Tied-embedding checkpoints only store the embedding weight.
+_LM_HEAD_LAYER = "lm_head.weight"
+_EMBED_TOKENS_LAYER = "model.embed_tokens.weight"
+
+# Process-level cache: (checkpoint_path, resolved_layer, tp_rank, tp_size) -> [V/tp, H] bf16.
+_TEACHER_LM_HEAD_SHARD_CACHE: dict[tuple[str, str, int, int], torch.Tensor] = {}
+
+
+def _resolve_weight_key(candidates: list[str], key2file: dict[str, str]) -> str | None:
+    """Resolve a candidate weight name against checkpoint keys.
+
+    Exact match first; otherwise accept keys that carry a module prefix and end
+    with ``.{candidate}`` — e.g. multimodal checkpoints such as Kimi-K2.5/K2.6
+    nest language-model weights under ``language_model.``. An ambiguous suffix
+    match is an error (the user can then pin ``full_vocab_lm_head_layer``).
+    """
+    for name in candidates:
+        if name in key2file:
+            return name
+    for name in candidates:
+        matches = [key for key in key2file if key.endswith(f".{name}")]
+        if len(matches) == 1:
+            return matches[0]
+        if len(matches) > 1:
+            raise ValueError(
+                f"Ambiguous teacher lm_head weight: candidate {name!r} matches multiple "
+                f"checkpoint keys {matches}. Set "
+                "distillation.distillation_loss.full_vocab_lm_head_layer to the exact key."
+            )
+    return None
+
+
+def _list_checkpoint_weight_files(checkpoint_path: str) -> dict[str, str]:
+    """Map weight name -> safetensors filename for a Hugging Face checkpoint dir."""
+    from safetensors import safe_open
+
+    index_file = os.path.join(checkpoint_path, "model.safetensors.index.json")
+    if os.path.exists(index_file):
+        with open(index_file, "rb") as f:
+            index = json.load(f)
+        return dict(index["weight_map"])
+    key2file = {}
+    for path in sorted(glob.glob(os.path.join(checkpoint_path, "*.safetensors"))):
+        with safe_open(path, framework="pt") as f:
+            for key in f.keys():
+                key2file[key] = os.path.basename(path)
+    return key2file
+
+
+def load_teacher_lm_head_shard(
+    *,
+    checkpoint_path: str,
+    layer: str,
+    vocab_size: int,
+    tp_rank: int,
+    tp_size: int,
+    device,
+) -> torch.Tensor:
+    """Lazily read this TP rank's ``[V/tp, H]`` shard of the teacher lm_head.
+
+    Args:
+        checkpoint_path: HF checkpoint directory (safetensors, optionally sharded
+            with a ``model.safetensors.index.json``).
+        layer: lm_head weight name, or ``"auto"`` to pick ``lm_head.weight`` /
+            ``model.embed_tokens.weight`` based on ``tie_word_embeddings`` in
+            ``config.json`` (falling back to whichever key actually exists).
+        vocab_size: teacher (global) vocabulary size from its HF config.
+        tp_rank / tp_size: this student's tensor-parallel coordinates; the shard
+            range follows ``VocabUtility.vocab_range_from_per_partition_vocab_size``.
+        device: target device for the returned shard.
+
+    Returns:
+        bf16 contiguous ``[V/tp, H]`` tensor on ``device``, cached per process.
+    """
+    from megatron.core.tensor_parallel.utils import VocabUtility
+    from safetensors import safe_open
+
+    if vocab_size % tp_size != 0:
+        raise ValueError(
+            f"Teacher vocab_size ({vocab_size}) must be divisible by the student TP size ({tp_size}) "
+            "for full-vocab distillation; the vocab-parallel shard ranges would otherwise differ."
+        )
+
+    if layer == "auto":
+        tie_word_embeddings = False
+        config_path = os.path.join(checkpoint_path, "config.json")
+        if os.path.exists(config_path):
+            with open(config_path, "rb") as f:
+                tie_word_embeddings = bool(json.load(f).get("tie_word_embeddings", False))
+        preferred = _EMBED_TOKENS_LAYER if tie_word_embeddings else _LM_HEAD_LAYER
+        fallback = _LM_HEAD_LAYER if tie_word_embeddings else _EMBED_TOKENS_LAYER
+        candidates = [preferred, fallback]
+    else:
+        candidates = [layer]
+
+    key2file = _list_checkpoint_weight_files(checkpoint_path)
+    resolved_layer = _resolve_weight_key(candidates, key2file)
+    if resolved_layer is None:
+        raise ValueError(
+            f"Could not find the teacher lm_head weight {candidates} in checkpoint {checkpoint_path} "
+            "(exact or module-prefixed match). Available weight keys (first 20): "
+            f"{sorted(key2file)[:20]}"
+        )
+    if resolved_layer not in candidates:
+        logger.info("[FVKL] resolved teacher lm_head weight key with module prefix: %s", resolved_layer)
+
+    cache_key = (os.path.abspath(checkpoint_path), resolved_layer, tp_rank, tp_size)
+    if cache_key in _TEACHER_LM_HEAD_SHARD_CACHE:
+        return _TEACHER_LM_HEAD_SHARD_CACHE[cache_key]
+
+    per_partition_vocab_size = vocab_size // tp_size
+    vocab_start, vocab_end = VocabUtility.vocab_range_from_per_partition_vocab_size(
+        per_partition_vocab_size, tp_rank, tp_size
+    )
+    weight_file = os.path.join(checkpoint_path, key2file[resolved_layer])
+    with safe_open(weight_file, framework="pt") as f:
+        shard = f.get_slice(resolved_layer)[vocab_start:vocab_end, :]
+    shard = shard.to(device=device, dtype=torch.bfloat16).contiguous()
+
+    _TEACHER_LM_HEAD_SHARD_CACHE[cache_key] = shard
+    logger.info(
+        "[FVKL] loaded teacher lm_head shard: layer=%s file=%s rows=[%d, %d) shape=%s device=%s",
+        resolved_layer,
+        key2file[resolved_layer],
+        vocab_start,
+        vocab_end,
+        tuple(shard.shape),
+        device,
+    )
+    return shard
+
+
+class _VocabParallelFullVocabKL(torch.autograd.Function):
+    """Exact full-vocabulary forward or reverse KL between student and teacher.
+
+    Inputs are this TP rank's shards; softmax normalizers are formed with TP
+    all-reduce (max / sum-exp) inside ``vocab_parallel_log_softmax``, and the
+    per-token KL is TP all-reduced (SUM). Teacher logits are rebuilt chunk by
+    chunk from the exported hidden states and the frozen teacher lm_head shard;
+    nothing chunk-sized is kept between forward and backward (backward recomputes).
+
+    ``reverse=False`` computes the forward KL ``KL(q || p) = sum q (log q - log p)``
+    with gradient ``p_j - q_j``. ``reverse=True`` computes the reverse KL
+    ``KL(p~ || q) = sum p~ (log p~ - log q)`` with gradient
+    ``p~_j * (log p~_j - log q_j - KL)`` (the ``sum_i p_i (d_ij - p_j)`` terms cancel).
+
+    If the teacher lm_head shard has fewer rows than the student vocab shard
+    (megatron pads its vocab), the extra student columns hold zero-probability
+    teacher entries. For the forward KL they contribute nothing to the sum and get
+    gradient ``p_j``. For the reverse KL ``q_j = 0`` with ``p_j > 0`` would make the
+    KL infinite, so the student distribution is conditioned on the teacher's vocab
+    range instead: ``p~ = p / mass`` restricted to those columns (``Z_full`` cancels,
+    so ``p~`` is exactly the softmax over the restricted columns and the padded
+    columns get exactly zero gradient).
+    """
+
+    @staticmethod
+    def forward(
+        ctx,
+        student_logits_shard: torch.Tensor,  # (b, s, V/tp), already CP-split, temperature-scaled
+        teacher_hidden: torch.Tensor,  # (b, s, H) bf16, row-aligned with student_logits_shard
+        teacher_lm_head_shard: torch.Tensor,  # (V_t/tp, H) bf16, constant
+        chunk_tokens: int,
+        reverse: bool,  # False: KL(q||p) forward; True: KL(p~||q) reverse
+    ):
+        from megatron.core.parallel_state import get_tensor_model_parallel_group
+
+        tp_group = get_tensor_model_parallel_group()
+        batch_size, seqlen, vocab_shard = student_logits_shard.shape
+        teacher_vocab_shard = teacher_lm_head_shard.size(0)
+        assert teacher_vocab_shard <= vocab_shard, (
+            f"Teacher lm_head shard rows ({teacher_vocab_shard}) exceed the student vocab shard "
+            f"({vocab_shard}); check the teacher checkpoint and TP mapping."
+        )
+
+        student_flat = student_logits_shard.reshape(-1, vocab_shard)
+        hidden_flat = teacher_hidden.reshape(-1, teacher_hidden.size(-1))
+        num_tokens = student_flat.size(0)
+
+        kl = torch.zeros(num_tokens, dtype=torch.float32, device=student_logits_shard.device)
+        for start in range(0, num_tokens, chunk_tokens):
+            end = min(start + chunk_tokens, num_tokens)
+            # bf16 matmul (fp32 accumulate on tensor cores), then fp32 log-softmax.
+            teacher_logits = torch.matmul(hidden_flat[start:end], teacher_lm_head_shard.t())
+            log_q = vocab_parallel_log_softmax(teacher_logits)  # (c, V_t/tp) fp32
+            log_p_full = vocab_parallel_log_softmax(student_flat[start:end])  # (c, V/tp) fp32
+            if reverse:
+                log_p_t = _condition_on_teacher_vocab(
+                    log_p_full, teacher_vocab_shard, tp_group
+                )  # (c, V_t/tp) log p~
+                p_t = log_p_t.exp()
+                kl_chunk = torch.sum(p_t * (log_p_t - log_q), dim=-1)  # (c,)
+            else:
+                q = log_q.exp()
+                log_p = log_p_full[:, :teacher_vocab_shard]
+                kl_chunk = torch.sum(q * (log_q - log_p), dim=-1)  # (c,)
+            torch.distributed.all_reduce(kl_chunk, op=torch.distributed.ReduceOp.SUM, group=tp_group)
+            kl[start:end] = kl_chunk
+
+        # The caller's tensor is later mutated in place by other consumers of the
+        # same logits buffer (megatron's vocab_parallel_cross_entropy inside
+        # vocab_parallel_log_probs_from_logits does sub_/exp_/div_ on it), which
+        # would invalidate a saved alias ("expected version N" error) and corrupt
+        # the values by the time backward runs. Save a private copy instead.
+        ctx.save_for_backward(student_logits_shard.clone(), teacher_hidden, teacher_lm_head_shard)
+        ctx.chunk_tokens = chunk_tokens
+        ctx.reverse = reverse
+        return kl.view(batch_size, seqlen)
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor):
+        student_logits_shard, teacher_hidden, teacher_lm_head_shard = ctx.saved_tensors
+        chunk_tokens = ctx.chunk_tokens
+        batch_size, seqlen, vocab_shard = student_logits_shard.shape
+        teacher_vocab_shard = teacher_lm_head_shard.size(0)
+
+        from megatron.core.parallel_state import get_tensor_model_parallel_group
+
+        tp_group = get_tensor_model_parallel_group()
+
+        student_flat = student_logits_shard.reshape(-1, vocab_shard)
+        hidden_flat = teacher_hidden.reshape(-1, teacher_hidden.size(-1))
+        grad_flat = grad_output.reshape(-1, 1).to(torch.float32)
+        num_tokens = student_flat.size(0)
+
+        dlogits = torch.empty_like(student_flat)
+        for start in range(0, num_tokens, chunk_tokens):
+            end = min(start + chunk_tokens, num_tokens)
+            teacher_logits = torch.matmul(hidden_flat[start:end], teacher_lm_head_shard.t())
+            log_q = vocab_parallel_log_softmax(teacher_logits)  # (c, V_t/tp) fp32
+            log_p_full = vocab_parallel_log_softmax(student_flat[start:end])  # (c, V/tp) fp32
+            if ctx.reverse:
+                log_p_t = _condition_on_teacher_vocab(log_p_full, teacher_vocab_shard, tp_group)
+                p_t = log_p_t.exp()
+                diff = log_p_t - log_q  # (c, V_t/tp)
+                kl_chunk = torch.sum(p_t * diff, dim=-1)  # (c,)
+                torch.distributed.all_reduce(kl_chunk, op=torch.distributed.ReduceOp.SUM, group=tp_group)
+                # d KL(p~||q) / d z_j = p~_j (log p~_j - log q_j - KL); exactly zero
+                # for columns beyond the teacher vocab (p~ does not depend on them).
+                grad_chunk = torch.zeros(
+                    end - start, vocab_shard, dtype=torch.float32, device=student_flat.device
+                )
+                grad_chunk[:, :teacher_vocab_shard] = p_t * (diff - kl_chunk.unsqueeze(-1))
+            else:
+                grad_chunk = log_p_full.exp_()  # p
+                grad_chunk[:, :teacher_vocab_shard] -= log_q.exp()  # p - q
+            grad_chunk *= grad_flat[start:end]
+            dlogits[start:end] = grad_chunk.to(student_logits_shard.dtype)
+
+        return dlogits.view(batch_size, seqlen, vocab_shard), None, None, None, None
+
+
+def _condition_on_teacher_vocab(
+    log_p_full: torch.Tensor, teacher_vocab_shard: int, tp_group
+) -> torch.Tensor:
+    """Log of the student distribution conditioned on the teacher's vocab range.
+
+    ``log_p_full`` is the TP-sharded full-vocab log-softmax (c, V/tp). When the
+    student vocab shard is wider than the teacher's (megatron vocab padding), the
+    restricted distribution is renormalized: ``log p~_j = log p_j - log(mass)``
+    with ``mass = sum_{j < V_t} p_j`` (TP all-reduced). ``Z_full`` cancels in the
+    ratio, so the result is exactly the log-softmax over the restricted columns.
+    Returns the (c, V_t/tp) slice; a no-op slice when the shards have equal width.
+    """
+    log_p_t = log_p_full[:, :teacher_vocab_shard]
+    if teacher_vocab_shard < log_p_full.size(-1):
+        mass = log_p_t.exp().sum(dim=-1)
+        torch.distributed.all_reduce(mass, op=torch.distributed.ReduceOp.SUM, group=tp_group)
+        log_p_t = log_p_t - mass.log().unsqueeze(-1)
+    return log_p_t
+
+
+def _per_sample_temperature(data: TensorDict, batch_size: int, device) -> torch.Tensor:
+    """Per-sample temperature as a fp32 (batch_size,) tensor, clamped positive.
+
+    The caller (``_lm_head_logits_processor``) divides student logits by this
+    temperature before the loss; scaling teacher hidden rows by ``1 / T`` is
+    equivalent to applying the same temperature to the teacher logits (linear
+    matmul), keeping both distributions at the same temperature as the top-k path
+    (whose teacher logprobs come from vLLM at the sampling temperature).
+    """
+    temperature = data.get("temperature", None)
+    if temperature is None:
+        return torch.ones(batch_size, dtype=torch.float32, device=device)
+    # Scalar metadata injected via extra_info/meta_info arrives wrapped in
+    # NonTensorData; unwrap before the float/tensor handling below.
+    temperature = tu.unwrap_non_tensor_data(temperature)
+    if not isinstance(temperature, torch.Tensor):
+        return torch.full((batch_size,), float(temperature), dtype=torch.float32, device=device)
+    if temperature.is_nested:
+        # (b, j) per-token temperature expanded from a per-sample value.
+        temperature = temperature.to_padded_tensor(1.0)[:, 0]
+    if temperature.dim() == 0:
+        temperature = temperature.expand(batch_size)
+    return temperature.detach().to(device=device, dtype=torch.float32).clamp_min(1e-8)
+
+
+def compute_forward_kl_full_vocab(
+    *,
+    student_logits: torch.Tensor,
+    data: TensorDict,
+    config: DistillationConfig,
+    data_format: str,
+    teacher_lm_head_shards: dict[str, torch.Tensor],
+) -> dict[str, torch.Tensor]:
+    """Exact full-vocabulary forward KL ``KL(q || p)``; see :func:`compute_full_vocab_kl`."""
+    return compute_full_vocab_kl(
+        reverse=False,
+        student_logits=student_logits,
+        data=data,
+        config=config,
+        data_format=data_format,
+        teacher_lm_head_shards=teacher_lm_head_shards,
+    )
+
+
+def compute_reverse_kl_full_vocab(
+    *,
+    student_logits: torch.Tensor,
+    data: TensorDict,
+    config: DistillationConfig,
+    data_format: str,
+    teacher_lm_head_shards: dict[str, torch.Tensor],
+) -> dict[str, torch.Tensor]:
+    """Exact full-vocabulary reverse KL ``KL(p~ || q)``; see :func:`compute_full_vocab_kl`."""
+    return compute_full_vocab_kl(
+        reverse=True,
+        student_logits=student_logits,
+        data=data,
+        config=config,
+        data_format=data_format,
+        teacher_lm_head_shards=teacher_lm_head_shards,
+    )
+
+
+def compute_full_vocab_kl(
+    *,
+    reverse: bool,
+    student_logits: torch.Tensor,
+    data: TensorDict,
+    config: DistillationConfig,
+    data_format: str,
+    teacher_lm_head_shards: dict[str, torch.Tensor],
+) -> dict[str, torch.Tensor]:
+    """Compute the exact full-vocabulary KL loss in the logits processor.
+
+    When a micro batch mixes multiple teachers, each teacher scores only its
+    own samples' rows: the rows are gathered out of the aligned layout, the KL
+    runs on the compacted rows, and the per-row KL is scattered back (row sets
+    are disjoint across teachers). This keeps the saved student-logits clone /
+    teacher hidden and the teacher-logits matmul proportional to the group
+    size instead of the full micro batch per teacher.
+
+    Args:
+        reverse: False for the forward KL ``KL(q || p) = sum q (log q - log p)``,
+            True for the reverse KL ``KL(p~ || q) = sum p~ (log p~ - log q)`` where
+            ``p~`` is the student distribution conditioned on the teacher's vocab
+            range (see ``_VocabParallelFullVocabKL``).
+        student_logits: (bsz, seqlen/cp_size, vocab_size/tp_size), temperature-scaled.
+        data: micro batch TensorDict; carries the per-sample artifact dicts in the
+            NonTensorStack field ``teacher_full_vocab_artifact``.
+        config: DistillationConfig (uses ``distillation_loss.full_vocab_chunk_tokens``).
+        data_format: "thd" or "bshd".
+        teacher_lm_head_shards: teacher_key -> this TP rank's [V/tp, H] teacher lm_head shard.
+
+    Returns:
+        - distillation_losses: (bsz, seqlen/cp_size) fp32, per-token KL.
+        - teacher_hidden_norm: (bsz, seqlen/cp_size) fp32 diagnostic (0 on rows
+          without teacher hidden states).
+    """
+    from verl.trainer.distillation.full_vocab_tq import init_full_vocab_tq, multi_get_hidden
+
+    init_full_vocab_tq()
+
+    loss_config: DistillationLossConfig = config.distillation_loss
+    chunk_tokens = loss_config.full_vocab_chunk_tokens
+
+    input_ids = data["input_ids"]
+    if not input_ids.is_nested:
+        raise ValueError(
+            "Full-vocab distillation expects nested (no-padding) input_ids in the micro batch, "
+            f"but got a dense tensor with shape {tuple(input_ids.shape)}."
+        )
+    seqlens = input_ids.offsets().diff().tolist()
+    batch_size = len(seqlens)
+
+    artifacts = tu.get(data, TEACHER_HIDDEN_ARTIFACT_FIELD, None)
+    if artifacts is None:
+        raise ValueError(
+            f"Micro batch is missing the NonTensorStack field {TEACHER_HIDDEN_ARTIFACT_FIELD!r} "
+            "with per-sample teacher hidden-state artifact metadata."
+        )
+    artifacts = [tu.unwrap_non_tensor_data(a) for a in artifacts]
+    if len(artifacts) != batch_size:
+        raise ValueError(
+            f"Expected {batch_size} teacher hidden-state artifacts (one per sample), "
+            f"but got {len(artifacts)}."
+        )
+
+    device = student_logits.device
+    hiddens = multi_get_hidden(artifacts=artifacts, device=device)
+    for i, (hidden, seqlen) in enumerate(zip(hiddens, seqlens, strict=True)):
+        expected_rows = seqlen - 1
+        if hidden.dim() != 2 or hidden.size(0) != expected_rows:
+            raise ValueError(
+                f"Teacher hidden states for sample {i} (uid={artifacts[i].get('uid')!r}, "
+                f"teacher={artifacts[i].get('teacher')!r}) have shape {tuple(hidden.shape)}, "
+                f"expected ({expected_rows}, H) = (seqlen - 1, H) with seqlen={seqlen}. "
+                "Refusing to truncate/pad: the teacher export must cover the full sample. "
+                "Most common cause: the teacher prefill was chunked because "
+                "inference.max_num_batched_tokens < sample length — set it >= max_model_len."
+            )
+
+    temperatures = _per_sample_temperature(data, batch_size, device)  # (b,) fp32, > 0
+
+    # Group sample indices by teacher so each group's rows are scored with its
+    # own lm_head shard. Single-teacher runs take the fast path without masks.
+    groups: dict[str, list[int]] = {}
+    for i, artifact in enumerate(artifacts):
+        teacher_key = artifact["teacher"]
+        if teacher_key not in teacher_lm_head_shards:
+            raise ValueError(
+                f"Artifact for sample {i} references teacher {teacher_key!r}, but "
+                f"teacher_lm_head_shards only has keys {sorted(teacher_lm_head_shards)}."
+            )
+        groups.setdefault(teacher_key, []).append(i)
+    single_teacher = len(groups) == 1
+
+    local_cp_size = tu.get_non_tensor_data(data=data, key="local_cp_size", default=None)
+
+    def scatter_rows(nested: torch.Tensor) -> torch.Tensor:
+        """Re-pack per-sample rows into the student's packed/padded layout (with CP split)."""
+        if data_format == "thd":
+            return preprocess_thd_engine(nested, pre_process=True, local_cp_size=local_cp_size)[0]
+        # NOTE(v0.8.0): preprocess_bshd_engine on release/v0.8.0 has no forced_max_seqlen
+        # parameter; call it the same way compute_forward_kl_topk does.
+        return preprocess_bshd_engine(nested, pre_process=True)[0]
+
+    # Per-token teacher hidden norm diagnostic over the raw (unscaled) hidden rows;
+    # the last row of each sample (no teacher target) stays zero.
+    norm_rows = []
+    for hidden, seqlen in zip(hiddens, seqlens, strict=True):
+        norm = hidden.to(torch.float32).norm(dim=-1)
+        norm_rows.append(torch.cat([norm, norm.new_zeros(1)], dim=0))
+    hidden_norm = scatter_rows(torch.nested.as_nested_tensor(norm_rows, layout=torch.jagged))
+    if hidden_norm.shape != student_logits.shape[:2]:
+        raise ValueError(
+            f"Aligned teacher hidden norm shape {tuple(hidden_norm.shape)} does not match student "
+            f"logits shape {tuple(student_logits.shape[:2])}; the teacher data does not follow the "
+            f"same {data_format!r} packing as the model inputs."
+        )
+
+    # Sample-index map over the aligned layout, used to select each teacher's
+    # rows when a micro batch mixes multiple teachers.
+    sample_index = None
+    if not single_teacher:
+        index_rows = [torch.full((seqlen,), i, dtype=torch.int64, device=device) for i, seqlen in enumerate(seqlens)]
+        sample_index = scatter_rows(torch.nested.as_nested_tensor(index_rows, layout=torch.jagged)).reshape(-1)
+
+    kl_total = None
+    student_flat = None
+    for teacher_key, sample_indices in groups.items():
+        lm_head_shard = teacher_lm_head_shards[teacher_key]
+        hidden_size = lm_head_shard.size(1)
+        index_set = set(sample_indices)
+        rows = []
+        for i, seqlen in enumerate(seqlens):
+            if i in index_set:
+                hidden = hiddens[i]
+                if hidden.size(1) != hidden_size:
+                    raise ValueError(
+                        f"Teacher hidden size ({hidden.size(1)}) != lm_head hidden size ({hidden_size}) "
+                        f"for sample {i} (teacher={teacher_key!r})."
+                    )
+                # Last row has no teacher target; fill zero (masked downstream).
+                row = torch.cat([hidden, hidden.new_zeros(1, hidden_size)], dim=0)
+                # Apply the per-sample temperature to the teacher logits by scaling
+                # hidden rows (matmul is linear); zero rows stay zero.
+                row = row / temperatures[i]
+            else:
+                row = torch.zeros(seqlen, hidden_size, dtype=lm_head_shard.dtype, device=device)
+            rows.append(row)
+        teacher_hidden = scatter_rows(torch.nested.as_nested_tensor(rows, layout=torch.jagged))
+        if teacher_hidden.shape[:2] != student_logits.shape[:2]:
+            raise ValueError(
+                f"Aligned teacher hidden shape {tuple(teacher_hidden.shape[:2])} does not match "
+                f"student logits shape {tuple(student_logits.shape[:2])} for teacher {teacher_key!r}."
+            )
+        if single_teacher:
+            kl_total = _VocabParallelFullVocabKL.apply(student_logits, teacher_hidden, lm_head_shard, chunk_tokens, reverse)
+        else:
+            # Score only this teacher's rows: gather them out of the aligned
+            # layout, run the KL on the compacted rows, then scatter the per-row
+            # KL back. Row sets are disjoint across teachers, so the scattered
+            # sum routes each row's gradient to its own teacher only — same
+            # result as running the full tensor per teacher with a mask, but
+            # the saved student-logits clone/hidden and the teacher-logits
+            # matmul shrink to this group's rows only.
+            row_idx = torch.isin(
+                sample_index, torch.tensor(sample_indices, dtype=torch.int64, device=device)
+            ).nonzero(as_tuple=True)[0]
+            if student_flat is None:
+                student_flat = student_logits.reshape(-1, student_logits.size(-1))
+            group_logits = student_flat[row_idx].unsqueeze(0)
+            group_hidden = teacher_hidden.reshape(-1, hidden_size)[row_idx].unsqueeze(0)
+            kl_group = _VocabParallelFullVocabKL.apply(
+                group_logits, group_hidden, lm_head_shard, chunk_tokens, reverse
+            )
+            if kl_total is None:
+                kl_total = student_logits.new_zeros(student_logits.shape[:2], dtype=torch.float32).reshape(-1)
+            kl_total = kl_total.index_copy(0, row_idx, kl_group.reshape(-1))
+    if kl_total is not None and kl_total.dim() == 1:
+        kl_total = kl_total.view(student_logits.shape[:2])
+
+    return {
+        "distillation_losses": kl_total,
+        "teacher_hidden_norm": hidden_norm,
+    }
+
+
+__all__ = [
+    "TEACHER_HIDDEN_ARTIFACT_FIELD",
+    "compute_forward_kl_full_vocab",
+    "compute_full_vocab_kl",
+    "compute_reverse_kl_full_vocab",
+    "load_teacher_lm_head_shard",
+]
