index 0000000000000000000000000000000000000000..64eb6b545f8c5e8d6f592539945ab3adbadf8fab
--- /dev/null
+++ b/tests/experimental/teacher_loop/test_teacher_sleep_on_cpu.py
@@ -0,0 +1,194 @@
+# Copyright 2025 Bytedance Ltd. and/or its affiliates
+#
