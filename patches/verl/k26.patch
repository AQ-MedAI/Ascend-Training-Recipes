index 0000000000000000000000000000000000000000..3e7976a9dfbf0644a41d3286fc667ee8016532ee
--- /dev/null
+++ b/verl/single_controller/ray/rack_aware.py
@@ -0,0 +1,93 @@
+"""Rack-aware node assignment for verl (PG-pinned, superpod id via npu-smi).
+
+用 get_superpod_id() (每节点跑 `npu-smi info -t spod-info` 解析 Super Pod ID) 作为 rack 标识,
+代替 Ray 节点 label (sigma 不一定打 rack 标签, 这里直接问 npu-smi). driver 通过 Ray task (NodeAffinity)
+在每个节点本地调 get_superpod_id(), 收集 {node_id: superpod_id}, 按 (superpod_id, ip) 排序:
+  - student 取前 student_count (第一个 superpod)
+  - teacher 取后 teacher_count (最后一个 superpod)
+verl 的 get_placement_groups 再用 node:<ip> resource 把每个 PG 钉到这些节点,
+既保证 student/teacher 各自单 superpod, 又走原生 PG 设备管理.
+
+开关: VERL_TEACHER_DEDICATED_RACK=1 才生效.
+"""
+import logging
+from collections import OrderedDict
+
+import ray
+from ray.util.scheduling_strategies import NodeAffinitySchedulingStrategy
+
+logger = logging.getLogger(__name__)
+
+
+@ray.remote(num_cpus=0)
+def _spod_id_remote():
+    """在每个节点本地跑 get_superpod_id(). 由 driver 经 NodeAffinity 调度到各节点 (num_cpus=0 不占资源)."""
+    try:
+        from verl.utils.device import get_superpod_id
+
+        return get_superpod_id()
+    except Exception as e:  # noqa: BLE001
+        logging.getLogger(__name__).warning("[RACK-AWARE] get_superpod_id failed on node %s: %s"
+                                            % (ray.get_runtime_context().get_node_id(), e))
+        return None
+
+
+def _node_superpod_map(nodes):
+    """返回 {node_id: superpod_id}, 对每个 alive 节点跑一个 Ray task 本地取 superpod id."""
+    node_ids = [n["NodeID"] for n in nodes]
+    refs = [
+        _spod_id_remote.options(scheduling_strategy=NodeAffinitySchedulingStrategy(node_id=nid, soft=False)).remote()
+        for nid in node_ids
+    ]
+    spods = ray.get(refs)
+    return {nid: sp for nid, sp in zip(node_ids, spods)}
+
+
+def _sorted_alive_nodes():
+    """返回 (排序后的 nodes, {node_id: superpod_id}). 排序键: (superpod is None, superpod, ip)."""
+    nodes = [n for n in ray.nodes() if n.get("Alive", False)]
+    spod_map = _node_superpod_map(nodes)
+    for n in nodes:
+        n["_spod"] = spod_map.get(n["NodeID"])
+
+    def _key(n):
+        s = n["_spod"]
+        return (s is None, s if s is not None else 0, n.get("NodeManagerAddress", ""))
+
+    return sorted(nodes, key=_key), spod_map
+
+
+def _log_summary(nodes, spod_map, tag=""):
+    groups = OrderedDict()
+    for n in nodes:
+        groups.setdefault(spod_map.get(n["NodeID"]), []).append(n.get("NodeManagerAddress", ""))
+    logger.warning("[RACK-AWARE]%s alive nodes=%d, superpod_groups(node count)=%s"
+                   % (tag, len(nodes), {k: len(v) for k, v in groups.items()}))
+    for sid, ips in groups.items():
+        logger.warning("[RACK-AWARE]%s superpod=%s sample_ips=%s" % (tag, sid, ips[:3]))
+
+
+def assign_rack_aware_nodes(n_gpus_per_node: int, count: int, take: str = "first"):
+    """返回 count 个 node_id (per-node 列表, 长度 = count = 节点数, 不是 per-rank 展开).
+
+    take='first': superpod 排序后前 count 个 (student -> 第一个 superpod)
+    take='last':  最后 count 个 (teacher -> 最后一个 superpod)
+    student=first + teacher=last, count 之和 = 总节点数时互斥且各占一个 superpod.
+    """
+    nodes, spod_map = _sorted_alive_nodes()
+    _log_summary(nodes, spod_map, tag="[before-assign take=%s count=%d]" % (take, count))
+    ordered_nids = [n["NodeID"] for n in nodes]
+
+    if take == "first":
+        picked = ordered_nids[:count]
+    elif take == "last":
+        picked = ordered_nids[-count:]
+    else:
+        raise ValueError("take must be 'first' or 'last', got %r" % take)
+
+    picked_set = set(picked)
+    picked_spods = sorted({spod_map.get(nid) for nid in picked})
+    picked_ips = [n.get("NodeManagerAddress") for n in nodes if n["NodeID"] in picked_set][:3]
+    logger.warning("[RACK-AWARE] take=%s -> %d nodes on superpods=%s sample_ips=%s"
+                   % (take, len(picked), picked_spods, picked_ips))
+    return picked
