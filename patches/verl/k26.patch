+
+"""Full-vocab teacher hidden-state transport via TransferQueue (KV API).
+
+For full-vocabulary KL distillation (``loss_mode='forward_kl_full_vocab'``), the
+teacher exports pre-lm_head hidden states ``[seq_len, H]`` (bf16) and the student
+rebuilds full-vocab teacher logits on the fly with the frozen teacher lm_head.
+Only the hidden states go through TransferQueue (pip package ``transfer_queue``,
+import name ``transfer_queue``, a.k.a. tq); the batch itself only carries the
+artifact metadata dicts produced by :func:`put_hidden`.
+
+Key / partition layout
+----------------------
+::
+
+    partition "full_vocab_hidden_{prefix}_{teacher}_step_{N}"
+        key="{teacher}/step={N}/sample={uid}"  ->  hidden [seq_len, H] (bf16)
+
+``prefix`` distinguishes this run's partitions from other runs sharing the same
+TQ cluster; see :func:`resolve_partition_prefix`.
+
+Roles
+-----
+- **Producer**: the teacher vLLM server process writes one KV entry per sample
+  with :func:`put_hidden` and attaches the returned artifact metadata dict to
+  the batch (as a non-tensor field).
+- **Consumer**: the student Megatron engine worker reads the hidden states back
+  with :func:`get_hidden` / :func:`multi_get_hidden` using the artifact metadata.
+- **Cleaner**: the driver clears each step partition with :func:`clear_step`
+  after the student has finished reading (best-effort).
+
+Per-sample keys are unique, so there is no write collision across teacher DP
+engines. Samples have variable seq_len, so reads are done per key
+(:func:`multi_get_hidden` simply loops over :func:`get_hidden`).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from typing import Optional
+
+import torch
+from tensordict import TensorDict
+
+logger = logging.getLogger(__name__)
+
+FULL_VOCAB_HIDDEN_FIELD = "hidden"
+ARTIFACT_DTYPE = "bfloat16"
+
+_ENV_EXPERIMENT_NAME = "VERL_FULL_VOCAB_EXPERIMENT_NAME"
+
+# ---------------------------------------------------------------------------
+# Import TransferQueue lazily — only when this transport is first used.
+# ---------------------------------------------------------------------------
+_TQ_IMPORTED = False
+
+
+def _ensure_tq_imported() -> None:
+    global _TQ_IMPORTED
+    if _TQ_IMPORTED:
+        return
+    try:
+        import transfer_queue as _tq
+
+        _tq  # silence unused-import warning
+        _TQ_IMPORTED = True
+    except ImportError as exc:
+        raise ImportError(
+            "full_vocab_tq transport requires the 'transfer_queue' package. "
+            "Install it with: pip install transfer_queue"
+        ) from exc
+
+
+def init_full_vocab_tq() -> None:
+    """Initialize the TQ client for full-vocab transport (idempotent).
+
+    Called with no arguments: attaches to the already-running Controller (the
+    driver starts it first). Safe to call multiple times — TQ's ``init()``
+    skips if a Controller is already attached in this process.
+    """
+    _ensure_tq_imported()
+
+    import transfer_queue as tq
+
+    tq.init()
+
+
+def resolve_partition_prefix(full_vocab_experiment_name: Optional[str]) -> str:
+    """Resolve the TQ partition prefix for this run.
+
+    Resolution order: explicit argument -> ``VERL_FULL_VOCAB_EXPERIMENT_NAME``
+    environment variable -> ``"default_exp"``.
+    """
+    if full_vocab_experiment_name:
+        return str(full_vocab_experiment_name)
+    return os.getenv(_ENV_EXPERIMENT_NAME) or "default_exp"
+
+
+def make_hidden_key(teacher_name: str, step: int, uid: str) -> str:
+    """Compose the TQ key for one teacher sample's hidden states."""
+    return f"{teacher_name}/step={step}/sample={uid}"
+
+
+def step_partition_id(prefix: str, teacher_name: str, step: int) -> str:
+    """Compose the TQ partition id holding one step's hidden states."""
+    return f"full_vocab_hidden_{prefix}_{teacher_name}_step_{step}"
+
+
+def put_hidden(*, prefix: str, teacher_name: str, step: int, uid: str, tensor: torch.Tensor) -> dict:
+    """Producer: write one sample's hidden states ``[seq_len, H]`` to TQ.
+
+    Returns the artifact metadata dict to attach to the batch:
+    ``{"key", "partition_id", "shape", "dtype", "teacher", "step", "uid", "prefix"}``.
+    """
+    init_full_vocab_tq()
+
+    import transfer_queue as tq
+
+    key = make_hidden_key(teacher_name, step, uid)
+    partition_id = step_partition_id(prefix, teacher_name, step)
+    fields = TensorDict(
+        {FULL_VOCAB_HIDDEN_FIELD: tensor.unsqueeze(0).contiguous().to(torch.bfloat16).cpu()},
+        batch_size=[1],
+    )
+    tq.kv_put(key=key, partition_id=partition_id, fields=fields)
+    logger.info(
+        "[FVKL-TQ] put_hidden: key=%s partition=%s tensor_shape=%s",
+        key,
+        partition_id,
+        tuple(tensor.shape),
+    )
+    return {
+        "key": key,
+        "partition_id": partition_id,
+        "shape": list(tensor.shape),
+        "dtype": ARTIFACT_DTYPE,
+        "teacher": teacher_name,
+        "step": step,
+        "uid": uid,
+        "prefix": prefix,
+    }
+
+
+def get_hidden(*, artifact: dict, device: torch.device | str) -> torch.Tensor:
+    """Consumer: read one sample's hidden states back from TQ onto ``device``.
+
+    Returns a ``torch.bfloat16`` tensor reshaped to ``artifact["shape"]``.
+    """
+    init_full_vocab_tq()
+
+    import transfer_queue as tq
+
+    data = tq.kv_batch_get(
+        keys=[artifact["key"]],
+        partition_id=artifact["partition_id"],
+        select_fields=[FULL_VOCAB_HIDDEN_FIELD],
+    )
+    t_tq = data[FULL_VOCAB_HIDDEN_FIELD][0]
+    shape = tuple(int(d) for d in artifact["shape"])
+    return t_tq.reshape(shape).to(device, non_blocking=True)
+
+
+def multi_get_hidden(*, artifacts: list[dict], device: torch.device | str) -> list[torch.Tensor]:
+    """Consumer: read hidden states for a list of artifacts.
+
+    Samples have variable seq_len, so entries cannot be batched into a single
+    TQ read; each artifact is read individually (same trade-off as the
+    reference implementation). Returns a list of the same length as ``artifacts``.
+    """
+    return [get_hidden(artifact=artifact, device=device) for artifact in artifacts]
