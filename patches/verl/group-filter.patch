+# Copyright 2026 Individual contributors
+# SPDX-License-Identifier: Apache-2.0
+"""DAPO group filtering, shared by ordinary PPO/GRPO training.
+
+Semantics follow verl v0.6.1 recipe/dapo/dapo_ray_trainer.py:
+keep nonconstant groups and singleton groups; replenish to a full prompt batch.
+"""
+from collections import defaultdict
+
+import numpy as np
+
+
+class GroupFilter:
+    """Accumulate whole prompt groups without updating the rollout policy."""
+
+    def __init__(self, config, target_groups, samples_per_prompt):
+        self.metric = config.get("metric")
+        if not self.metric:
+            raise ValueError("algorithm.filter_groups.metric must be set when filtering is enabled")
+        self.target = int(target_groups)
+        self.samples = int(samples_per_prompt)
+        if self.target < 1 or self.samples < 1:
+            raise ValueError("Group filtering requires positive batch size and rollout.n")
+        self.limit = int(config.get("max_num_gen_batches", 0))
+        self.reset()
+
+    def reset(self):
+        self.parts = []
+        self.groups = 0
+        self.generated = 0
+        self.dropped = 0
+        self.attempts = 0
+        self.timing = {}
+
+    def add(self, batch):
+        # Import lazily so grouping validation can be tested without Ray/NPU.
+        from verl import DataProto
+
+        if self.metric == "seq_reward":
+            values = batch.batch["token_level_scores"].sum(dim=-1).detach().float().cpu().numpy()
+        elif self.metric == "seq_final_reward":
+            values = batch.batch["token_level_rewards"].sum(dim=-1).detach().float().cpu().numpy()
+        else:
+            if self.metric not in batch.non_tensor_batch:
+                raise ValueError(f"Group filter metric {self.metric!r} is absent from reward extra info")
+            values = np.asarray(batch.non_tensor_batch[self.metric], dtype=np.float64)
+        uids = batch.non_tensor_batch["uid"]
+        if values.shape != (len(uids),) or not np.isfinite(values).all():
+            raise ValueError(f"Group filter metric {self.metric!r} must contain one finite scalar per response")
+        by_uid = defaultdict(list)
+        for index, uid in enumerate(uids):
+            by_uid[uid].append(index)
+        if any(len(indices) != self.samples for indices in by_uid.values()):
+            raise ValueError("Group filter received incomplete prompt groups; check rollout.n and uid")
+        kept = [indices for indices in by_uid.values()
+                if len(indices) == 1 or np.std(values[indices]) > 0]
+        self.attempts += 1
+        self.generated += len(by_uid)
+        self.dropped += len(by_uid) - len(kept)
+        # Regroup before truncation: token balancing may have interleaved groups.
+        kept = kept[:max(0, self.target - self.groups)]
+        if kept:
+            selected = batch[[i for indices in kept for i in indices]]
+            selected.meta_info = {}  # Per-generation metadata cannot be concatenated.
+            self.parts.append(selected)
+            self.groups += len(kept)
+        if self.groups < self.target:
+            if self.limit > 0 and self.attempts >= self.limit:
+                raise ValueError(
+                    f"Group filter collected {self.groups}/{self.target} prompt groups after "
+                    f"{self.attempts} generation batches (max_num_gen_batches={self.limit}); "
+                    "check reward diversity or increase the limit"
+                )
+            return None
+        result = self.parts[0] if len(self.parts) == 1 else DataProto.concat(self.parts)
+        return result
+
+    def metrics(self):
+        return {
+            "filter_groups/num_gen_batches": self.attempts,
+            "filter_groups/generated_groups": self.generated,
+            "filter_groups/dropped_groups": self.dropped,
+            "filter_groups/kept_groups": self.groups,
+            "filter_groups/keep_ratio": (self.generated - self.dropped) / max(1, self.generated),
+        }
