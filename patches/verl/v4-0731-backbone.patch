+# Copyright 2026 Individual contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Backbone-only compatibility for official DeepSeek V4 Flash 0731 / DSpark."""
+from collections.abc import Mapping
+
+
+def _get(config, name, default=None):
+    return config.get(name, default) if isinstance(config, Mapping) else getattr(config, name, default)
+
+
+def _set(config, name, value):
+    if isinstance(config, dict):
+        config[name] = value
+    else:
+        setattr(config, name, value)
+
+
+def normalize_v4_dspark_config(hf_config, mtp_config):
+    """Select the 0731/DSpark backbone, never reinterpret DSpark as legacy MTP.
+
+    This changes only the in-memory/export config, not the source checkpoint.
+    Legacy V4 MTP and non-V4 models retain their existing behavior.
+    """
+    if _get(hf_config, "model_type") != "deepseek_v4":
+        return False
+    fields = dict(hf_config) if isinstance(hf_config, Mapping) else vars(hf_config)
+    dspark = fields.get("_verl_prediction_head_type") == "dspark" or any(
+        name.startswith("dspark_") for name in fields
+    )
+    if not dspark:
+        return False
+    if any(_get(mtp_config, key, False) for key in ("enable", "enable_train", "enable_rollout")):
+        raise ValueError(
+            "DeepSeek V4 0731 uses DSpark prediction heads, not legacy V4 MTP. "
+            "Only backbone RL/MOPD is supported: set actor_rollout_ref.model.mtp."
+            "{enable,enable_train,enable_rollout}=False. DSpark tensors must not be "
+            "renamed to legacy e_proj/h_proj/enorm/hnorm weights."
+        )
+    layers = _get(hf_config, "num_hidden_layers")
+    ratios = _get(hf_config, "compress_ratios")
+    if ratios is not None:
+        if not isinstance(layers, int) or layers <= 0 or len(ratios) < layers:
+            raise ValueError("V4 DSpark compress_ratios must cover every backbone layer")
+        _set(hf_config, "compress_ratios", list(ratios[:layers]))
+    _set(hf_config, "num_nextn_predict_layers", 0)
+    _set(hf_config, "mtp_num_layers", 0)
+    _set(hf_config, "_verl_prediction_head_type", "dspark")
+    # A backbone-only HF export must not advertise missing DSpark weights.
+    for name in list(fields):
+        if name.startswith("dspark_"):
+            if isinstance(hf_config, dict):
+                hf_config.pop(name, None)
+            else:
+                delattr(hf_config, name)
+    return True
+
+
+def v4_backbone_rollout_overrides(hf_config):
+    """vLLM reloads config.json from disk; pass the normalized head settings too."""
+    if _get(hf_config, "_verl_prediction_head_type") != "dspark":
+        return {}
+    overrides = {"num_nextn_predict_layers": 0, "mtp_num_layers": 0}
+    ratios = _get(hf_config, "compress_ratios")
+    if ratios is not None:
+        overrides["compress_ratios"] = list(ratios)
+    return overrides
