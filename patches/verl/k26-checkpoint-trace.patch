+"""Opt-in checkpoint serialization diagnostics; never change the saved payload."""
+
+from collections.abc import Mapping
+from functools import wraps
+import os
+import sys
+import traceback
+
+import torch
+
+
+def _tensor_summary(value, depth=0, seen=None):
+    if seen is None:
+        seen = set()
+    if id(value) in seen or depth > 4:
+        return []
+    seen.add(id(value))
+    if isinstance(value, torch.Tensor):
+        return [f"shape={tuple(value.shape)} dtype={value.dtype} device={value.device}"]
+    children = value.values() if isinstance(value, Mapping) else value if isinstance(value, (list, tuple)) else ()
+    result = []
+    for child in children:
+        result.extend(_tensor_summary(child, depth + 1, seen))
+        if len(result) >= 8:
+            break
+    return result[:8]
+
+
+def trace_checkpoint_save(function):
+    @wraps(function)
+    def wrapped(self, *args, **kwargs):
+        if os.getenv("K26_CHECKPOINT_TRACE", "0") != "1":
+            return function(self, *args, **kwargs)
+        if self.checkpoint_config.async_save:
+            raise ValueError("K26_CHECKPOINT_TRACE requires checkpoint.async_save=False")
+        original_save = torch.save
+        sequence = 0
+        rank = getattr(self, "rank", "?")
+        print(
+            f"[checkpoint-trace] pid={os.getpid()} rank={rank} begin "
+            f'dist={getattr(self, "use_dist_checkpointing", "?")}',
+            file=sys.stderr,
+            flush=True,
+        )
+
+        def traced_save(obj, target, *save_args, **save_kwargs):
+            nonlocal sequence
+            sequence += 1
+            call = sequence
+            print(
+                f"[checkpoint-trace] pid={os.getpid()} rank={rank} call={call} "
+                f"target_type={type(target).__name__} object_type={type(obj).__name__} "
+                f"tensors={_tensor_summary(obj)}",
+                file=sys.stderr,
+                flush=True,
+            )
+            traceback.print_stack(limit=24, file=sys.stderr)
+            sys.stderr.flush()
+            result = original_save(obj, target, *save_args, **save_kwargs)
+            print(f"[checkpoint-trace] rank={rank} call={call} torch.save completed", file=sys.stderr, flush=True)
+            return result
+
+        torch.save = traced_save
+        try:
+            return function(self, *args, **kwargs)
+        finally:
+            torch.save = original_save
+            print(f"[checkpoint-trace] rank={rank} leaving save_checkpoint", file=sys.stderr, flush=True)
+
+    return wrapped
