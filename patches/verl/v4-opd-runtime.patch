+def _student_artifact_row_range(artifact: dict, seqlen: int, sample_index: int) -> tuple[int, int]:
+    """Validate teacher source rows and return their explicit student destination.
+
+    Legacy artifacts use identical teacher/student coordinates. Privileged
+    prompts carry a separate student mapping; both ranges must cover the same
+    number of prediction rows, ending immediately before each final token.
+    """
+    teacher_len = int(artifact.get("sequence_length", seqlen))
+    source_start = int(artifact.get("row_start", 0))
+    source_end = int(artifact.get("row_end", teacher_len - 1))
+    if not 0 <= source_start < source_end <= teacher_len - 1:
+        raise ValueError(f"Invalid teacher source row range for sample {sample_index}: {artifact}")
+    mapping_keys = ("student_sequence_length", "student_row_start", "student_row_end")
+    if any(key in artifact for key in mapping_keys):
+        if not all(key in artifact for key in mapping_keys):
+            raise ValueError(f"Incomplete student row mapping for sample {sample_index}")
+        student_len, start, end = (int(artifact[key]) for key in mapping_keys)
+        if (
+            student_len != seqlen
+            or not 0 <= start < end == seqlen - 1
+            or source_end != teacher_len - 1
+            or end - start != source_end - source_start
+        ):
+            raise ValueError(f"Invalid teacher/student response row mapping for sample {sample_index}: {artifact}; "
+                             f"student sequence length is {seqlen}")
+        return start, end
+    if teacher_len != seqlen:
+        raise ValueError(f"Teacher hidden artifact for sample {sample_index} has sequence_length={teacher_len}, "
+                         f"but student sequence length is {seqlen}; an explicit student row mapping is required")
+    return source_start, source_end
+
