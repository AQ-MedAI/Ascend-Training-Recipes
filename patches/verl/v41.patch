index 0000000000000000000000000000000000000000..098eabc5a312f36ad7093219288fa99f72b6ccca
--- /dev/null
+++ b/verl/utils/rollout_lifecycle.py
@@ -0,0 +1,19 @@
+"""Shared colocated rollout operations for synchronous and asynchronous engines.
+
+Return the engine result unchanged: AsyncLLM callers await it, LLM callers do not.
+Worker sleep deliberately leaves the EngineCore scheduler running, as in V4.
+"""
+
+
+def sleep_workers(engine, level):
+    if level not in (1, 2):
+        raise ValueError('Unsupported colocated sleep level')
+    return engine.collective_rpc('sleep', kwargs={'level': level})
+
+
+def wake_weights(engine):
+    return engine.wake_up(tags=['weights'])
+
+
+def wake_kv_cache(engine):
+    return engine.wake_up(tags=['kv_cache'])
