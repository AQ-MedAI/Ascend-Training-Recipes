index 0000000000000000000000000000000000000000..85b72d0f4289e472f1a334bbfa69e659f2169cd5
--- /dev/null
+++ b/verl/utils/deepseek_v41_config.py
@@ -0,0 +1,30 @@
+"""Register the existing pinned rollout config through HFModelConfig.external_lib.
+
+Load only its standalone config module, without importing vLLM/Ascend plugins.
+The config equations/aliases remain owned by the pinned rollout source.
+"""
+import hashlib
+import importlib.util
+import os
+from pathlib import Path
+
+from transformers import AutoConfig
+from transformers.models.auto.configuration_auto import CONFIG_MAPPING
+
+DEPENDENCY_ROOT = Path(os.environ.get('DEPENDENCY_ROOT', Path(__file__).resolve().parents[3]))
+SOURCE = Path(os.environ.get('V41_CONFIG_SOURCE', str(DEPENDENCY_ROOT /
+          'workspace/rollout/dsv41/vllm-ascend/vllm_ascend/deepseek_v41_config.py')))
+if not SOURCE.is_file():
+    raise FileNotFoundError(f'Pinned V4.1 configuration source is missing: {SOURCE}')
+SOURCE_SHA256 = hashlib.sha256(SOURCE.read_bytes()).hexdigest()
+_spec = importlib.util.spec_from_file_location('_v41_config_source', SOURCE)
+_source = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_source)
+
+# Stable importable class names also allow configs to be pickled by Ray.
+for _name in ('DeepseekV41Config', 'DeepseekV41TextConfig', 'DeepseekV41VisionConfig'):
+    _cls = getattr(_source, _name)
+    _cls.__module__ = __name__
+    globals()[_name] = _cls
+    if _cls.model_type not in CONFIG_MAPPING:
+        AutoConfig.register(_cls.model_type, _cls)
