+def _encode_hidden_payload(hidden: torch.Tensor) -> dict[str, Any]:
+    """Use native MessagePack values; untyped vLLM utility RPC loses Tensor types."""
+    if hidden.dim() != 2 or hidden.dtype not in (torch.bfloat16, torch.float16, torch.float32):
+        raise ValueError(f"Unsupported full-vocab hidden tensor: shape={tuple(hidden.shape)}, dtype={hidden.dtype}")
+    if any(size < 1 for size in hidden.shape):
+        raise ValueError(f"Empty full-vocab hidden tensor: {tuple(hidden.shape)}")
+    hidden = hidden.detach().to("cpu").contiguous()
+    return {
+        "format": "verl.full_vocab_hidden.v1",
+        "dtype": str(hidden.dtype).removeprefix("torch."),
+        "shape": list(hidden.shape),
+        "data": hidden.view(torch.uint8).numpy().tobytes(),
+    }
+
+
+def _decode_hidden_payload(payload: dict[str, Any]) -> torch.Tensor:
+    """Validate an explicit wire format without pickle or raw tensor descriptors."""
+    dtypes = {"bfloat16": torch.bfloat16, "float16": torch.float16, "float32": torch.float32}
+    dtype_name, shape, data = payload.get("dtype"), payload.get("shape"), payload.get("data")
+    if not isinstance(dtype_name, str) or dtype_name not in dtypes:
+        raise ValueError(f"Unsupported full-vocab hidden dtype: {dtype_name!r}")
+    if (
+        not isinstance(shape, (list, tuple))
+        or len(shape) != 2
+        or any(type(size) is not int or size < 1 for size in shape)
+    ):
+        raise ValueError(f"Invalid full-vocab hidden shape: {shape!r}")
+    dtype = dtypes[dtype_name]
+    expected = shape[0] * shape[1] * torch.empty((), dtype=dtype).element_size()
+    if not isinstance(data, bytes) or len(data) != expected:
+        raise ValueError(f"Invalid full-vocab hidden data: expected {expected} bytes")
+    # Own a writable buffer so the result survives RPC-buffer reuse and supports
+    # downstream operations without exposing immutable MessagePack memory.
+    return torch.frombuffer(bytearray(data), dtype=dtype).reshape(shape)
+
