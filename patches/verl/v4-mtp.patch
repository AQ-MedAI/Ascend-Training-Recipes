@@ -1544,6 +1544,14 @@ def patch_engine_mtp(module, model_config):
 
     modules = module if isinstance(module, list) else [module]
     for m in modules:
+        # MindSpeed V4 computes MTP loss in forward and must return PPO logits.
+        actual = unwrap_model(m)
+        if actual.__class__.__name__ == "DeepSeek4Model":
+            actual.verl_return_logits = True
+            if hasattr(actual, "mtp"):
+                actual.mtp.verl_mtp = True
+                actual.mtp.detach_encoder = model_config.mtp.detach_encoder
+            continue
         patch_postprocess(m)
         if model_config.mtp.detach_encoder:
             patch_mtp_layer_get_embeddings(m)
