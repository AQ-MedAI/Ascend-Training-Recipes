+# limitations under the License.
+
+"""Teacher pre-lm_head hidden-state capture and TransferQueue export.
+
+For full-vocabulary KL distillation (``loss_mode='forward_kl_full_vocab'``), the
+teacher vLLM server performs a prefill-only forward per sample
+(``max_tokens=1``, ``prompt_logprobs=0``) and exports the pre-lm_head hidden
+states instead of top-k logprobs. The student rebuilds the full-vocab teacher
+logits on the fly with the frozen teacher lm_head.
+
+Flow per request (all driven by ``vLLMHttpServer.generate``):
+
+1. ``collective_rpc("start_hidden_capture")`` wraps the model runner's
+   ``_get_prompt_logprobs_dict`` (:func:`install_hidden_capture`). That method
+   is invoked exactly once per engine step and only when prompt logprobs were
+   requested; its first argument is the step's full prefill hidden states
+   ``[num_tokens, H]`` (already sliced to the scheduled tokens), which the
+   wrapper copies to CPU as a side effect. The wrapper deliberately does NOT
+   delegate to the original method: the original would materialize the
+   full-vocab logits of every prompt position (``[seq_len, V]``) to compute
+   prompt logprobs that full-vocab distillation never consumes, at a memory/
+   latency cost that kills long-prompt teacher prefills. This hook point
+   deliberately avoids ``model.compute_logits``: vLLM
+   v1 calls it twice per step (once with the per-request sampling rows, once
+   with the prompt-logprobs rows) with an indistinguishable signature.
+2. The normal prefill-only ``engine.generate`` runs. Teacher inference is
+   configured with ``max_num_seqs=1`` and ``enable_chunked_prefill=False`` plus
+   ``max_num_batched_tokens >= max_model_len`` (enforced by the config layer),
+   so one forward contains exactly one complete request and the captured
+   ``[seq_len, H]`` tensor belongs to that request — no per-request splitting
+   is needed.
+3. Only TP rank 0 copies the replicated hidden states to CPU.  For online
+   distillation it copies just the rows predicting response tokens; prompt rows
+   are still computed for causal attention but are not transferred.
+4. ``collective_rpc("fetch_captured_hidden")`` retrieves that single CPU tensor,
+   and :func:`export_hidden_to_tq` records its source row range before writing it
+   via ``verl.trainer.distillation.full_vocab_tq.put_hidden``.  Legacy callers
+   without a row range still export all ``seq_len - 1`` prediction rows.
+"""
+
+from __future__ import annotations
+
+import logging
+from types import MethodType
+from typing import Any, Optional
+
+import torch
+
+from verl.workers.rollout.vllm_rollout.utils import vLLMColocateWorkerExtension
+
+logger = logging.getLogger(__name__)
+
+_CAPTURED_HIDDEN_ATTR = "_full_vocab_captured_hidden"
+_CAPTURE_HIDDEN_ENABLED_ATTR = "_full_vocab_capture_hidden_enabled"
+_CAPTURE_ROW_START_ATTR = "_full_vocab_capture_row_start"
+_CAPTURE_ROW_END_ATTR = "_full_vocab_capture_row_end"
+_ORIGINAL_GET_PROMPT_LOGPROBS_ATTR = "_full_vocab_original_get_prompt_logprobs_dict"
+
+
+def install_hidden_capture(
+    model_runner,
+    *,
+    capture_hidden: bool = True,
+    row_start: Optional[int] = None,
+    row_end: Optional[int] = None,
+) -> None:
+    """Wrap ``model_runner._get_prompt_logprobs_dict`` to capture its hidden input.
+
+    When ``capture_hidden`` is true, the captured tensor is detached and copied
+    to CPU (synchronously) and stored on the runner under
+    ``_full_vocab_captured_hidden``; only the last step's capture is kept.  All
+    tensor-parallel ranks install the wrapper so none of them materialize prompt
+    logits, but only TP rank 0 enables the expensive hidden-state copy.
+    Idempotent: re-installing on an already-wrapped runner only clears the stale
+    buffer and updates whether this rank captures.  The original method is NOT
+    called; the wrapper returns an empty prompt-logprobs dict instead.
+
+    Raises:
+        RuntimeError: if the runner has no ``_get_prompt_logprobs_dict`` (the
+            capture relies on vLLM v1 prompt-logprobs plumbing), or if a second
+            capture arrives before the previous one was fetched.
+    """
+    setattr(model_runner, _CAPTURE_HIDDEN_ENABLED_ATTR, capture_hidden)
+    setattr(model_runner, _CAPTURE_ROW_START_ATTR, row_start)
+    setattr(model_runner, _CAPTURE_ROW_END_ATTR, row_end)
+    if getattr(model_runner, _ORIGINAL_GET_PROMPT_LOGPROBS_ATTR, None) is not None:
+        # Already installed (e.g. repeated start_hidden_capture calls); drop the
+        # stale capture from the previous request and keep the existing wrapper.
+        setattr(model_runner, _CAPTURED_HIDDEN_ATTR, None)
+        return
+
+    original = getattr(model_runner, "_get_prompt_logprobs_dict", None)
+    if original is None:
+        raise RuntimeError(
+            "full-vocab hidden capture requires vLLM v1 prompt-logprobs support, but "
+            f"{type(model_runner).__name__} has no _get_prompt_logprobs_dict method. "
+            "This vLLM version is not supported by the full-vocab hidden export."
+        )
+
+    def _get_prompt_logprobs_dict(self, hidden_states, *args, **kwargs):
+        # hidden_states: the step's full prefill hidden [num_tokens, H], already
+        # sliced to the scheduled tokens. With max_num_seqs=1 and a single-pass
+        # prefill this is exactly the [seq_len, H] of the one in-flight request.
+        # Hidden states are replicated across TP ranks.  Keep the wrapper active
+        # everywhere (to avoid prompt-logits materialization), but copy only the
+        # designated TP rank's tensor to CPU.
+        if not getattr(self, _CAPTURE_HIDDEN_ENABLED_ATTR, True):
+            return {}
+
+        capture_start = getattr(self, _CAPTURE_ROW_START_ATTR, None)
+        capture_end = getattr(self, _CAPTURE_ROW_END_ATTR, None)
+        if capture_start is not None or capture_end is not None:
+            if capture_start is None or capture_end is None:
+                raise RuntimeError("full-vocab hidden capture requires both row_start and row_end")
+            if not 0 <= capture_start < capture_end <= hidden_states.shape[0]:
+                raise RuntimeError(
+                    f"full-vocab hidden capture range [{capture_start}, {capture_end}) is invalid "
+                    f"for hidden shape {tuple(hidden_states.shape)}"
+                )
+            hidden_states = hidden_states[capture_start:capture_end]
+
+        # Copy synchronously: the GPU buffer may be reused by subsequent steps.
+        if getattr(self, _CAPTURED_HIDDEN_ATTR, None) is not None:
+            raise RuntimeError(
+                "full-vocab hidden capture received a second prefill before the previous "
+                "capture was fetched. With max_num_seqs=1 this indicates the prefill was "
+                "chunked — set distillation.teacher_models.<name>.inference."
+                "max_num_batched_tokens >= max_model_len so each request is prefilled "
+                "in a single forward."
+            )
+        setattr(self, _CAPTURED_HIDDEN_ATTR, hidden_states.detach().to("cpu", non_blocking=False))
+        logger.info(
+            "[FVKL] captured hidden: shape=%s",
+            tuple(getattr(self, _CAPTURED_HIDDEN_ATTR).shape),
+        )
+        # Deliberately do NOT call the original method: it materializes the
+        # full-vocab logits for every prompt position ([seq_len, V] — ~14GB fp32
+        # for a 20k-token prompt with a 160k vocab) purely to compute prompt
+        # logprobs, which full-vocab distillation never consumes (the student
+        # rebuilds teacher logits from the exported hidden + frozen lm_head).
+        # That materialization is what made long-prompt teacher prefills exceed
+        # the executor RPC timeout / OOM the workers. Returning an empty dict is
+        # the same signal the runner produces on decode steps ("no prompt
+        # logprobs this step"); downstream the request's prompt_logprobs stays
+        # the [None] placeholder, which verl's extraction skips.
+        return {}
+
+    setattr(model_runner, _ORIGINAL_GET_PROMPT_LOGPROBS_ATTR, original)
+    setattr(model_runner, _CAPTURED_HIDDEN_ATTR, None)
+    model_runner._get_prompt_logprobs_dict = MethodType(_get_prompt_logprobs_dict, model_runner)
+
+
+def uninstall_hidden_capture(model_runner) -> None:
+    """Restore the original ``_get_prompt_logprobs_dict`` and drop capture state."""
+    original = getattr(model_runner, _ORIGINAL_GET_PROMPT_LOGPROBS_ATTR, None)
+    if original is None:
+        return
+    model_runner._get_prompt_logprobs_dict = original
+    delattr(model_runner, _ORIGINAL_GET_PROMPT_LOGPROBS_ATTR)
+    if hasattr(model_runner, _CAPTURED_HIDDEN_ATTR):
+        delattr(model_runner, _CAPTURED_HIDDEN_ATTR)
+    if hasattr(model_runner, _CAPTURE_HIDDEN_ENABLED_ATTR):
+        delattr(model_runner, _CAPTURE_HIDDEN_ENABLED_ATTR)
+    if hasattr(model_runner, _CAPTURE_ROW_START_ATTR):
+        delattr(model_runner, _CAPTURE_ROW_START_ATTR)
+    if hasattr(model_runner, _CAPTURE_ROW_END_ATTR):
+        delattr(model_runner, _CAPTURE_ROW_END_ATTR)
+
+
+def unwrap_captured_hidden(rpc_result: Any) -> Optional[torch.Tensor]:
+    """Pick the rank-0 capture out of a ``collective_rpc`` result.
+
+    ``AsyncLLM.collective_rpc`` aggregates per-worker results; depending on the
+    vLLM version and DP/TP layout the payload arrives as a (possibly nested)
+    list with one entry per worker. All TP ranks hold the same replicated
+    pre-lm_head hidden states, so the first non-None tensor (rank 0) is the one
+    to use. Returns None if no worker captured anything.
+    """
+    if isinstance(rpc_result, torch.Tensor):
+        return rpc_result
+    if isinstance(rpc_result, (list, tuple)):
+        for item in rpc_result:
+            hidden = unwrap_captured_hidden(item)
+            if hidden is not None:
+                return hidden
+    return None
+
+
+class FullVocabHiddenWorkerExtension(vLLMColocateWorkerExtension):
+    """Worker extension adding pre-lm_head hidden-state capture.
+
+    Used as ``worker_extension_cls`` (in place of
+    ``vLLMColocateWorkerExtension``) only on teacher servers with full-vocab
+    export enabled, so the methods below are reachable via
+    ``collective_rpc("start_hidden_capture" | "fetch_captured_hidden")``.
+    """
+
+    def start_hidden_capture(self, row_start: Optional[int] = None, row_end: Optional[int] = None) -> None:
+        """Install the capture wrapper on this worker's model runner.
+
+        Every TP rank skips prompt-logits materialization, while only TP rank 0
+        copies the replicated pre-lm-head hidden states to CPU.  The server
+        consumes that single buffer from the collective-RPC results.
+        """
+        from vllm.distributed import get_tensor_model_parallel_rank
+
+        tp_rank = get_tensor_model_parallel_rank()
+        install_hidden_capture(
+            self.model_runner,
+            capture_hidden=tp_rank == 0,
+            row_start=row_start,
+            row_end=row_end,
+        )
+
+    def fetch_captured_hidden(self) -> Optional[torch.Tensor]:
+        """Return this worker's captured CPU hidden states (or None).
+
+        Consume-once: the buffer is cleared so a stale capture can never leak
+        into the next request.
+        """
+        runner = self.model_runner
+        hidden = getattr(runner, _CAPTURED_HIDDEN_ATTR, None)
+        setattr(runner, _CAPTURED_HIDDEN_ATTR, None)
+        return hidden
+
+
+def export_hidden_to_tq(
+    *,
+    hidden: torch.Tensor,
+    seq_len: int,
+    teacher_name: str,
+    step: int,
+    uid: str,
+    prefix: str,
+    row_start: Optional[int] = None,
+    row_end: Optional[int] = None,
+) -> dict:
+    """Write one sample's hidden states to TransferQueue, return the artifact dict.
+
+    ``hidden`` is the captured CPU tensor for one request; ``seq_len`` is the
+    number of tokens the engine actually prefilled. Hidden row ``t`` predicts
+    token ``t + 1``. When ``row_start``/``row_end`` are supplied, only that
+    response-target range is exported. Legacy callers without a range export
+    all ``seq_len - 1`` prediction rows. ``put_hidden`` handles bf16 conversion
+    and the actual TQ write.
+    """
+    if hidden.dim() != 2:
+        raise ValueError(
+            f"full-vocab hidden export expects a 2D [seq_len, H] tensor, got shape {tuple(hidden.shape)} "
+            f"(teacher={teacher_name!r}, step={step}, uid={uid!r})"
+        )
+    if row_start is not None or row_end is not None:
+        if row_start is None or row_end is None or not 0 <= row_start < row_end <= seq_len - 1:
+            raise ValueError(
+                f"Invalid full-vocab target range [{row_start}, {row_end}) for sequence length {seq_len}"
+            )
+        if hidden.shape[0] != row_end - row_start:
+            raise ValueError(
+                f"full-vocab hidden export captured {hidden.shape[0]} rows for target range "
+                f"[{row_start}, {row_end}); expected {row_end - row_start}"
+            )
+    elif hidden.shape[0] == seq_len:
+        hidden = hidden[:-1]
+        row_start, row_end = 0, seq_len - 1
+    elif hidden.shape[0] == seq_len - 1:
+        row_start, row_end = 0, seq_len - 1
+    else:
+        raise ValueError(
+            f"full-vocab hidden export captured {hidden.shape[0]} hidden rows for a request of "
+            f"{seq_len} prompt tokens; expected {seq_len} (full prefill hidden, last row would be "
+            f"dropped) or {seq_len - 1} (prompt-logprobs positions). Refusing to guess an alignment "
+            f"(teacher={teacher_name!r}, step={step}, uid={uid!r})"
+        )
+    if hidden.shape[0] < 1:
+        raise ValueError(
+            f"full-vocab hidden export got a single-row hidden state (shape {tuple(hidden.shape)} after "
+            f"aligning to {seq_len} prompt tokens); nothing to export "
+            f"(teacher={teacher_name!r}, step={step}, uid={uid!r})"
+        )
+    # Imported lazily so this module stays importable without TransferQueue.
+    from verl.trainer.distillation.full_vocab_tq import init_full_vocab_tq, put_hidden
+
+    init_full_vocab_tq()
+    artifact = put_hidden(prefix=prefix, teacher_name=teacher_name, step=step, uid=uid, tensor=hidden)
+    artifact.update({"sequence_length": seq_len, "row_start": row_start, "row_end": row_end})
+    return artifact
+
+
