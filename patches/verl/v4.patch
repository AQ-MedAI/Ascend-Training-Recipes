+"""Full-vocabulary forward-KL distillation loss for the Megatron student.
+
+The teacher exports its pre-lm_head hidden states ``[seq_len - 1, H]`` (bf16) to
+TransferQueue; the student reads them back per sample (see
+``verl.trainer.distillation.full_vocab_tq``), rebuilds full-vocab teacher logits
+on the fly with the frozen teacher lm_head shard (this TP rank's ``[V/tp, H]``
+slice read lazily from the teacher checkpoint), and computes the exact
+full-vocabulary forward KL per token::
+
+    KL(q || p) = sum_v q_v * (log q_v - log p_v),   d KL / d z_v = p_v - q_v
+
+where ``p`` is the student softmax and ``q`` the teacher softmax, both normalized
+across the full (tensor-parallel-sharded) vocabulary with the same
+all-reduce max / all-reduce sum-exp primitives as
+``verl.trainer.distillation.megatron.losses.vocab_parallel_log_softmax``.
+
+Row alignment
+-------------
+Student logits arrive as ``(b, seqlen/cp, vocab/tp)`` in the packed (``thd``) or
+padded (``bshd``) layout produced by ``preprocess_thd_engine`` /
+``preprocess_bshd_engine`` on the nested ``input_ids``. Teacher hidden state row
+``t`` of sample ``i`` is the pre-lm_head activation at sequence position ``t``
+(predicting token ``t + 1``), so it aligns 1:1 with student logits row ``t`` for
+``t in [0, S_i - 1)``; the student's last row of each sample has no teacher
+target and is filled with zeros (its loss is dropped by the downstream response
+mask, exactly like the top-k path). The hidden rows are re-packed with the same
+preprocess functions used for the model inputs, so CP zigzag/contiguous
+splitting and alignment padding are inherited identically.
+
+Memory discipline: teacher/student logits are rebuilt chunk by chunk along the
+flattened token dimension (``full_vocab_chunk_tokens`` rows at a time), so at
+most one ``[chunk_tokens, V/tp]`` fp32 block is materialized per side. The
+backward pass recomputes the same chunks instead of saving them.
+"""
+
+import glob
+import json
+import logging
+import os
+
+import torch
+from tensordict import TensorDict
+
+from verl.models.mcore.util import preprocess_bshd_engine, preprocess_thd_engine
+from verl.trainer.distillation.megatron.losses import vocab_parallel_log_softmax
+from verl.utils import tensordict_utils as tu
+from verl.workers.config import DistillationConfig, DistillationLossConfig
+
+logger = logging.getLogger(__name__)
+
+TEACHER_HIDDEN_ARTIFACT_FIELD = "teacher_full_vocab_artifact"
+
+# Candidate weight names for the teacher's output projection, in resolution order.
+# Tied-embedding checkpoints only store the embedding weight.
+_LM_HEAD_LAYER = "lm_head.weight"
+_EMBED_TOKENS_LAYER = "model.embed_tokens.weight"
+
+# Process-level cache: (checkpoint_path, resolved_layer, tp_rank, tp_size) -> [V/tp, H] bf16.
+_TEACHER_LM_HEAD_SHARD_CACHE: dict[tuple[str, str, int, int], torch.Tensor] = {}
+
+
+def _resolve_weight_key(candidates: list[str], key2file: dict[str, str]) -> str | None:
+    """Resolve a candidate weight name against checkpoint keys.
+
+    Exact match first; otherwise accept keys that carry a module prefix and end
+    with ``.{candidate}`` — e.g. multimodal checkpoints such as Kimi-K2.5/K2.6
+    nest language-model weights under ``language_model.``. An ambiguous suffix
+    match is an error (the user can then pin ``full_vocab_lm_head_layer``).
+    """
+    for name in candidates:
+        if name in key2file:
+            return name
+    for name in candidates:
+        matches = [key for key in key2file if key.endswith(f".{name}")]
+        if len(matches) == 1:
+            return matches[0]
+        if len(matches) > 1:
+            raise ValueError(
+                f"Ambiguous teacher lm_head weight: candidate {name!r} matches multiple "
+                f"checkpoint keys {matches}. Set "
+                "distillation.distillation_loss.full_vocab_lm_head_layer to the exact key."
+            )
+    return None
+
+
+def _list_checkpoint_weight_files(checkpoint_path: str) -> dict[str, str]:
+    """Map weight name -> safetensors filename for a Hugging Face checkpoint dir."""
+    from safetensors import safe_open
+
+    index_file = os.path.join(checkpoint_path, "model.safetensors.index.json")
+    if os.path.exists(index_file):
+        with open(index_file, "rb") as f:
+            index = json.load(f)
+        return dict(index["weight_map"])
+    key2file = {}
+    for path in sorted(glob.glob(os.path.join(checkpoint_path, "*.safetensors"))):
+        with safe_open(path, framework="pt") as f:
+            for key in f.keys():
+                key2file[key] = os.path.basename(path)
+    return key2file
+
+
