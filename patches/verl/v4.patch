+"""Unit tests for verl/trainer/distillation/full_vocab_tq.py.
+
+Covered without a TransferQueue cluster (pure functions):
+  - make_hidden_key / step_partition_id string composition
+  - resolve_partition_prefix priority:
+    explicit argument > VERL_FULL_VOCAB_EXPERIMENT_NAME env var > "default_exp"
+
+The put/get/clear round-trip requires the ``transfer_queue`` pip package *and* a
+running TQ Controller (normally started by the driver before training), so it
+cannot run as a plain unit test; it is skipped unless a controller is reachable.
+"""
+
+import os
+
+os.environ.setdefault("KMP_DUPLICATE_LIB_OK", "TRUE")
+
+import pytest
+
+from verl.trainer.distillation import full_vocab_tq
+
+_ENV = "VERL_FULL_VOCAB_EXPERIMENT_NAME"
+
+
+def test_make_hidden_key():
+    assert full_vocab_tq.make_hidden_key("teacher_a", 3, "uid-42") == "teacher_a/step=3/sample=uid-42"
+
+
+def test_step_partition_id():
+    assert (
+        full_vocab_tq.step_partition_id("exp1", "teacher_a", 7)
+        == "full_vocab_hidden_exp1_teacher_a_step_7"
+    )
+
+
+def test_resolve_partition_prefix_explicit_arg_wins(monkeypatch):
+    monkeypatch.setenv(_ENV, "env_exp")
+    assert full_vocab_tq.resolve_partition_prefix("arg_exp") == "arg_exp"
+
+
+def test_resolve_partition_prefix_env_var_fallback(monkeypatch):
+    monkeypatch.setenv(_ENV, "env_exp")
+    assert full_vocab_tq.resolve_partition_prefix(None) == "env_exp"
+    # Empty string is falsy and must fall through to the env var.
+    assert full_vocab_tq.resolve_partition_prefix("") == "env_exp"
+
+
+def test_resolve_partition_prefix_default(monkeypatch):
+    monkeypatch.delenv(_ENV, raising=False)
+    assert full_vocab_tq.resolve_partition_prefix(None) == "default_exp"
+
+
+def test_put_get_clear_round_trip():
+    """Optional round-trip through a real TransferQueue cluster.
+
+    Skipped in normal CI: kv_put/kv_get require a TQ Controller process, which
+    is only started by the driver in a real training run. Kept as a manual /
+    integration check for environments that already have one running.
