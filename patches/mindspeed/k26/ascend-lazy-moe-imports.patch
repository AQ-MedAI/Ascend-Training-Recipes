+"""Load feature exports on demand without initializing unrelated MoE modes."""
+
+from importlib import import_module as _import_module
+
+_EXPORTS = {
+    'linear_backward_wgrad_detach': ('.modules.layers', 'linear_backward_wgrad_detach'),
+    'transformer_layer_forward_backward_overlaping': ('.transformer_layer', 'transformer_layer_forward_backward_overlaping'),
+    'dualpipev_fb_overlap_mtp_layer_forward': ('.transformer_layer', 'dualpipev_fb_overlap_mtp_layer_forward'),
+    'transformer_block_fb_overlap_init_wrapper': ('.transformer_block', 'transformer_block_fb_overlap_init_wrapper'),
+    'mtp_block_fb_overlap_forward_wrapper': ('.transformer_block', 'mtp_block_fb_overlap_forward_wrapper'),
+    'forward_backward_pipelining_with_interleaving': ('.vpp_schedules', 'forward_backward_pipelining_with_interleaving'),
+}
+
+__all__ = list(_EXPORTS)
+
+def __getattr__(name):
+    if name not in _EXPORTS:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    module, symbol = _EXPORTS[name]
+    value = getattr(_import_module(module, __name__), symbol)
+    globals()[name] = value
+    return value
+
+def __dir__():
+    return sorted(set(globals()) | set(_EXPORTS))
