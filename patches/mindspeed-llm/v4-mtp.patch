index 00000000..4b4fa94e
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek4/mtp.py
@@ -0,0 +1,27 @@
+"""V4 MTP helpers shared by the existing MindSpeed MTP implementation."""
+import torch
+
+
+def shift_cp_tokens(tensor, group, cp_size, cp_rank):
+    """Shift one token left in the global sequence, then restore mirrored CP shards."""
+    if cp_size == 1:
+        shifted = torch.zeros_like(tensor)
+        shifted[:, :-1] = tensor[:, 1:]
+        return shifted
+    parts = [torch.empty_like(tensor) for _ in range(cp_size)]
+    torch.distributed.all_gather(parts, tensor.contiguous(), group=group)
+    return shift_cp_parts(parts, cp_rank)
+
+
+def shift_cp_parts(parts, rank):
+    """Pure tensor implementation, also used to verify CP boundaries on CPU."""
+    if any(part.shape[1] % 2 for part in parts):
+        raise ValueError("Mirrored CP shards must have an even sequence length")
+    half = parts[0].shape[1] // 2
+    full = torch.cat([part[:, :half] for part in parts]
+                     + [part[:, half:] for part in reversed(parts)], dim=1)
+    shifted = torch.zeros_like(full)
+    shifted[:, :-1] = full[:, 1:]
+    start = rank * half
+    end = full.shape[1] - (rank + 1) * half
+    return torch.cat((shifted[:, start:start + half], shifted[:, end:end + half]), dim=1)
