@@ -0,0 +1,82 @@
+"""Full Engram adapter on the existing hash, gate and MCore checkpoint paths."""
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import torch
+from .training_engram import TrainingEngramGate
+from .full_engram_table import FullEngramTable, owner_groups
+from .full_engram_io import header, original_ids, small_table_metadata
+from .native_engram import EngramResources
+
+
+class FullEngram(TrainingEngramGate):
+    def __init__(self, c, rows, width, columns, groups, trainable, row_ids=None):
+        super().__init__(c['hidden_size'], c['hc_mult'], columns * width, c['rms_norm_eps'])
+        device = torch.device('cuda', torch.cuda.current_device())
+        self.embed = FullEngramTable(rows, width, group=torch.distributed.group.WORLD,
+            storage_device='cpu', communication_device=device, trainable=trainable, original_ids=row_ids)
+        p = self.embed.weight
+        p.engram_row_sharded = True
+        p.allreduce = True  # Explicit owner branch takes precedence over dense DP.
+        p.owner_data_parallel_group, p.owner_data_parallel_group_gloo = groups
+        p.sequence_parallel = False
+        # Each rank owns unique rows, including ranks with the same TP coordinate.
+        p.tensor_model_parallel = True
+        p.partition_dim, p.partition_stride = 0, 1
+        p.engram_rows, p.engram_width = rows, width
+        p.engram_start, p.engram_end = self.embed.start, self.embed.end
+
+    def forward(self, residual, hashes):
+        return super().forward(residual, self.embed(hashes))
+
+    def sharded_state_dict(self, prefix='', sharded_offsets=(), metadata=None):
+        from megatron.core.transformer.utils import make_sharded_tensors_for_checkpoint
+        values = {k: v for k, v in self.state_dict(keep_vars=True).items() if not k.startswith('embed.')}
+        result = make_sharded_tensors_for_checkpoint(values, prefix, sharded_offsets=sharded_offsets)
+        result.update(self.embed.sharded_state_dict(prefix + 'embed.', sharded_offsets, metadata))
+        return result
+
+
+class FullEngramResources:
+    hashes = EngramResources.hashes
+
+    def __init__(self, source, hash_source, max_length, trainable, model_path=None):
+        from transformers import AutoTokenizer
+        from types import SimpleNamespace
+        self.source = Path(source)
+        self.trainable = trainable
+        meta = small_table_metadata(self.source)
+        if meta is not None:
+            import hashlib
+            for path, key in ((Path(hash_source), 'hash_source_sha256'),
+                              (Path(model_path)/'config.json', 'model_config_sha256')):
+                if hashlib.sha256(path.read_bytes()).hexdigest() != meta[key]:
+                    raise ValueError('Small-table fixture identity mismatch: ' + key)
+        raw = json.loads((self.source / 'config.json').read_text())
+        c = raw.get('text_config', raw)
+        values = {k: v for k, v in c.items() if k.startswith('engram_')}
+        values['engram_pad_id'] = c.get('engram_pad_token_id', c.get('engram_pad_id', 2))
+        args = SimpleNamespace(**values, max_batch_size=1, max_seq_len=max_length)
+        spec = importlib.util.spec_from_file_location('dsv41_full_engram_hash', hash_source)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = module
+        spec.loader.exec_module(module)
+        tokenizer = AutoTokenizer.from_pretrained(self.source, local_files_only=True, trust_remote_code=False)
+        with torch.device('cpu'):
+            self.layout = module.EngramLayout.from_args(args)
+            self.hasher = module.NgramHashState(args, self.layout, tokenizer)
+        self.groups = owner_groups() if trainable else (None, None)
+
+    def build(self, c, layer):
+        shape, dtype = header(self.source, f'layers.{layer}.engram.embed.weight')
+        expected_rows = self.layout.num_embeddings[self.layout.layer_ids.index(layer)]
+        row_ids = original_ids(self.source, layer)
+        table_rows = expected_rows if row_ids is None else len(row_ids)
+        if row_ids is not None and bool((row_ids >= expected_rows).any()):
+            raise ValueError('Small-table row ID exceeds original hash layout')
+        if shape != [table_rows, self.layout.head_dim] or dtype != 'BF16':
+            raise ValueError('Full Engram table shape/dtype differs from hash layout')
+        columns = (self.layout.max_ngram_size - 1) * self.layout.n_heads
+        return FullEngram(c, *shape, columns, self.groups, self.trainable, row_ids=row_ids)
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/full_engram_io.py b/mindspeed_llm/tasks/models/transformer/deepseek41/full_engram_io.py
