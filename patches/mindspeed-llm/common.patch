@@ -0,0 +1,12 @@
+"""Expand selected block masks without NPU repeat_interleave's slow path."""
+import torch
+
+
+def expand_candidate_mask(keep, block_size, valid):
+    if block_size < 1 or keep.dtype != torch.bool or valid.dtype != torch.bool:
+        raise ValueError('positive block_size and boolean masks required')
+    c = valid.shape[-1]
+    if keep.shape[:-1] != valid.shape[:-1] or keep.shape[-1] != (c + block_size - 1) // block_size:
+        raise ValueError('candidate block/token mask shape mismatch')
+    block_ids = torch.arange(c, device=keep.device, dtype=torch.long) // block_size
+    return keep.index_select(-1, block_ids) & valid
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/compressor.py b/mindspeed_llm/tasks/models/transformer/deepseek41/compressor.py
new file mode 100644
index 0000000000000000000000000000000000000000..a66458969b1efc9af62715a0b18eff85ec5ee553
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/compressor.py
@@ -0,0 +1,91 @@
+"""Small-model CSA2 training building blocks, independent of Megatron/CANN.
+
+Position-zero, equal-length BS(D) prefill only. No quantization, RoPE, packing,
+distributed collectives, indexer scoring/loss or decode cache implementation.
+"""
+from dataclasses import dataclass, replace
+
+import torch
+from torch import nn
+import torch.nn.functional as F
+
+from .sparse_reference import sparse_mla_reference
+
+
+class TrainingCompressor(nn.Module):
+    """V4.1 non-overlapping compressor; returns latent before RoPE.
+
+    Input [B,S,D], output [B,floor(S/ratio),head_dim]. A partial last group
+    contributes no global KV or gradient through this branch. It still belongs
+    to the local SWA path. This stateless training version does not save tails.
+    """
+    def __init__(self, dim, head_dim, ratio, eps=1e-6):
+        super().__init__()
+        if ratio not in (1, 2):
+            raise ValueError("V4.1 training reference supports ratio 1 or 2")
+        self.ratio, self.eps = ratio, eps
+        self.wkv = nn.Linear(dim, head_dim, bias=False)
+        if ratio == 2:
+            self.wgate = nn.Linear(dim, head_dim, bias=False)
+        self.norm_weight = nn.Parameter(torch.ones(head_dim))
+
+    def forward(self, x):
+        if x.ndim != 3 or x.shape[-1] != self.wkv.in_features:
+            raise ValueError("expected [B,S,dim]")
+        # FP32 pool/projection for ratio 2, double preserved for gradcheck.
+        work = torch.float64 if x.dtype == torch.float64 else torch.float32
+        if self.ratio == 1:
+            latent = F.linear(x, self.wkv.weight.to(x.dtype))
+        else:
+            n = x.shape[1] // 2
+            groups = x[:, :n * 2].to(work).reshape(x.shape[0], n, 2, x.shape[-1])
+            value = F.linear(groups, self.wkv.weight.to(work))
+            gate = F.linear(groups, self.wgate.weight.to(work)).softmax(dim=2)
+            latent = (gate * value).sum(dim=2).to(x.dtype)
+        normalized = latent.to(work)
+        normalized = normalized * torch.rsqrt(normalized.square().mean(-1, keepdim=True) + self.eps)
+        return (normalized * self.norm_weight.to(work)).to(x.dtype)
+
+
+@dataclass(frozen=True)
+class SharedKVState:
+    """Per-forward references, not a process-global or persistent cache.
+
+    Full source creates a new instance. Reindex returns a new instance with
+    shared KV/index K but fresh discrete indices; Reuse keeps the instance.
+    Tensors must not be mutated in-place. frozen prevents field reassignment,
+    not tensor mutation. RoPE must be applied before publishing attention KV;
+    index_k may be derived from the pre-RoPE compressor latent separately.
+    """
+    source_layer: int
+    index_layer: int
+    ratio: int
+    global_kv: torch.Tensor
+    indices: torch.Tensor
+    index_k: torch.Tensor | None = None
+
+    def __post_init__(self):
+        if self.ratio not in (1, 2):
+            raise ValueError("expected ratio 1 or 2")
+        if self.index_layer < self.source_layer:
+            raise ValueError("index producer cannot precede KV source")
+        if self.global_kv.ndim != 4 or self.global_kv.shape[2] != 1:
+            raise ValueError("global_kv must be [B,C,1,D]")
+        if self.indices.ndim != 3 or self.indices.shape[0] != self.global_kv.shape[0]:
+            raise ValueError("indices must be [B,S,K]")
+        if self.indices.dtype not in (torch.int32, torch.int64):
+            raise ValueError("indices must be integer positions")
+        if self.indices.device != self.global_kv.device:
+            raise ValueError("indices and KV must share a device")
+        if self.index_k is not None and self.index_k.shape[:2] != self.global_kv.shape[:2]:
+            raise ValueError("index K and global KV must cover the same positions")
+
+    def reindex(self, layer, indices):
+        if layer <= self.index_layer:
+            raise ValueError("reindex layers must advance")
+        return replace(self, index_layer=layer, indices=indices)
+
+    def attend(self, q, local_kv, sinks, *, window=128, query_chunk_size=16):
+        return sparse_mla_reference(q, local_kv, self.global_kv, self.indices, sinks,
+                                    ratio=self.ratio, window=window,
+                                    query_chunk_size=query_chunk_size)
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/context_expert_parallel.py b/mindspeed_llm/tasks/models/transformer/deepseek41/context_expert_parallel.py
new file mode 100644
index 0000000000000000000000000000000000000000..85f485c0de5157ba85000485500afd9166ddd0c4
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/context_expert_parallel.py
@@ -0,0 +1,97 @@
+"""Correctness-first CP all-gather attention and distinct-token EP dispatch.
+
+Equal contiguous CP partitions, batch=1, ratio1 source20/consumer21 only.
+Attention recomputes full queries on each CP rank and slices local outputs:
+this is a communication/gradient baseline, not a memory-efficient CP kernel.
+EP uses all-gather + sum/scatter, not AllToAll or an upstream MCore dispatcher.
+"""
+import torch
+from torch import nn
+import torch.distributed as dist
+from .tensor_parallel_attention import Copy
+from .tensor_parallel_full_pair import TPFullPair
+
+
+def gather(x,group):
+    parts=[torch.empty_like(x) for _ in range(dist.get_world_size(group))]
+    dist.all_gather(parts,x.contiguous(),group=group)
+    return torch.cat(parts,dim=0)
+
+
+class Gather(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx,x,group,reduce_backward):
+        ctx.group=group;ctx.reduce_backward=reduce_backward
+        return gather(x,group)
+    @staticmethod
+    def backward(ctx,g):
+        g=g.contiguous().clone()
+        if ctx.reduce_backward:dist.all_reduce(g,group=ctx.group)
+        return g.chunk(dist.get_world_size(ctx.group),dim=0)[dist.get_rank(ctx.group)].contiguous(),None,None
+
+
+class Split(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx,x,group):
+        ctx.group=group
+        if x.shape[0]%dist.get_world_size(group):raise ValueError('token count must divide TP')
+        return x.chunk(dist.get_world_size(group),dim=0)[dist.get_rank(group)].contiguous()
+    @staticmethod
+    def backward(ctx,g):return gather(g,ctx.group),None
+
+
+class SumScatter(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx,x,group):
+        ctx.group=group;y=x.contiguous().clone();dist.all_reduce(y,group=group)
+        return y.chunk(dist.get_world_size(group),dim=0)[dist.get_rank(group)].contiguous()
+    @staticmethod
+    def backward(ctx,g):return gather(g,ctx.group),None
+
+
+class DispatchedEP(nn.Module):
+    """TP token split -> EP gather -> owned experts -> EP sum/scatter -> TP gather."""
+    def __init__(self,source,tp_group):
+        super().__init__();self.group=source.group;self.tp_group=tp_group
+        self.gate=source.gate;self.experts=source.experts;self.shared_experts=source.shared_experts
+        self.ids=source.ids;self.counts={};self.dispatch={}
+
+    def forward(self,x):
+        shape=x.shape;flat=x.reshape(-1,x.shape[-1])
+        unique=Split.apply(flat.float(),self.tp_group)
+        # Router sees unique TP tokens; merge router parameter gradients across TP once.
+        weights,indices=torch.func.functional_call(self.gate,{'weight':Copy.apply(self.gate.weight,self.tp_group)},(unique,))
+        all_x=Gather.apply(unique,self.group,True)
+        all_weights=Gather.apply(weights,self.group,True)
+        all_indices=gather(indices,self.group)
+        output=all_x*0+all_weights.sum()*0;self.counts={}
+        for i in self.ids:
+            tokens,slots=torch.where(all_indices==i);self.counts[str(i)]=tokens.numel()
+            if tokens.numel():output=output.index_add(0,tokens,self.experts[str(i)](all_x[tokens],all_weights[tokens,slots,None]).float())
+            else:output=output+sum(p.sum()*0 for p in self.experts[str(i)].parameters())
+        owned=SumScatter.apply(output,self.group)
+        # Loss/output is replicated over TP: backward splits rather than sums replicas.
+        routed=Gather.apply(owned,self.tp_group,False)
+        self.dispatch=dict(local_unique_tokens=unique.shape[0],global_unique_tokens=all_x.shape[0],local_assignments=sum(self.counts.values()),topk=indices.shape[-1])
+        return (routed+self.shared_experts(flat).float()).reshape(shape)
+
+
+class TPCPFullPair(TPFullPair):
+    def __init__(self,*args,cp_group,**kwargs):
+        super().__init__(*args,**kwargs);self.cp_group=cp_group
+        self.cp=dist.get_world_size(cp_group);self.cp_rank=dist.get_rank(cp_group)
+        for block in self.blocks.values():block['moe']=DispatchedEP(block['moe'],self.group)
+
+    def attention(self,x,teacher,layer,cache):
+        if x.shape[0]!=1:raise ValueError('CP baseline requires batch=1')
+        length=x.shape[1]
+        # Gather has a SUM backward: every CP query partition contributes to source KV.
+        full=Gather.apply(x.squeeze(0),self.cp_group,True).unsqueeze(0)
+        full_teacher=gather(teacher.squeeze(0),self.cp_group).unsqueeze(0)
+        if full_teacher.shape!=(1,length*self.cp,length*self.cp):raise ValueError('teacher must use global key positions')
+        out,aux,cache=super().attention(full,full_teacher,layer,cache)
+        start=self.cp_rank*length
+        # Full auxiliary objective duplicated across CP; count it only once globally.
+        self.last['cp_local_range']=[start,start+length]
+        self.last['cp_global_length']=length*self.cp
+        return out[:,start:start+length],aux/self.cp,cache
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/cropped_engram_lookup.py b/mindspeed_llm/tasks/models/transformer/deepseek41/cropped_engram_lookup.py
