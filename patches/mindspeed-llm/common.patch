+"""Fixed token CE training with original-hash, trainable cropped Engram rows."""
+import hashlib
+import json
+from pathlib import Path
+import torch
+from torch import nn
+from safetensors import safe_open
+from .plan_parallel_backbone import PlanParallelBackbone
+from .vocabulary_parallel import VocabularyParallel
+from .training_engram import TrainingEngramGate
+from .cropped_engram_lookup import lookup_cropped_rows, remap_original_ids, validate_original_ids
+
+
+def file_sha(path):
+    h=hashlib.sha256()
+    with open(path,'rb') as f:
+        for chunk in iter(lambda:f.read(8*1024*1024),b''):h.update(chunk)
+    return h.hexdigest()
+
+
+class CroppedEngram(nn.Module):
+    def __init__(self,rows,dim,streams,lookup_width,eps,device,original_ids=None):
+        super().__init__()
+        with torch.device('meta'):
+            self.gate=TrainingEngramGate(dim,streams,lookup_width,eps)
+        self.gate.to_empty(device=device)
+        self.rows=nn.Parameter(rows.float().to(device))
+        self.original_ids=None if original_ids is None else validate_original_ids(original_ids,len(rows))
+
+    def forward(self,x,indices):
+        return self.gate(x,lookup_cropped_rows(self.rows,indices))
+
+    def forward_original(self,x,hashes):
+        if self.original_ids is None:raise ValueError("original hash mapping is unavailable")
+        return self(x,remap_original_ids(self.original_ids,hashes).to(x.device))
+
+
+class TokenEngramBackbone(PlanParallelBackbone):
+    def __init__(self,model,operator,*,engram_crop,**kwargs):
+        crop=Path(engram_crop);meta=json.loads((crop/'manifest.json').read_text())
+        if meta['schema']!=1 or meta['status']!='prepared':raise ValueError('invalid Engram crop manifest')
+        if file_sha(Path(model)/'config.json')!=meta['model_config_sha256']:raise ValueError('Engram crop belongs to different model config')
+        if file_sha(crop/'engram.safetensors')!=meta['payload_sha256']:raise ValueError('Engram crop checksum mismatch')
+        super().__init__(model,operator,**kwargs)
+        for k,v in [('hidden_size',self.c['hidden_size']),('hc_mult',self.c['hc_mult']),('norm_eps',self.c['rms_norm_eps'])]:
+            if meta[k]!=v:raise ValueError('Engram config mismatch '+k)
+        self.vocabulary=VocabularyParallel(model,self.group,kwargs['device'])
+        self.engrams=nn.ModuleDict();self.engram_indices={};self.engram_manifest=meta
+        # Token/hash trace stays on CPU; trainable tables and gate parameters live on device.
+        with safe_open(crop/'engram.safetensors',framework='pt',device='cpu') as f:
+            self.fixed_tokens=f.get_tensor('tokens')
+            for spec in meta['layers']:
+                layer=str(spec['layer']);indices=f.get_tensor(layer+'.indices')
+                rows=f.get_tensor(layer+'.rows');original=f.get_tensor(layer+'.original_ids')
+                if rows.shape!=(spec['selected_rows'],spec['head_dim']) or len(original)!=len(rows):raise ValueError('row mapping shape mismatch')
+                if indices.shape[:2]!=(meta['steps'],meta['global_tokens']) or bool(((indices<0)|(indices>=len(rows))).any()):raise ValueError('invalid remapped hashes')
+                module=CroppedEngram(rows,self.c['hidden_size'],self.c['hc_mult'],indices.shape[-1]*rows.shape[-1],self.c['rms_norm_eps'],kwargs['device'],original_ids=original)
+                for name,p in module.gate.named_parameters():
+                    value=f.get_tensor(layer+'.'+name)
+                    if p.shape!=value.shape:raise ValueError('Engram gate shape mismatch '+name)
+                    with torch.no_grad():p.copy_(value)
+                self.engrams[layer]=module;self.engram_indices[layer]=indices
+        if not self.engrams:raise ValueError('empty Engram crop')
+        self.active_step=None
+        self.active_hashes=None
+        self.lookup_diagnostics={}
+
+    def before_layer(self,layer,residual):
+        key=str(layer)
+        if key not in self.engrams:return residual
+        s=residual.shape[1];start=self.cp_rank*s
+        if self.active_hashes is None:
+            ids=self.engram_indices[key][self.active_step,start:start+s].unsqueeze(0).to(residual.device)
+        else:
+            hashes=self.active_hashes[key][:,start:start+s]
+            ids=remap_original_ids(self.engrams[key].original_ids,hashes).to(residual.device)
+            self.lookup_diagnostics[key]=dict(requested_rows=ids.numel(),missing_rows=int((ids<0).sum()))
+        return self.engrams[key](residual,ids)
+
+    def forward(self,tokens,labels,step,original_hashes=None):
+        if original_hashes is not None:return self.forward_hashed(tokens,labels,original_hashes)
+        total=self.engram_manifest['global_tokens'];s=tokens.shape[1];start=self.cp_rank*s
+        if not 0<=step<self.engram_manifest['steps'] or total!=s*self.cp:raise ValueError('fixed Engram trace dimensions disagree')
+        expected=self.fixed_tokens[step:step+1,start:start+s]
+        expected_labels=self.fixed_tokens[step:step+1,start+1:start+s+1]
+        if not torch.equal(tokens.detach().cpu(),expected) or not torch.equal(labels.detach().cpu(),expected_labels):raise ValueError('tokens differ from original-hash crop trace; regenerate crop')
+        self.active_step=step
+        self.active_hashes=None
+        hidden=self.vocabulary.embed(tokens)
+        if hidden.requires_grad:hidden.retain_grad()
+        self.embedding_hidden=hidden
+        output,aux=super().forward(hidden)
+        return self.vocabulary.cross_entropy(output,labels),aux
+
+    def forward_hashed(self,tokens,labels,original_hashes):
+        """Arbitrary text trace with original hashes for the full CP sequence.
+
+        Caller must hash full prompt+response with original tokenizer/config before
+        CP slicing. Missing original rows are zero. No hash or token modulo-crop.
+        """
+        if tokens.shape!=labels.shape or tokens.ndim!=2 or tokens.shape[0]!=1:
+            raise ValueError('batch1 local token/label shapes required')
+        if set(original_hashes)!=set(self.engrams):raise ValueError('Engram hash layer inventory mismatch')
+        total=tokens.shape[1]*self.cp
+        for layer,hashes in original_hashes.items():
+            cols=self.engram_indices[layer].shape[-1]
+            if hashes.dtype!=torch.int64 or hashes.shape!=(1,total,cols):
+                raise ValueError('original hashes must cover full CP sequence')
+        self.active_hashes=original_hashes;self.lookup_diagnostics={}
+        try:
+            hidden=self.vocabulary.embed(tokens)
+            if hidden.requires_grad:hidden.retain_grad()
+            self.embedding_hidden=hidden
+            output,aux=super().forward(hidden)
+            return self.vocabulary.cross_entropy(output,labels),aux
+        finally:self.active_hashes=None
