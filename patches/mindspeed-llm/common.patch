+"""Differentiable original-basis Engram gate; table storage supplied separately."""
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+class TrainingEngramGate(nn.Module):
+    def __init__(self,dim,streams,lookup_width,eps):
+        super().__init__();self.dim=dim;self.streams=streams;self.eps=eps
+        self.wkv=nn.Linear(lookup_width,dim*(streams+1),bias=False)
+        self.q_weight=nn.Parameter(torch.ones(streams,dim));self.k_weight=nn.Parameter(torch.ones(streams,dim))
+
+    def forward(self,residual,rows):
+        kv=F.linear(rows.flatten(-2).bfloat16(),self.wkv.weight.bfloat16())
+        key,value=kv.split([self.streams*self.dim,self.dim],-1)
+        key=key.float().unflatten(-1,(self.streams,self.dim));h=residual.float()
+        rstd=torch.rsqrt(h.square().mean(-1)+self.eps)*torch.rsqrt(key.square().mean(-1)+self.eps)
+        dot=(h*self.q_weight.float()*self.k_weight.float()*key).sum(-1)*rstd*self.dim**-.5
+        signed=torch.where(torch.signbit(dot),-dot.abs().clamp_min(1e-6).sqrt(),dot.abs().clamp_min(1e-6).sqrt())
+        gate=torch.sigmoid(signed)
+        return (h+gate[...,None]*value.float().unsqueeze(-2)).to(residual.dtype)
