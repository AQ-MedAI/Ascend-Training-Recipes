index 0000000000000000000000000000000000000000..049d35bae9d02827887fd0748010b4a41738439d
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/vocabulary_parallel.py
@@ -0,0 +1,50 @@
+"""Vocabulary-row TP embedding and exact distributed cross entropy."""
+import json
+from pathlib import Path
+import torch
+from torch import nn
+from torch.nn import functional as F
+import torch.distributed as dist
+from .tensor_parallel_attention import Copy, Sum
+
+
+class VocabularyParallel(nn.Module):
+    def __init__(self,model,group,device):
+        super().__init__()
+        from safetensors import safe_open
+        root=Path(model).resolve();raw=json.loads((root/'config.json').read_text());c=raw.get('text_config',raw)
+        self.group=group;self.vocab=c['vocab_size'];self.dim=c['hidden_size']
+        size=dist.get_world_size(group);rank=dist.get_rank(group)
+        width=(self.vocab+size-1)//size;self.start=rank*width;self.end=min(self.start+width,self.vocab)
+        if self.start>=self.end:raise ValueError('empty vocabulary shard unsupported')
+        mapping=json.loads((root/'model.safetensors.index.json').read_text())['weight_map']
+        for name,key in [('embedding','embed.weight'),('head','head.weight')]:
+            path=(root/mapping[key]).resolve();path.relative_to(root)
+            with safe_open(path,framework='pt',device='cpu') as f:
+                view=f.get_slice(key)
+                if view.get_shape()!=[self.vocab,self.dim]:raise ValueError('shape mismatch '+key)
+                w=view[self.start:self.end].float()
+            if not torch.isfinite(w).all():raise ValueError('nonfinite '+key)
+            p=nn.Parameter(w.to(device));p.tensor_model_parallel=True;p.partition_dim=0;p.partition_stride=1
+            setattr(self,name,p)
+
+    def embed(self,tokens):
+        valid=(tokens>=self.start)&(tokens<self.end)
+        ids=(tokens-self.start).masked_fill(~valid,0)
+        local=F.embedding(ids,self.embedding).masked_fill(~valid[...,None],0)
+        return Sum.apply(local,self.group)
+
+    def cross_entropy(self,hidden,labels):
+        # Head logits use FP32, matching the local inference head policy.
+        logits=F.linear(Copy.apply(hidden.float(),self.group),self.head.float())
+        return parallel_cross_entropy(logits,labels,self.start,self.end,self.group)
+
+
+def parallel_cross_entropy(logits,labels,start,end,group):
+    if labels.shape!=logits.shape[:-1]:raise ValueError('label shape mismatch')
+    valid=(labels>=start)&(labels<end)
+    maximum=logits.detach().amax(-1);dist.all_reduce(maximum,op=dist.ReduceOp.MAX,group=group)
