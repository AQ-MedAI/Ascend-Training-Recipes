+"""Differentiable CSA2 reference for correctness/small-model bring-up.
+
+Not a production kernel. Uses FP32 PyTorch gather/einsum/softmax, shares K and V,
+and retains autograd links to source KV across consumer layers. BSND only, equal
+unpacked sequence lengths, prefill from position zero. No RoPE or quantization:
+inputs must already be in the attention space. No Indexer loss is defined here.
+"""
+import torch
+
+
+def sparse_mla_reference(q, ori_kv, cmp_kv, indices, sinks, *, ratio,
+                         window=128, scale=None, query_chunk_size=16):
+    """Return [B,S,H,D], preserving q.dtype.
+
+    q: [B,S,H,D]; ori_kv: [B,S,1,D]; cmp_kv: [B,floor(S/ratio),1,D]
+    or [B,0,1,D] for pure SWA (no valid global indices).
+    indices: [B,S,K], int32/int64, zero-based cmp positions, -1 padding.
+    sinks: [H], logits for a zero-valued sink, or None.
+    Each index slot is an attention entry; callers supply unique valid indices
+    (as top-k does). Repeated references across queries accumulate gradients.
+
+    Padding never contributes to the softmax denominator. Future cmp groups
+    are masked until their last token has been processed. Query chunking bounds
+    per-operation workspace, but autograd can retain activations for all chunks;
+    this is not a claim of low training-memory usage or long-context efficiency.
+    """
+    if ratio not in (1, 2, 4) or window < 1 or query_chunk_size < 1:
+        raise ValueError("ratio must be 1/2/4; window and query_chunk_size must be positive")
+    if q.ndim != 4:
+        raise ValueError("q must have shape [B,S,H,D]")
+    b, s, h, d = q.shape
+    if min(b, s, h, d) < 1:
+        raise ValueError("empty q dimensions are not supported")
+    if ori_kv.shape != (b, s, 1, d) or cmp_kv.shape not in ((b, s // ratio, 1, d), (b, 0, 1, d)):
+        raise ValueError("KV shapes must match equal-length, position-zero prefill")
+    if indices.ndim != 3 or indices.shape[:2] != (b, s):
+        raise ValueError("indices must have shape [B,S,K]")
+    if indices.dtype not in (torch.int32, torch.int64):
+        raise ValueError("indices must be int32 or int64")
+    if sinks is not None and sinks.shape != (h,):
+        raise ValueError("sinks must have shape [H]")
+    tensors = (ori_kv, cmp_kv, indices) + (() if sinks is None else (sinks,))
+    if any(t.device != q.device for t in tensors):
+        raise ValueError("all inputs must be on the same device")
+    if bool(((indices < -1) | (indices >= cmp_kv.shape[1])).any()):
+        raise ValueError("indices outside [-1, number of global KV positions)")
+
+    # Keep float64 for gradcheck; BF16/FP16/FP32 use FP32 arithmetic.
+    work_dtype = torch.float64 if q.dtype == torch.float64 else torch.float32
+    q_work = q.to(work_dtype)
