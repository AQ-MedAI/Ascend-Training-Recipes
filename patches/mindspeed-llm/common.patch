+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/expert_parallel.py
@@ -0,0 +1,56 @@
+"""EP=2 local experts using native Megatron AllGather token dispatch.
+
+Correctness entry, not memory/communication optimized. Equal token shapes on
+ranks, no capacity/drop/overlap/quantization. Shared expert and router replicate.
+"""
+import torch
+from torch import nn
+
+
+class ExpertParallelMoE(nn.Module):
+    def __init__(self,source,config,*,ep_rank,dispatcher_factory=None):
+        super().__init__()
+        size=config.expert_model_parallel_size
+        if size!=2 or source.n_experts%size or ep_rank not in (0,1):raise ValueError('requires divisible experts and EP=2')
+        if (config.expert_tensor_parallel_size or 1)!=1:raise ValueError('expert tensor parallel unsupported')
+        if config.moe_router_topk!=source.gate.topk:raise ValueError('router topk mismatch')
+        if dispatcher_factory is None:
+            from megatron.core.transformer.moe.token_dispatcher import MoEAllGatherTokenDispatcher
+            dispatcher_factory=MoEAllGatherTokenDispatcher
+        self.dim,self.n_experts=source.dim,source.n_experts
+        self.gate=source.gate
+        count=source.n_experts//size
+        self.local_ids=list(range(ep_rank*count,(ep_rank+1)*count))
+        self.experts=nn.ModuleDict({str(i):source.experts[i] for i in self.local_ids})
+        self.shared_experts=source.shared_experts
+        for p in self.experts.parameters():p.allreduce=False
+        self.dispatcher=dispatcher_factory(count,self.local_ids,config)
+        self.last_counts=None
+
+    def forward(self,x):
+        shape=x.shape;flat=x.reshape(-1,self.dim)
+        weights,indices=self.gate(flat)
+        probs=weights.new_zeros(flat.shape[0],self.n_experts).scatter(1,indices,weights)
+        route=torch.zeros_like(probs,dtype=torch.bool).scatter(1,indices,True)
+        packed,counts,packed_weights=self.dispatcher.token_permutation(x,probs,route)
+        self.last_counts=counts.detach().cpu().tolist()
+        pieces=[];start=0
+        for expert_id,count in zip(self.local_ids,self.last_counts):
+            end=start+count
+            if count:
+                pieces.append(self.experts[str(expert_id)](packed[start:end],packed_weights[start:end,None]).to(flat.dtype))
+            start=end
+        if start!=packed.shape[0]:raise RuntimeError('dispatch counts mismatch')
+        # Keep both gather paths in the graph even when this rank owns no routed tokens.
+        output=torch.cat(pieces,0) if pieces else packed*0+packed_weights.sum()*0
+        routed,_=self.dispatcher.token_unpermutation(output)
+        return (routed.reshape_as(flat)+self.shared_experts(flat).to(flat.dtype)).reshape(shape)
+
+
+def partition_experts(model,config):
+    from megatron.core import parallel_state
+    if parallel_state.get_expert_model_parallel_world_size()!=2:raise ValueError('initialize native EP=2 group first')
+    rank=parallel_state.get_expert_model_parallel_rank()
+    for block in model.decoder.backbone.layers:
+        if not hasattr(block,'moe'):raise ValueError('EP entry requires MoE in all blocks')
+        block.moe=ExpertParallelMoE(block.moe,config,ep_rank=rank)
