+"""Single-rank token-to-loss prototype; no Megatron registration or distributed experts.
+
+Untied embedding/head, dense/MoE backbone, equal-length position-zero sequences.
+Labels are already shifted by the caller, as in the existing GPT data pipeline.
+"""
+from dataclasses import dataclass
+import torch
+from torch import nn
+from torch.nn import functional as F
+from .training_adapter import SingleRankTrainingAdapter
+
+
+@dataclass(frozen=True)
+class LanguageModelOutput:
+    logits: torch.Tensor
+    auxiliary: torch.Tensor
+    token_losses: torch.Tensor | None
+    label_valid: torch.Tensor | None
+
+
+class SingleRankLanguageModel(nn.Module):
+    def __init__(self, config, *, vocab_size, operator, teacher, coefficient, precision='float32', data_parallel_size=1):
+        super().__init__()
+        if not isinstance(vocab_size, int) or vocab_size < 2:
+            raise ValueError('vocab_size must be an integer >= 2')
+        self.vocab_size, self.precision = vocab_size, precision
+        self.decoder = SingleRankTrainingAdapter(config, operator=operator, teacher=teacher,
+                                                 coefficient=coefficient, precision=precision, data_parallel_size=data_parallel_size)
+        self.embedding = nn.Embedding(vocab_size, config['dim'])
+        self.output_layer = nn.Linear(config['dim'], vocab_size, bias=False)
+
+    def forward(self, tokens, position_ids=None, attention_mask=None, *, labels=None):
+        if tokens.ndim != 2 or min(tokens.shape) < 1 or tokens.dtype not in (torch.int32, torch.int64):
+            raise ValueError('tokens must be nonempty integer [batch, sequence]')
+        if bool(((tokens < 0) | (tokens >= self.vocab_size)).any()):
+            raise ValueError('token id outside vocabulary')
+        if position_ids is not None:
+            expected = torch.arange(tokens.shape[1], device=tokens.device).expand_as(tokens)
+            if position_ids.shape != tokens.shape or position_ids.dtype not in (torch.int32, torch.int64) or not torch.equal(position_ids, expected):
+                raise ValueError('only contiguous position-zero position_ids are supported')
+        if labels is not None:
+            if labels.shape != tokens.shape or labels.dtype not in (torch.int32, torch.int64) or labels.device != tokens.device:
+                raise ValueError('labels must be integer tensors matching tokens')
+            if bool(((labels != -100) & ((labels < 0) | (labels >= self.vocab_size))).any()):
+                raise ValueError('label id outside vocabulary or ignore_index=-100')
+        if any(p.dtype != torch.float32 for p in self.parameters()):
+            raise ValueError('language model requires FP32 master parameters')
+        with torch.autocast(device_type=tokens.device.type, enabled=False):
+            hidden = self.embedding(tokens).transpose(0, 1).contiguous()
+            hidden, auxiliary = self.decoder(hidden, attention_mask)
+            hidden = hidden.transpose(0, 1).contiguous()
+            dtype = torch.bfloat16 if self.precision == 'bfloat16' else torch.float32
+            logits = F.linear(hidden.to(dtype), self.output_layer.weight.to(dtype)).float()
+            losses = None if labels is None else F.cross_entropy(
+                logits.reshape(-1, self.vocab_size), labels.long().reshape(-1), reduction='none',
+                ignore_index=-100).reshape_as(labels)
+        return LanguageModelOutput(logits, auxiliary, losses, None if labels is None else labels != -100)
+
+
+def effective_loss_mask(labels, loss_mask=None):
+    valid = labels != -100
+    if loss_mask is not None:
+        if loss_mask.shape != labels.shape or loss_mask.device != labels.device:
+            raise ValueError('loss_mask must match label shape and device')
+        if not bool(((loss_mask == 0) | (loss_mask == 1)).all()):
+            raise ValueError('loss_mask must contain only 0 or 1')
+        valid = valid & loss_mask.bool()
+    return valid
+
+
+@dataclass(frozen=True)
+class LossSums:
+    language: torch.Tensor
+    auxiliary: torch.Tensor
+    valid_tokens: int
+    queries: int
+
+    def normalized(self, *, total_valid_tokens=None, total_queries=None):
+        """Supply whole accumulation-group denominators for every microbatch.
+
+        No additional division by number of microbatches is allowed. Auxiliary
+        coefficient is already applied inside the Indexer and is not repeated.
+        """
+        nt = self.valid_tokens if total_valid_tokens is None else total_valid_tokens
+        nq = self.queries if total_queries is None else total_queries
+        if not isinstance(nt, int) or not isinstance(nq, int) or nt < self.valid_tokens or nq < self.queries or nq <= 0:
+            raise ValueError('normalizers must be integer group totals covering this microbatch')
+        lm = self.language / nt if nt else self.language * 0
+        return lm + self.auxiliary / nq
+
+
+def loss_sums(output, loss_mask=None):
+    if output.token_losses is None or output.label_valid is None:
+        raise ValueError('labels are required to compute training loss')
+    valid = output.label_valid
+    if loss_mask is not None:
+        # Reuse validation without inventing a label for ignored positions.
+        dummy_labels = torch.where(valid, 0, -100)
+        valid = effective_loss_mask(dummy_labels, loss_mask)
+    queries = output.token_losses.numel()
+    return LossSums((output.token_losses * valid).sum(), output.auxiliary * queries,
+                    int(valid.sum().item()), queries)
+
+
+def forward_step(batch, model, *, total_valid_tokens=None, total_queries=None):
+    """Standalone training call, not a Megatron pipeline forward_step callback.
+
+    loss_mask affects CE only. Indexer KL remains over all B*S queries, including
+    ignored label positions. All-ignored batches thus may still train Indexer.
+    """
+    output = model(batch['tokens'], batch.get('position_ids'), batch.get('attention_mask'), labels=batch['labels'])
+    sums = loss_sums(output, batch.get('loss_mask'))
+    loss = sums.normalized(total_valid_tokens=total_valid_tokens, total_queries=total_queries)
+    metrics = dict(lm_sum=sums.language.detach(), auxiliary_sum=sums.auxiliary.detach(),
+                   valid_tokens=sums.valid_tokens, queries=sums.queries)
+    return loss, metrics
