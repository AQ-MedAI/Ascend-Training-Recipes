+"""Real checkpoint plan-driven TP/CP/EP backbone training smoke (no LM head)."""
+import json
+import os
+from pathlib import Path
+import torch
+from torch import nn
+from torch.nn import functional as F
+import torch.distributed as dist
+from .architecture import build_layer_plan, AttentionMode
+from .tensor_parallel_attention import TPAttentionPair, Copy, Sum
+from .tensor_parallel_full_pair import ReplicatedInputEP
+from .context_expert_parallel import Gather, DispatchedEP
+from .attention_geometry import Norm, rope_angles, rotary_tail
+from .mhc import SinglePassMHC, collapse, initial_pre
+from .indexer import ranked_indices, masked_teacher_kl
+from .native_indexer import lightning_indices, candidate_validity
+from .candidate_mask import expand_candidate_mask
+
+
+def gather_batch_sequence(value, group):
+    """Gather CP sequence partitions without merging independent batch samples."""
+    return Gather.apply(value.transpose(0, 1).contiguous(), group, True).transpose(0, 1)
+
+
+def resolve_window_size(config):
+    """HF uses sliding_window; inference/test configs may use window_size."""
+    values={name:config[name] for name in ('sliding_window','window_size') if name in config}
+    if not values:
+        raise ValueError('Missing attention window: expected sliding_window or window_size')
+    if any(isinstance(v,bool) or not isinstance(v,int) or v<1 for v in values.values()):
+        raise ValueError(f'Attention window must be a positive integer: {values}')
+    if len(set(values.values()))!=1:
+        raise ValueError(f'Conflicting attention window fields: {values}')
+    return next(iter(values.values()))
+
+
+def attention_kv_input(value, group, *, layer, source, name):
+    """Convert the kernel boundary without casting storage-less empty KV views."""
+    detail = dict(layer=layer, source=source, name=name, shape=list(value.shape),
+                  dtype=str(value.dtype), device=str(value.device),
+                  numel=value.numel(), storage_bytes=value.untyped_storage().nbytes(),
+                  grad_enabled=torch.is_grad_enabled())
+    if not value.numel():
+        return value.new_empty(value.shape, dtype=torch.bfloat16)
+    if not detail['storage_bytes']:
+        raise RuntimeError('Nonempty attention KV has released storage: '+str(detail))
+    try:
+        copied = Copy.apply(value, group)
+        return copied.bfloat16()
+    except RuntimeError as exc:
+        raise RuntimeError('Attention KV boundary failed: '+str(detail)) from exc
+
+
+class PlanParallelBackbone(TPAttentionPair):
+    def __init__(self, model, operator, *, group, cp_group, ep_group, device):
+        # The parent supplies projection helpers only; its two-layer loader is bypassed.
+        nn.Module.__init__(self)
+        from safetensors import safe_open
+        self.group=group;self.tp=dist.get_world_size(group);self.rank=dist.get_rank(group)
+        self.cp_group=cp_group;self.cp=dist.get_world_size(cp_group);self.cp_rank=dist.get_rank(cp_group)
+        self.operator=operator;self.precision='bfloat16'
+        root=Path(model).resolve();raw=json.loads((root/'config.json').read_text());self.c=c=raw.get('text_config',raw)
+        logical=dict(c)
+        for dst,src in [('n_layers','num_hidden_layers'),('kv_source_layers','kv_source_layer_ids'),('index_source_layers','index_source_layer_ids'),('candidate_source_layer','candidate_source_layer_id')]:
+            if src in c:logical[dst]=c[src]
+        self.plans=build_layer_plan(logical)
+        if len(self.plans)!=40:raise ValueError('requires exactly 40 backbone layers')
+        if c.get('engram_layer_ids'):raise ValueError('Engram unsupported in this training experiment')
+        for n in ('num_attention_heads','o_groups','index_n_heads'):
+            if c[n]%self.tp:raise ValueError(n+' must divide TP')
+        if c['num_attention_heads']%c['o_groups']:raise ValueError('incomplete output groups')
+        self.topk=c['index_topk'];self.window=resolve_window_size(c)
+        if not 1<=self.topk<=512:raise ValueError('kernel supports index_topk <=512')
+        self.weights=nn.ParameterDict();self.blocks=nn.ModuleDict();self.metadata={};self.last={}
+        mapping=json.loads((root/'model.safetensors.index.json').read_text())['weight_map']
+        def read(key,axis=None):
+            path=(root/mapping[key]).resolve();path.relative_to(root)
+            with safe_open(path,framework='pt',device='cpu') as f:
+                view=f.get_slice(key);shape=view.get_shape();sl=[slice(None)]*len(shape)
+                if axis is not None:
+                    if shape[axis]%self.tp:raise ValueError('indivisible '+key)
+                    width=shape[axis]//self.tp;sl[axis]=slice(self.rank*width,(self.rank+1)*width)
+                value=view[tuple(sl)].float()
+            if not torch.isfinite(value).all():raise ValueError('nonfinite '+key)
+            return value
+        common=['wq_a.weight','q_norm.weight','wq_b.weight','wo_a.weight','wo_b.weight','wkv.weight','kv_norm.weight','attn_sink']
+        for plan in self.plans:
+            layer=plan.layer_id;names=list(common)
+            if plan.owns_kv:
+                names+=['compressor.wkv.weight','compressor.norm.weight','indexer.wk.weight','indexer.k_norm.weight']
+                if plan.ratio==2:names+=['compressor.wgate.weight']
+            if plan.owns_indexer:names+=['indexer.wq_b.weight','indexer.weights_proj.weight']
+            for name in names:
+                axis=0 if name in ('wq_b.weight','wo_a.weight','attn_sink','indexer.wq_b.weight','indexer.weights_proj.weight') else 1 if name=='wo_b.weight' else None
+                key=f'layers.{layer}.attn.{name}';p=nn.Parameter(read(key,axis).to(device))
+                p.tensor_model_parallel=axis is not None;p.partition_dim=axis if axis is not None else -1;p.partition_stride=1
+                self.weights[self.key(layer,name)]=p;self.metadata[self.key(layer,name)]={'checkpoint':key}
+            with torch.device('meta'):
+                block=nn.ModuleDict({n:SinglePassMHC(c['hidden_size'],c['hc_mult'],iters=c['hc_sinkhorn_iters'],norm_eps=c['rms_norm_eps'],eps=c['hc_eps']) for n in ('attn_mhc','ffn_mhc')})
+                block['attn_norm']=Norm(c['hidden_size'],c['rms_norm_eps']);block['ffn_norm']=Norm(c['hidden_size'],c['rms_norm_eps'])
+            block.to_empty(device=device);block['moe']=ReplicatedInputEP(c,ep_group,device)
+            names={f'{kind}_mhc.{name}':f'hc_{kind}_{suffix}' for kind in ('attn','ffn') for name,suffix in [('hc_fn.weight','fn'),('hc_scale','scale'),('hc_base','base')]}
+            for name,p in list(block.named_parameters())+list(block.named_buffers()):
+                suffix=names.get(name,'ffn.'+name[4:] if name.startswith('moe.') else name)
+                key=f'layers.{layer}.{suffix}';value=read(key)
+                if value.shape!=p.shape:raise ValueError('shape mismatch '+key)
+                with torch.no_grad():p.copy_(value)
+            block['moe']=DispatchedEP(block['moe'],group);self.blocks[str(layer)]=block
+            if dist.get_rank()==0:print(f'load layer {layer}: {plan.mode.value}, ratio={plan.ratio}',flush=True)
+        with torch.device('meta'):self.final_norm=Norm(c['hidden_size'],c['rms_norm_eps'])
+        self.final_norm.to_empty(device=device)
+        with torch.no_grad():self.final_norm.weight.copy_(read('norm.weight'))
+
+    def angles(self,positions,ratio,cache_key=None,cache=None):
+        c=self.c;y=c['rope_scaling']
+        key = (ratio, cache_key, str(positions.device))
+        if cache is not None and cache_key is not None and key in cache:
+            return cache[key]
+        angles = rope_angles(positions,c['qk_rope_head_dim'],base=c['compress_rope_theta'] if ratio else c['rope_theta'],original_seq_len=y['original_max_position_embeddings'] if ratio else 0,factor=y['factor'],beta_fast=y['beta_fast'],beta_slow=y['beta_slow'])
+        if cache is None or cache_key is None:
+            return angles
+        cache[key] = (angles.cos(), angles.sin())
+        return cache[key]
+
+    def attention(self,x,plan,state,rope_cache=None):
+        b,s,_=x.shape;c=self.c;layer=plan.layer_id;r=plan.ratio
+        if b<1 or s%2:raise ValueError('nonempty batch, even CP partitions required (ratio2 groups must not cross CP boundary)')
+        start=self.cp_rank*s;total=s*self.cp;pos=torch.arange(start,start+s,device=x.device)
+        angles=self.angles(pos,r,cache_key=(start,s,1),cache=rope_cache);w=lambda n:self.w(layer,n)
+        qr=Copy.apply(self.norm(self.linear(x,w('wq_a.weight')),w('q_norm.weight')).float(),self.group)
+        local=rotary_tail(self.norm(self.linear(x,w('wkv.weight')),w('kv_norm.weight')),angles).float()
+        local=gather_batch_sequence(local,self.cp_group).unsqueeze(2)
+        aux=x.sum()*0
+        if r==0:
+            kv=x.new_empty(b,0,1,c['head_dim']);indices=torch.empty(b,s,0,device=x.device,dtype=torch.long)
+        else:
+            if plan.owns_kv:
+                if r==2:
+                    groups=x.bfloat16().float().reshape(b,s//2,2,-1)
+                    latent=(F.linear(groups,w('compressor.wgate.weight').float()).softmax(2)*F.linear(groups,w('compressor.wkv.weight').float())).sum(2).bfloat16()
+                    latent=self.norm(latent,w('compressor.norm.weight'))
+                else:latent=self.norm(self.linear(x,w('compressor.wkv.weight')),w('compressor.norm.weight'))
+                ka=self.angles(torch.arange(start,start+s,r,device=x.device),r,cache_key=(start,s,r),cache=rope_cache)
+                kv=gather_batch_sequence(rotary_tail(latent,ka).float(),self.cp_group).unsqueeze(2)
+                keys=self.norm(self.linear(latent,w('indexer.wk.weight')),w('indexer.k_norm.weight'))
+                keys=gather_batch_sequence(rotary_tail(keys,ka).float(),self.cp_group)
+                state=dict(kv_source=layer,index_source=None,kv=kv,keys=keys,pool=None)
+            else:
+                if state is None or state['kv_source']!=plan.kv_source:raise ValueError('incorrect KV source')
+                kv=state['kv']
+            if plan.owns_indexer:
+                ih=c['index_n_heads']//self.tp;dim=c['index_head_dim']
+                iq=rotary_tail(self.linear(qr,w('indexer.wq_b.weight')).reshape(b,s,ih,dim),angles)
+                iw=self.linear(Copy.apply(x.float(),self.group),w('indexer.weights_proj.weight')).float()*(dim*c['index_n_heads'])**-.5
+                backend = os.environ.get('V41_INDEXER_BACKEND', 'lightning')
+                if backend not in ('lightning', 'reference'):
+                    raise ValueError('V41_INDEXER_BACKEND must be lightning or reference')
+                fused = hasattr(self, 'indexer_auxiliary') and backend == 'lightning'
+                scores = valid = None
+                if fused:
+                    is_source = plan.candidate_source == layer
+                    candidates = None if is_source else state['pool']
+                    if plan.candidate_source is not None and not is_source and candidates is None:
+                        raise RuntimeError('Candidate consumer ran before its source')
+                    indices, pool = lightning_indices(iq, state['keys'], iw, group=self.group,
+                        ratio=r, query_start=start, topk=self.topk,
+                        candidate_source=is_source, candidates=candidates,
+                        candidate_blocks=c.get('candidate_topk_blocks', 2048),
+                        candidate_block_size=c.get('candidate_block_size', 8))
+                    state['pool'] = pool
+                    indices=F.pad(indices,(0,512-indices.shape[-1]),value=-1)
+                    # Keep DDP hooks for zero-loss Indexer parameters without a dense score graph.
+                    if self.config.v41_indexer_coefficient == 0:
+                        aux = (iq.sum() + iw.sum() + state['keys'].sum()) * 0
+                    else:
+                        scores=Sum.apply((torch.einsum('bshd,bcd->bshc',iq.float(),Copy.apply(state['keys'],self.group)).relu()*iw.unsqueeze(-1)).sum(2),self.group)
+                        valid=((torch.arange(kv.shape[1],device=x.device)+1)*r<=pos[:,None]+1)[None].expand_as(scores)
+                        if candidates is not None:
+                            valid = candidate_validity(candidates, c['candidate_block_size'], valid)
+                else:
+                    scores=Sum.apply((torch.einsum('bshd,bcd->bshc',iq.float(),Copy.apply(state['keys'],self.group)).relu()*iw.unsqueeze(-1)).sum(2),self.group)
+                    valid=((torch.arange(kv.shape[1],device=x.device)+1)*r<=pos[:,None]+1)[None].expand_as(scores)
+                    if plan.candidate_source==layer:
+                        bs=c['candidate_block_size'];nb=c['candidate_topk_blocks']
+                        blocks=F.pad(scores.detach().masked_fill(~valid,-torch.inf),(0,-scores.shape[-1]%bs),value=-torch.inf).unflatten(-1,(-1,bs)).amax(-1)
+                        latest=((pos+1)//r-1)//bs
+                        blocks=blocks.masked_fill(torch.arange(blocks.shape[-1],device=x.device)==latest[:,None],torch.inf)
+                        vals,ids=ranked_indices(blocks,min(nb,blocks.shape[-1]))
+                        keep=torch.zeros_like(blocks,dtype=torch.bool).scatter(-1,ids,vals>-torch.inf)
+                        pool=expand_candidate_mask(keep,bs,valid)
+                        state['pool']=pool
+                    if state['pool'] is not None:valid=valid&state['pool']
+                    vals,ids=ranked_indices(scores.masked_fill(~valid,-torch.inf),min(self.topk,scores.shape[-1]))
+                    # Keep score order; masked -inf choices already follow finite scores.
+                    indices=torch.where(torch.isfinite(vals),ids,-1)
+                    indices=F.pad(indices,(0,512-indices.shape[-1]),value=-1).long()
+                    # Historical probes retain their explicit uniform target. Native
+                    # training supplies its selected-global teacher below, after Q.
+                    if not hasattr(self, 'indexer_auxiliary'):
+                        aux=masked_teacher_kl(scores,valid.float(),valid,coefficient=.1)/self.cp
+                state['indices']=indices;state['index_source']=layer
+            else:
+                if state['index_source']!=plan.index_source:raise ValueError('incorrect index source')
+                indices=state['indices']
+        q=rotary_tail(self.linear(qr,w('wq_b.weight')).reshape(b,s,c['num_attention_heads']//self.tp,c['head_dim']),angles)
+        if r and plan.owns_indexer and hasattr(self, 'indexer_auxiliary'):
+            aux=aux+self.indexer_auxiliary(q,kv,indices,scores,valid,pos)
+        local_input = attention_kv_input(local, self.group, layer=layer, source=layer, name='local')
+        global_input = attention_kv_input(kv, self.group, layer=layer, source=plan.kv_source, name='global')
+        out=self.operator(q,local_input,global_input,indices,w('attn_sink').float(),ratio=r or 1,window=self.window,query_start=start)
