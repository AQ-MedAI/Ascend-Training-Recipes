+"""Opt-in TP attention source20 -> consumer21; explicit BF16 compute/FP32 masters.
+
+MCore group ownership is supplied by the caller. Not a complete Transformer block.
+"""
+import json
+from pathlib import Path
+import torch
+from torch import nn
+from torch.nn import functional as F
+import torch.distributed as dist
+from .attention_geometry import rope_angles, rotary_tail, rms_norm
+from .indexer import select_indices, causal_mask, masked_teacher_kl
+
+
+class Copy(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx,x,group):ctx.group=group;return x
+    @staticmethod
+    def backward(ctx,g):
+        g=g.contiguous().clone();dist.all_reduce(g,group=ctx.group);return g,None
+
+
+class Sum(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx,x,group):
+        y=x.clone();dist.all_reduce(y,group=group);return y
+    @staticmethod
+    def backward(ctx,g):return g,None
+
+
+class TPAttentionPair(nn.Module):
+    """Two sequential attention branches, source KV/indices reused without detach.
+
+    This module owns TP gradient sums; MCore must not also finalize replicated
+    gradients across TP. DDP may reduce only over its data-parallel group.
+    """
+    def __init__(self,model,operator,*,group,device,precision='bfloat16'):
+        super().__init__()
+        from safetensors import safe_open
+        if precision not in ('bfloat16','float32'):raise ValueError(precision)
+        self.group=group;self.tp=dist.get_world_size(group);self.rank=dist.get_rank(group)
+        self.operator=operator;self.precision=precision
+        model=Path(model).resolve();raw=json.loads((model/'config.json').read_text());self.c=c=raw.get('text_config',raw)
+        for n in ('num_attention_heads','o_groups','index_n_heads'):
+            if c[n]%self.tp:raise ValueError(n+' not divisible by TP')
+        if c['compress_ratios'][20:22]!=[1,1]:raise ValueError('Requires ratio1 layers20/21')
+        mapping=json.loads((model/'model.safetensors.index.json').read_text())['weight_map']
+        self.weights=nn.ParameterDict();self.metadata={}
+        common=['wq_a.weight','q_norm.weight','wq_b.weight','wo_a.weight','wo_b.weight','wkv.weight','kv_norm.weight','attn_sink']
+        source=['compressor.wkv.weight','compressor.norm.weight','indexer.wq_b.weight','indexer.weights_proj.weight','indexer.wk.weight','indexer.k_norm.weight']
+        for layer in (20,21):
+            for name in common+(source if layer==20 else []):
+                key=f'layers.{layer}.attn.{name}';path=(model/mapping[key]).resolve();path.relative_to(model)
+                axis=0 if name in ('wq_b.weight','wo_a.weight','attn_sink','indexer.wq_b.weight','indexer.weights_proj.weight') else 1 if name=='wo_b.weight' else None
+                with safe_open(path,framework='pt',device='cpu') as f:
+                    view=f.get_slice(key);shape=view.get_shape();sl=[slice(None)]*len(shape)
+                    if axis is not None:
+                        if shape[axis]%self.tp:raise ValueError('indivisible '+key)
+                        width=shape[axis]//self.tp;sl[axis]=slice(self.rank*width,(self.rank+1)*width)
+                    w=view[tuple(sl)].float()
+                if not bool(torch.isfinite(w).all()):raise ValueError('nonfinite '+key)
+                p=nn.Parameter(w.to(device));p.tensor_model_parallel=axis is not None
+                p.partition_dim=axis if axis is not None else -1;p.partition_stride=1
+                self.weights[self.key(layer,name)]=p
+                self.metadata[self.key(layer,name)]=dict(checkpoint=key,partition_dim=axis)
+        self.last={}
+
+    @staticmethod
+    def key(layer,name):return str(layer)+'__'+name.replace('.','__')
+    def w(self,layer,name):return self.weights[self.key(layer,name)]
+    def linear(self,x,w):
+        dtype=torch.bfloat16 if self.precision=='bfloat16' else torch.float32
+        return F.linear(x.to(dtype),w.to(dtype))
+    def norm(self,x,w):
+        return rms_norm(x, w, self.c['rms_norm_eps'])
+    def set_input_tensor(self,tensors):
+        if any(t is not None for t in (tensors if isinstance(tensors,list) else [tensors])):raise ValueError('PP unsupported')
+    def state_dict_for_save_checkpoint(self,*args,**kwargs):return self.state_dict(*args,**kwargs)
+
+    def forward(self,x,teacher):
+        c=self.c;b,s,_=x.shape;self.last={};cache=None
+        y=c['rope_scaling'];angles=rope_angles(torch.arange(s,device=x.device),c['qk_rope_head_dim'],base=c['compress_rope_theta'],original_seq_len=y['original_max_position_embeddings'],factor=y['factor'],beta_fast=y['beta_fast'],beta_slow=y['beta_slow'])
+        aux=x.float().sum()*0
+        for layer in (20,21):
+            w=lambda n:self.w(layer,n)
+            # Copy boundaries are FP32, so head gradient contributions sum before BF16 rounding.
+            qr=Copy.apply(self.norm(self.linear(x,w('wq_a.weight')),w('q_norm.weight')).float(),self.group)
+            local=rotary_tail(self.norm(self.linear(x,w('wkv.weight')),w('kv_norm.weight')),angles).unsqueeze(2)
+            if layer==20:
+                latent=self.norm(self.linear(x,w('compressor.wkv.weight')),w('compressor.norm.weight'))
+                global_kv=rotary_tail(latent,angles).unsqueeze(2).float()
+                ik=rotary_tail(self.norm(self.linear(latent,w('indexer.wk.weight')),w('indexer.k_norm.weight')),angles).float()
+                ih=c['index_n_heads']//self.tp;dim=c['index_head_dim']
+                iq=rotary_tail(self.linear(qr,w('indexer.wq_b.weight')).reshape(b,s,ih,dim),angles)
+                iw=self.linear(Copy.apply(x.float(),self.group),w('indexer.weights_proj.weight')).float()*(dim*c['index_n_heads'])**-.5
+                scores=Sum.apply((torch.einsum('bshd,bcd->bshc',iq.float(),Copy.apply(ik,self.group)).relu()*iw.unsqueeze(-1)).sum(2),self.group)
+                indices=F.pad(select_indices(scores,1,3),(0,512-min(3,s)),value=-1).long()
+                aux=masked_teacher_kl(scores,teacher,causal_mask(scores,1),coefficient=.1)
+                cache=(global_kv,indices)
+                self.last['source_kv']=global_kv;self.last['source_indices']=indices
+                if global_kv.requires_grad:global_kv.retain_grad()
+            else:
+                global_kv,indices=cache
+                self.last['same_kv_object']=global_kv is self.last['source_kv']
+                self.last['same_indices_object']=indices is self.last['source_indices']
+            dtype=torch.bfloat16 if self.precision=='bfloat16' else torch.float32
+            q=rotary_tail(self.linear(qr,w('wq_b.weight')).reshape(b,s,c['num_attention_heads']//self.tp,c['head_dim']),angles)
+            gkv=Copy.apply(global_kv,self.group).to(dtype)
+            if gkv.requires_grad:gkv.retain_grad()
+            self.last[f'{layer}_kv_edge']=gkv
+            out=self.operator(q,Copy.apply(local.float(),self.group).to(dtype),gkv,indices,w('attn_sink'),ratio=1,window=3)
+            groups=c['o_groups']//self.tp
+            a=rotary_tail(out,angles,inverse=True).reshape(b,s,groups,-1)
+            o=torch.einsum('bsgd,grd->bsgr',a,w('wo_a.weight').to(dtype).reshape(groups,c['o_lora_rank'],-1)).flatten(-2)
+            projected=self.linear(o,w('wo_b.weight')).float()
+            x=x.float()+Sum.apply(projected,self.group)
+        self.last['output_dtype']=str(x.dtype)
+        self.last['attention_dtype']=str(q.dtype)
+        self.last['scores_dtype']=str(scores.dtype)
+        return x,aux
