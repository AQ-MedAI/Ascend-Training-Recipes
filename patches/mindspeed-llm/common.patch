@@ -0,0 +1,178 @@
+"""Plan-driven, unquantized single-rank training prototype.
+
+Framework-owned module, not registered as a Megatron ModuleSpec/production model.
+Supports dense FFN or unquantized single-rank MoE; no Engram/vision/MTP converter.
+FP32/FP64 baseline and explicit BF16 projections with FP32 master parameters.
+All cross-layer state is local to the current forward.
+Auxiliary teacher choice must be explicit and is not a claimed V4.1 contract.
+"""
+from dataclasses import dataclass
+import math
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+from .architecture import AttentionMode, build_layer_plan
+from .attention_geometry import AttentionGeometry, Norm, rope_angles, rotary_tail
+from .compressor import TrainingCompressor
+from .indexer import TrainingIndexer, causal_mask, candidate_pool, select_indices, selected_global_teacher, masked_teacher_kl
+from .moe import SingleRankMoE
+from .mhc import SinglePassMHC, initial_pre, collapse
+
+
+def projected_linear(module, value, dtype):
+    """Differentiable casts retain FP32 master weights and their gradients."""
+    if dtype is None:
+        return module(value)
+    return F.linear(value.to(dtype), module.weight.to(dtype))
+
+
+@dataclass(frozen=True)
+class AttentionState:
+    kv_source: int
+    index_source: int
+    ratio: int
+    candidate_source: int | None
+    global_kv: torch.Tensor
+    index_keys: torch.Tensor
+    indices: torch.Tensor
+    pool: torch.Tensor | None
+
+
+class PlannedAttention(nn.Module):
+    def __init__(self, config, plan, teacher, coefficient, precision="float32"):
+        super().__init__()
+        self.plan, self.teacher, self.coefficient = plan, teacher, coefficient
+        self.compute_dtype = torch.bfloat16 if precision == "bfloat16" else None
+        c = config
+        self.window, self.topk = c["window_size"], c["index_topk"]
+        self.block_size, self.top_blocks = c["candidate_block_size"], c["candidate_topk_blocks"]
+        self.rope = dict(base=c["compress_rope_theta"] if plan.ratio else c["rope_theta"],
+                         original_seq_len=c["original_seq_len"] if plan.ratio else 0,
+                         factor=c["rope_factor"], beta_fast=c["beta_fast"], beta_slow=c["beta_slow"])
+        self.geometry = AttentionGeometry(c["dim"], c["n_heads"], c["head_dim"], c["q_lora_rank"],
+            c["o_groups"], c["o_lora_rank"], c["rope_head_dim"], eps=c["norm_eps"])
+        if plan.owns_kv:
+            self.compressor = TrainingCompressor(c["dim"], c["head_dim"], plan.ratio, eps=c["norm_eps"])
+        if plan.owns_indexer:
+            self.indexer = TrainingIndexer(c["dim"], c["q_lora_rank"], c["head_dim"],
+                c["index_n_heads"], c["index_head_dim"], c["rope_head_dim"], owns_k=plan.owns_kv,
+                norm_eps=c["norm_eps"], rope_options=self.rope)
+
+    def forward(self, x, state, operator):
+        p, g = self.plan, self.geometry
+        b, s = x.shape[:2]
+        angles = rope_angles(torch.arange(s, device=x.device), g.rope_dim, **self.rope)
+        qr = g.q_norm(projected_linear(g.wq_a, x, self.compute_dtype))
+        q = rotary_tail(projected_linear(g.wq_b, qr, self.compute_dtype).unflatten(-1, (g.heads, g.head_dim)), angles)
+        local = rotary_tail(g.kv_norm(projected_linear(g.wkv, x, self.compute_dtype)), angles).unsqueeze(2)
+        aux = x.new_zeros(())
+        if p.mode == AttentionMode.SWA:
+            global_kv = q.new_empty(b, 0, 1, g.head_dim)
+            indices = torch.empty((b, s, 0), dtype=torch.int32, device=x.device)
+        else:
+            if p.owns_kv:
+                latent = self.compressor(x)
+                keys = self.indexer.make_keys(latent, p.ratio)
+                global_angles = rope_angles(torch.arange(latent.shape[1], device=x.device)*p.ratio,
+                                            g.rope_dim, **self.rope)
+                global_kv = rotary_tail(latent.to(q.dtype), global_angles).unsqueeze(2)
+                pool = None
+            else:
+                if state is None or state.kv_source != p.kv_source or state.ratio != p.ratio:
+                    raise ValueError(f"layer {p.layer_id}: missing/mismatched KV source")
+                if state.candidate_source != p.candidate_source:
+                    raise ValueError(f"layer {p.layer_id}: candidate source mismatch")
+                global_kv, keys, pool = state.global_kv, state.index_keys, state.pool
+            if p.owns_indexer:
+                scores = self.indexer(x, qr.to(x.dtype), keys)
+                if p.candidate_source == p.layer_id:
+                    pool = candidate_pool(scores, p.ratio, self.top_blocks, self.block_size)
+                indices = select_indices(scores, p.ratio, self.topk, pool)
+                state = AttentionState(p.kv_source, p.layer_id, p.ratio, p.candidate_source,
+                                       global_kv, keys, indices, pool)
+                if self.teacher == "selected-global" and self.coefficient:
+                    target = selected_global_teacher(q, global_kv, indices, ratio=p.ratio)
+                    valid = causal_mask(scores, p.ratio) if pool is None else pool
+                    aux = masked_teacher_kl(scores, target, valid, coefficient=self.coefficient)
+            else:
+                if state.index_source != p.index_source:
+                    raise ValueError(f"layer {p.layer_id}: index source mismatch")
+                indices = state.indices
+        output = operator(q, local, global_kv, indices, g.attn_sink, ratio=p.ratio or 1, window=self.window)
+        projected = g.project_output(rotary_tail(output, angles, inverse=True), compute_dtype=self.compute_dtype)
+        return projected.to(x.dtype), state, aux
+
+
+class PlannedBlock(nn.Module):
+    def __init__(self, config, plan, teacher, coefficient, precision="float32"):
+        super().__init__()
+        dim, eps = config["dim"], config["norm_eps"]
+        self.attention = PlannedAttention(config, plan, teacher, coefficient, precision)
+        self.compute_dtype = self.attention.compute_dtype
+        self.attn_norm, self.ffn_norm = Norm(dim, eps), Norm(dim, eps)
+        options = dict(streams=config["hc_mult"], iters=config["hc_sinkhorn_iters"],
+                       norm_eps=eps, eps=config["hc_eps"])
+        self.attn_mhc, self.ffn_mhc = SinglePassMHC(dim, **options), SinglePassMHC(dim, **options)
+        self.ffn_kind = config.get("ffn_kind", "dense")
+        if self.ffn_kind == "moe":
+            self.moe = SingleRankMoE(config, precision=precision)
+        elif self.ffn_kind == "dense":
+            inter = config["reference_ffn_dim"]
+            self.up, self.down = nn.Linear(dim, 2*inter, bias=False), nn.Linear(inter, dim, bias=False)
+        else:
+            raise ValueError("ffn_kind must be dense or moe")
+
+    def forward(self, x, pre, state, operator):
+        auxiliary = x.new_zeros(())
+        def attention(value):
+            nonlocal state, auxiliary
+            output, state, auxiliary = self.attention(self.attn_norm(value), state, operator)
+            return output
+        def ffn(value):
+            if self.ffn_kind == "moe":
+                return self.moe(self.ffn_norm(value))
+            gate, up = projected_linear(self.up, self.ffn_norm(value), self.compute_dtype).chunk(2, -1)
+            return projected_linear(self.down, F.silu(gate)*up, self.compute_dtype).to(value.dtype)
+        x, pre = self.attn_mhc(x, pre, attention)
+        x, pre = self.ffn_mhc(x, pre, ffn)
+        return x, pre, state, auxiliary
+
+
+class ReferenceBackbone(nn.Module):
+    def __init__(self, config, *, teacher, coefficient, precision="float32"):
+        super().__init__()
+        if teacher not in ("none", "selected-global") or not math.isfinite(coefficient) or coefficient < 0:
+            raise ValueError("explicit valid teacher and nonnegative coefficient required")
+        if teacher == "none" and coefficient != 0:
+            raise ValueError("teacher=none requires coefficient=0")
+        if config["rope_head_dim"] > config["index_head_dim"]:
+            raise ValueError("Indexer rope dimension exceeds head dimension")
+        if precision not in ("float32", "bfloat16"):
+            raise ValueError("precision must be float32 or bfloat16")
+        self.precision = precision
+        self.plans = build_layer_plan(config)
+        self.streams = config["hc_mult"]
+        self.layers = nn.ModuleList([PlannedBlock(config, p, teacher, coefficient, precision) for p in self.plans])
+        self.norm = Norm(config["dim"], config["norm_eps"])
+
+    def forward(self, hidden, operator, *, return_trace=False):
+        # Enclosing autocast must not silently lower mHC/Indexer/Compressor math.
+        if self.precision == "bfloat16" and (hidden.dtype != torch.float32 or
+                any(p.dtype != torch.float32 for p in self.parameters())):
+            raise ValueError("BF16 mixed policy requires FP32 hidden and master parameters")
+        with torch.autocast(device_type=hidden.device.type, enabled=False):
+            return self._forward(hidden, operator, return_trace=return_trace)
+
+    def _forward(self, hidden, operator, *, return_trace=False):
+        if hidden.dtype not in (torch.float32, torch.float64):
+            raise ValueError("backbone hidden must be FP32 (or FP64 for baseline gradcheck)")
+        x = hidden.unsqueeze(2).expand(-1, -1, self.streams, -1)
+        pre, state, aux, trace = initial_pre(x), None, x.new_zeros(()), []
+        for block in self.layers:
+            x, pre, state, loss = block(x, pre, state, operator)
+            aux = aux + loss
+            if return_trace:
+                trace.append(state)
+        output = self.norm(collapse(x, pre))
+        return (output, aux, trace) if return_trace else (output, aux)
