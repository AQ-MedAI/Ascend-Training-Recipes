@@ -0,0 +1,54 @@
+"""CP local-query projections/attention; global KV gather, ratio1 source20/21."""
+import torch
+from torch.nn import functional as F
+from .context_expert_parallel import TPCPFullPair,Gather
+from .tensor_parallel_attention import Copy,Sum
+from .attention_geometry import rope_angles,rotary_tail
+from .indexer import ranked_indices,masked_teacher_kl
+
+
+class LocalQueryPair(TPCPFullPair):
+    def attention(self,x,teacher,layer,cache):
+        c=self.c;b,s,_=x.shape
+        if b!=1:raise ValueError('batch1 required')
+        start=self.cp_rank*s;total=s*self.cp;y=c['rope_scaling']
+        positions=torch.arange(start,start+s,device=x.device)
+        angles=rope_angles(positions,c['qk_rope_head_dim'],base=c['compress_rope_theta'],original_seq_len=y['original_max_position_embeddings'],factor=y['factor'],beta_fast=y['beta_fast'],beta_slow=y['beta_slow'])
+        w=lambda n:self.w(layer,n)
+        qr=Copy.apply(self.norm(self.linear(x,w('wq_a.weight')),w('q_norm.weight')).float(),self.group)
+        local=rotary_tail(self.norm(self.linear(x,w('wkv.weight')),w('kv_norm.weight')),angles).float()
+        local=Gather.apply(local.squeeze(0),self.cp_group,True).unsqueeze(0).unsqueeze(2)
+        aux=x.sum()*0
+        if layer==20:
+            latent=self.norm(self.linear(x,w('compressor.wkv.weight')),w('compressor.norm.weight'))
+            kv=rotary_tail(latent,angles).float()
+            global_kv=Gather.apply(kv.squeeze(0),self.cp_group,True).unsqueeze(0).unsqueeze(2)
+            ik=rotary_tail(self.norm(self.linear(latent,w('indexer.wk.weight')),w('indexer.k_norm.weight')),angles).float()
+            ik=Gather.apply(ik.squeeze(0),self.cp_group,True).unsqueeze(0)
+            ih=c['index_n_heads']//self.tp;dim=c['index_head_dim']
+            iq=rotary_tail(self.linear(qr,w('indexer.wq_b.weight')).reshape(b,s,ih,dim),angles)
+            iw=self.linear(Copy.apply(x.float(),self.group),w('indexer.weights_proj.weight')).float()*(dim*c['index_n_heads'])**-.5
+            scores=Sum.apply((torch.einsum('bshd,bcd->bshc',iq.float(),Copy.apply(ik,self.group)).relu()*iw.unsqueeze(-1)).sum(2),self.group)
+            valid=(torch.arange(total,device=x.device)[None,None,:]<=positions[None,:,None]).expand_as(scores)
+            values,indices=ranked_indices(scores.masked_fill(~valid,-torch.inf),min(3,total))
+            indices=torch.where(torch.isfinite(values),indices,-1)
+            indices=F.pad(indices,(0,512-indices.shape[-1]),value=-1).long()
+            aux=masked_teacher_kl(scores,teacher,valid,coefficient=.1)/self.cp
+            cache=(global_kv,indices)
+            self.last['source_kv']=global_kv;self.last['source_indices']=indices
+            if global_kv.requires_grad:global_kv.retain_grad()
+        else:
+            global_kv,indices=cache
+            self.last['same_kv_object']=global_kv is self.last['source_kv']
+            self.last['same_indices_object']=indices is self.last['source_indices']
+        q=rotary_tail(self.linear(qr,w('wq_b.weight')).reshape(b,s,c['num_attention_heads']//self.tp,c['head_dim']),angles)
+        gkv=Copy.apply(global_kv,self.group).bfloat16()
+        if gkv.requires_grad:gkv.retain_grad()
+        self.last[f'{layer}_kv_edge']=gkv
+        out=self.operator(q,Copy.apply(local,self.group).bfloat16(),gkv,indices,w('attn_sink'),ratio=1,window=3,query_start=start)
+        groups=c['o_groups']//self.tp
+        a=rotary_tail(out,angles,inverse=True).reshape(b,s,groups,-1)
+        o=torch.einsum('bsgd,grd->bsgr',a,w('wo_a.weight').bfloat16().reshape(groups,c['o_lora_rank'],-1)).flatten(-2)
+        out=Sum.apply(self.linear(o,w('wo_b.weight')).float(),self.group)
+        self.last.update(output_dtype=str(out.dtype),attention_dtype=str(q.dtype),scores_dtype='torch.float32',cp_local_range=[start,start+s],cp_global_length=total,computed_query_rows=s)
+        return out,aux,cache
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/megatron_runtime.py b/mindspeed_llm/tasks/models/transformer/deepseek41/megatron_runtime.py
