+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/indexer.py
@@ -0,0 +1,156 @@
+"""Unquantized single-rank Indexer reference with differentiable shared keys.
+
+Hard top-k/candidate masks are discrete. KL below is an explicit test objective,
+not an asserted reproduction of CANN's fused KL contract or production teacher.
+"""
+import math
+from .candidate_mask import expand_candidate_mask
+import torch
+from torch import nn
+from torch.nn import functional as F
+from .attention_geometry import Norm, rope_angles, rotary_tail
+
+
+def causal_mask(scores, ratio):
+    if ratio not in (1, 2):
+        raise ValueError("ratio must be 1/2")
+    s, c = scores.shape[-2:]
+    return ((torch.arange(c, device=scores.device)+1)*ratio <=
+            torch.arange(1, s+1, device=scores.device)[:, None]).expand_as(scores)
+
+
+def ranked_indices(scores, count):
+    """Exact ties prefer lower original position; do not perturb scores.
+
+    Stable full sort is a correctness baseline, not a fast production top-k.
+    Near-equal but unequal scores remain ordered by score, not a tolerance.
+    """
+    indices = torch.argsort(scores, dim=-1, descending=True, stable=True)[..., :count]
+    return scores.gather(-1, indices), indices
+
+
+def candidate_pool(scores, ratio, top_blocks, block_size):
+    """Block max selection with the latest reachable block pinned in."""
+    if min(top_blocks, block_size) < 1:
+        raise ValueError("candidate block counts/sizes must be positive")
+    valid = causal_mask(scores, ratio)
+    c = scores.shape[-1]
+    if c == 0:
+        return valid
+    masked = scores.masked_fill(~valid, -torch.inf)
+    blocks = F.pad(masked, (0, -c % block_size), value=-torch.inf).unflatten(-1, (-1, block_size)).amax(-1)
+    visible = torch.arange(1, scores.shape[-2]+1, device=scores.device)//ratio
+    latest = (visible-1)//block_size
+    blocks = blocks.masked_fill(torch.arange(blocks.shape[-1], device=scores.device) == latest[:, None], torch.inf)
+    values, indices = ranked_indices(blocks, min(top_blocks, blocks.shape[-1]))
+    keep = torch.zeros_like(blocks, dtype=torch.bool).scatter(-1, indices, values > -torch.inf)
+    return expand_candidate_mask(keep, block_size, valid)
+
+
+def select_indices(scores, ratio, topk, candidates=None):
+    """Score-ranked indices, with -1 padding after finite selected entries."""
+    if topk < 0:
+        raise ValueError("topk must be nonnegative")
+    valid = causal_mask(scores, ratio)
+    if candidates is not None:
+        if candidates.shape != scores.shape or candidates.dtype != torch.bool:
+            raise ValueError("candidates must be bool with the score shape")
+        valid = valid & candidates
+    values, indices = ranked_indices(scores.masked_fill(~valid, -torch.inf), min(topk, scores.shape[-1]))
+    # Unlike checking only the causal bound, this excludes pool-masked choices.
+    return torch.where(torch.isfinite(values), indices, -1).to(torch.int32)
+
+
+class TrainingIndexer(nn.Module):
+    def __init__(self, dim, q_rank, latent_dim, heads, head_dim, rope_dim, *, owns_k,
+                 norm_eps=1e-20, rope_options=None, precision_policy="native"):
+        super().__init__()
+        if precision_policy not in ("native", "bf16_projection_fp32_score"):
+            raise ValueError("Unsupported Indexer precision policy")
+        self.precision_policy = precision_policy
+        self.heads, self.head_dim, self.rope_dim = heads, head_dim, rope_dim
+        self.rope_options = {} if rope_options is None else dict(rope_options)
+        self.wq_b = nn.Linear(q_rank, heads*head_dim, bias=False)
+        self.weights_proj = nn.Linear(dim, heads, bias=False)
+        if owns_k:
+            self.wk = nn.Linear(latent_dim, head_dim, bias=False)
+            self.k_norm = Norm(head_dim, norm_eps)
+
+    def make_keys(self, pre_rope_latent, ratio):
+        if not hasattr(self, "wk"):
+            raise ValueError("only KV source indexer owns key parameters")
+        if self.precision_policy == "bf16_projection_fp32_score":
+            with torch.autocast(device_type=pre_rope_latent.device.type, enabled=False):
+                projected = F.linear(pre_rope_latent.bfloat16(), self.wk.weight.bfloat16())
+                positions = torch.arange(pre_rope_latent.shape[1], device=pre_rope_latent.device)*ratio
+                return rotary_tail(self.k_norm(projected), rope_angles(positions, self.rope_dim, **self.rope_options))
+        positions = torch.arange(pre_rope_latent.shape[1], device=pre_rope_latent.device)*ratio
+        return rotary_tail(self.k_norm(self.wk(pre_rope_latent)), rope_angles(positions, self.rope_dim, **self.rope_options))
+
+    def forward(self, hidden, q_latent, shared_keys):
+        if self.precision_policy == "bf16_projection_fp32_score":
+            # Casts remain in autograd; master parameters and shared-key gradients stay connected.
+            # No INT8, FP16 QLI intermediate rounding, or straight-through estimator here.
+            with torch.autocast(device_type=hidden.device.type, enabled=False):
+                positions = torch.arange(hidden.shape[1], device=hidden.device)
+                q = F.linear(q_latent.bfloat16(), self.wq_b.weight.bfloat16()).unflatten(-1, (self.heads, self.head_dim))
+                q = rotary_tail(q, rope_angles(positions, self.rope_dim, **self.rope_options))
+                weights = F.linear(hidden.bfloat16(), self.weights_proj.weight.bfloat16()).float()
+                weights = weights * (self.head_dim**-0.5 * self.heads**-0.5)
+                return (torch.einsum("bshd,bcd->bshc", q.float(), shared_keys.float()).relu()*weights.unsqueeze(-1)).sum(2)
+        positions = torch.arange(hidden.shape[1], device=hidden.device)
+        q = rotary_tail(self.wq_b(q_latent).unflatten(-1, (self.heads, self.head_dim)),
+                        rope_angles(positions, self.rope_dim, **self.rope_options))
+        weights = self.weights_proj(hidden) * (self.head_dim*self.heads)**-0.5
+        return (torch.einsum("bshd,bcd->bshc", q, shared_keys).relu() * weights.unsqueeze(-1)).sum(2)
+
+
+def masked_teacher_kl(scores, teacher_mass, valid, *, coefficient):
+    """KL(detached normalized teacher || softmax(scores)) / ALL B*S queries.
+
+    Rows with no valid teacher mass contribute zero. Teacher mass is explicitly
+    supplied by the caller; the production attention-to-teacher mapping is pending.
+    coefficient scales both value and gradients, including coefficient=0.
+    """
+    if scores.shape != teacher_mass.shape or valid.shape != scores.shape or valid.dtype != torch.bool:
+        raise ValueError("teacher/mask shapes must match scores")
+    if not math.isfinite(coefficient) or coefficient < 0 or not bool(torch.isfinite(teacher_mass).all()) or bool((teacher_mass < 0).any()):
+        raise ValueError("nonnegative coefficient and finite nonnegative teacher required")
+    if scores.shape[-1] == 0:
+        return scores.sum()*0
+    teacher = teacher_mass.detach().masked_fill(~valid, 0)
+    mass = teacher.sum(-1, keepdim=True)
+    active = mass > 0
+    target = teacher / mass.clamp_min(torch.finfo(scores.dtype).tiny)
+    logits = scores.masked_fill(~valid, -torch.inf)
+    logits = torch.where(active, logits, torch.zeros_like(logits))
+    log_prob = F.log_softmax(logits, -1).masked_fill(~valid, 0)
+    log_target = target.clamp_min(torch.finfo(scores.dtype).tiny).log()
+    return (target*(log_target-log_prob)).sum(-1).mean()*coefficient
+
+
+@torch.no_grad()
+def selected_global_teacher(query, global_kv, indices, *, ratio):
+    """Detached mean of per-head softmax over selected causal global KV.
+
+    Inspired by the existing FSDP2 eager objective, not joint SWA/global/sink
+    probabilities or a verified CANN target. Padding/empty rows contribute zero.
+    Returns dense [B,S,C] for the small-model reference only.
+    """
+    b, s, h, d = query.shape
+    c = global_kv.shape[1]
+    if global_kv.shape != (b, c, 1, d) or indices.shape[:2] != (b, s):
+        raise ValueError("teacher input shapes disagree")
+    if bool(((indices < -1) | (indices >= c)).any()):
+        raise ValueError("teacher indices out of bounds")
+    work = torch.float64 if query.dtype == torch.float64 else torch.float32
+    if c == 0:
+        return query.new_zeros((b, s, 0), dtype=work)
+    selected = torch.zeros((b, s, c), device=query.device, dtype=torch.int32)
+    selected.scatter_add_(-1, indices.long().clamp_min(0), (indices >= 0).int())
+    valid = (selected > 0) & causal_mask(selected, ratio)
+    scores = torch.einsum("bshd,bcd->bshc", query.to(work), global_kv.squeeze(2).to(work)) * d**-0.5
+    active = valid.any(-1, keepdim=True)
+    scores = scores.masked_fill(~valid[:, :, None, :], -torch.inf)
+    scores = torch.where(active[:, :, None, :], scores, torch.zeros_like(scores))
+    return scores.softmax(-1).mean(2).masked_fill(~valid, 0)
