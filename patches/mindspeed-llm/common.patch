@@ -0,0 +1,95 @@
+"""Differentiable Single-Pass mHC oracle for complete-sequence training.
+
+Matches inference/model.py and kernel.py equations, without TileLang/NPU.
+FP16/BF16 accumulate in FP32; doubles are preserved for finite differences.
+NPU post expansion reuses the V4 fused operator; CPU remains the oracle.
+"""
+import os
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+def work_dtype(x):
+    return torch.float64 if x.dtype == torch.float64 else torch.float32
+
+
+def initial_pre(x):
+    """Select the first residual stream at the model entrance."""
+    return F.one_hot(torch.zeros(x.shape[:-2], device=x.device, dtype=torch.long),
+                     x.shape[-2]).to(work_dtype(x))
+
+
+def collapse(x, pre):
+    if pre.shape != x.shape[:-1]:
+        raise ValueError("pre must have shape [..., streams]")
+    return (x.to(work_dtype(x)) * pre.unsqueeze(-1)).sum(-2).to(x.dtype)
+
+
+def native_expand(output, residual, post, comb):
+    """Adapt V4.1 BSND to the existing V4 SBND training wrapper."""
+    from mindspeed_llm.ops.npu_mhc import mhc_post_ascend
+    return mhc_post_ascend(
+        output.transpose(0, 1), residual.transpose(0, 1),
+        post.transpose(0, 1), comb.transpose(0, 1),
+    ).transpose(0, 1).contiguous().to(output.dtype)
+
+
+def expand(output, residual, post, comb):
+    """comb[..., input_stream, output_stream]; do not transpose this contract."""
+    if residual.device.type == 'npu':
+        return native_expand(output, residual, post, comb)
+    dtype = work_dtype(residual)
+    mixed = torch.einsum("...ij,...id->...jd", comb.to(dtype), residual.to(dtype))
+    return (mixed + post.to(dtype).unsqueeze(-1) * output.to(dtype).unsqueeze(-2)).to(output.dtype)
+
+
+def coefficients(x, weight, scale, base, *, norm_eps=1e-6, eps=1e-6, iters=20):
+    if iters < 1 or eps <= 0 or norm_eps <= 0:
+        raise ValueError("positive eps and at least one Sinkhorn iteration required")
+    streams = x.shape[-2]
+    flat = x.flatten(-2).to(work_dtype(x))
+    mixes = F.linear(flat, weight.to(flat.dtype)) * torch.rsqrt(flat.square().mean(-1, keepdim=True) + norm_eps)
+    pre = torch.sigmoid(mixes[..., :streams] * scale[0] + base[:streams]) + eps
+    post = 2 * torch.sigmoid(mixes[..., streams:2*streams] * scale[1] + base[streams:2*streams])
+    logits = (mixes[..., 2*streams:] * scale[2] + base[2*streams:]).unflatten(-1, (streams, streams))
+    comb = logits.softmax(-1) + eps
+    comb = comb / (comb.sum(-2, keepdim=True) + eps)
+    for _ in range(iters - 1):
+        comb = comb / (comb.sum(-1, keepdim=True) + eps)
+        comb = comb / (comb.sum(-2, keepdim=True) + eps)
+    return pre, post, comb
+
+
+class SinglePassMHC(nn.Module):
+    """One sublayer boundary; return (residual, pre_for_next_sublayer).
+
+    The callable includes the sublayer's norm and attention/FFN. Incoming pre
+    must remain in the autograd graph, including across Transformer blocks.
+    Initialization below is for tests, not a checkpoint initialization policy.
+    """
+    def __init__(self, dim, streams=4, *, iters=20, norm_eps=1e-6, eps=1e-6):
+        super().__init__()
+        if dim <= 0 or streams <= 0 or iters < 1:
+            raise ValueError("dim, streams and iters must be positive")
+        self.iters = iters
+        self.norm_eps, self.eps = norm_eps, eps
+        self.hc_fn = nn.Linear(streams * dim, (2 + streams) * streams, bias=False)
+        self.hc_scale = nn.Parameter(torch.full((3,), 0.01))
+        self.hc_base = nn.Parameter(torch.zeros((2 + streams) * streams))
+
+    def forward(self, x, incoming_pre, sublayer):
+        backend = os.environ.get('V41_MHC_PRE_BACKEND', 'reference')
+        if backend not in ('reference', 'premix'):
+            raise ValueError('V41_MHC_PRE_BACKEND must be reference or premix')
+        if backend == 'premix':
+            from .native_mhc import premix
+            hin, post, comb, next_pre = premix(
+                x, self.hc_fn.weight, self.hc_scale, self.hc_base, incoming_pre,
+                iters=self.iters, eps=self.eps, norm_eps=self.norm_eps)
+            return expand(sublayer(hin), x, post, comb), next_pre
+        next_pre, post, comb = coefficients(x, self.hc_fn.weight, self.hc_scale,
+                                            self.hc_base, iters=self.iters,
+                                            norm_eps=self.norm_eps, eps=self.eps)
+        output = sublayer(collapse(x, incoming_pre))
+        return expand(output, x, post, comb), next_pre
