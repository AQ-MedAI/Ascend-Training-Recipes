@@ -0,0 +1,87 @@
+"""Opt-in provider/callback for Megatron no-pipeline scheduling, DP=1/2, TP=PP=CP=EP=1.
+
+Not registered in the legacy pretrain/verl entrypoints. No distributed
+optimizer, activation recomputation, packing or sharded checkpoint support.
+"""
+import torch
+from .language_model import SingleRankLanguageModel, effective_loss_mask, loss_sums
+
+
+def validate_schedule(config):
+    for name in ('tensor_model_parallel_size','pipeline_model_parallel_size','context_parallel_size'):
+        if getattr(config,name,1)!=1:raise ValueError('only TP=PP=CP=1 supported')
+    ep=getattr(config,'expert_model_parallel_size',1)
+    if ep not in (1,2) or (ep==2 and getattr(config,'dsv41_data_parallel_size',1)!=2):raise ValueError('EP=2 requires world/data group size 2')
+    for name in ('enable_autocast','calculate_per_token_loss','sequence_parallel','deallocate_pipeline_outputs','bf16','fp16'):
+        if getattr(config,name,False):raise ValueError(name+' must be disabled; precision/scaling is explicit')
+    for name in ('finalize_model_grads_func','grad_scale_func','recompute_granularity','virtual_pipeline_model_parallel_size'):
+        if getattr(config,name,None) is not None:raise ValueError(name+' is unsupported by single-rank entry')
+    if getattr(config,'params_dtype',torch.float32)!=torch.float32:raise ValueError('FP32 master parameters required')
+    dp=getattr(config,'dsv41_data_parallel_size',1)
+    if dp not in (1,2):raise ValueError('only DP=1 or explicit DP=2 supported')
+    if torch.distributed.is_initialized() and torch.distributed.get_world_size()!=dp:
+        raise ValueError('world_size must match configured data parallel size')
+
+
+class ScheduleModel(SingleRankLanguageModel):
+    def __init__(self,logical_config,*,schedule_config,model_type,**kwargs):
+        validate_schedule(schedule_config)
+        if schedule_config.num_layers!=logical_config['n_layers'] or schedule_config.hidden_size!=logical_config['dim']:
+            raise ValueError('logical/scheduler model dimensions differ')
+        super().__init__(logical_config,data_parallel_size=getattr(schedule_config,'dsv41_data_parallel_size',1),**kwargs)
+        if getattr(schedule_config,'expert_model_parallel_size',1)==2:
+            from .expert_parallel import partition_experts
+            partition_experts(self,schedule_config)
+        self.config=schedule_config
+        self.model_type=model_type
+        self.pre_process=self.post_process=True
+
+    def set_input_tensor(self,input_tensor):
+        tensors=input_tensor if isinstance(input_tensor,list) else [input_tensor]
+        if any(t is not None for t in tensors):raise ValueError('pipeline input tensors unsupported')
+
+    def state_dict_for_save_checkpoint(self,prefix='',keep_vars=False):
+        return self.state_dict(prefix=prefix,keep_vars=keep_vars)
+
+
+def make_model_provider(logical_config,**kwargs):
+    def model_provider(pre_process=True,post_process=True,**options):
+        if not pre_process or not post_process or options:
+            raise ValueError('only complete single-stage model construction supported')
+        return ScheduleModel(logical_config,**kwargs)
+    return model_provider
+
+
+def prepare_step(batch,*,microbatch_size=1,normalization=None):
+    """Return microbatches and a callback using whole-group CE/query denominators.
+
+    The two-value loss callback cancels Megatron's 1/num_microbatches exactly
+    once. Do not use calculate_per_token_loss or a token-normalizing finalizer.
+    """
+    tokens,labels=batch['tokens'],batch['labels']
+    if tokens.ndim!=2 or tokens.shape!=labels.shape:raise ValueError('tokens/labels must match [B,S]')
+    if microbatch_size<1 or tokens.shape[0]%microbatch_size:raise ValueError('batch must divide into equal microbatches')
+    if any(k not in ('tokens','labels','loss_mask') for k in batch):raise ValueError('unsupported batch fields')
+    count=int(effective_loss_mask(labels,batch.get('loss_mask')).sum())
+    queries=tokens.numel()
+    dp=1
+    if normalization is not None:
+        total_tokens,total_queries,dp=normalization
+        if dp not in (1,2) or total_tokens<count or total_queries<queries:raise ValueError('invalid global normalizers')
+        count,queries=total_tokens,total_queries
+    pieces=[{k:v[i:i+microbatch_size] for k,v in batch.items()} for i in range(0,tokens.shape[0],microbatch_size)]
+    num_microbatches=len(pieces)
+    def forward_step(data_iterator,model):
+        validate_schedule(model.config)
+        if getattr(model.config,'dsv41_data_parallel_size',1)!=dp:raise ValueError('normalizer DP size mismatch')
+        piece=next(data_iterator)
+        output=model(piece['tokens'],labels=piece['labels'])
+        sums=loss_sums(output,piece.get('loss_mask'))
+        normalized=sums.normalized(total_valid_tokens=count,total_queries=queries)
+        # Fresh scalar avoids view/in-place reduction problems in schedules.forward_step.
+        tensor=normalized*num_microbatches*dp  # Cancel DDP gradient averaging as well.
+        def reduce_loss(value):
+            return value,{'objective_contribution':normalized.detach(),
+                          'valid_tokens':effective_loss_mask(piece['labels'],piece.get('loss_mask')).sum().detach()}
+        return tensor,reduce_loss
+    return pieces,forward_step
