+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/native_config.py
@@ -0,0 +1,121 @@
+"""V4.1 checkpoint/config contract shared by the native provider and mbridge."""
+import re
+
+from .architecture import build_layer_plan
+from .plan_parallel_backbone import resolve_window_size
+
+
+def text_config(config):
+    raw = config.to_dict() if hasattr(config, 'to_dict') else dict(config)
+    c = dict(raw.get('text_config') or raw)
+    # HF exposes rope_parameters; the shared attention implementation consumes
+    # the checkpoint's legacy rope_scaling name. Preserve values, not defaults.
+    rope = c.get('rope_scaling') or c.get('rope_parameters')
+    if rope is not None:
+        c['rope_scaling'] = dict(rope)
+        if 'rope_theta' not in c and 'rope_theta' in rope:
+            c['rope_theta'] = rope['rope_theta']
+    return c
+
+
+def resolve_indexer_loss_coefficient(options, fallback):
+    """An explicit training option overrides the checkpoint-derived coefficient."""
+    import math
+    value = options.get('indexer_loss_coeff', fallback)
+    if isinstance(value, bool):
+        raise ValueError('indexer_loss_coeff must be a finite nonnegative number')
+    try:
+        value = float(value)
+    except (TypeError, ValueError) as exc:
+        raise ValueError('indexer_loss_coeff must be a finite nonnegative number') from exc
+    if not math.isfinite(value) or value < 0:
+        raise ValueError('indexer_loss_coeff must be a finite nonnegative number')
+    return value
+
+
+def layer_plan(config):
+    c = text_config(config)
+    logical = dict(c)
+    for dst, src in [('n_layers', 'num_hidden_layers'), ('kv_source_layers', 'kv_source_layer_ids'),
+                     ('index_source_layers', 'index_source_layer_ids'),
+                     ('candidate_source_layer', 'candidate_source_layer_id')]:
+        if src in c:
+            logical[dst] = c[src]
+    return build_layer_plan(logical)
+
+
+def validate(config, *, tp, cp, pp, ep, etp):
+    c = text_config(config)
+    if pp != 1 or etp != 1:
+        raise ValueError('Native V4.1 currently requires PP=1 and ETP=1')
+    if min(tp, cp, ep) < 1 or c['n_routed_experts'] % ep:
+        raise ValueError('Invalid parallel sizes or indivisible experts')
+    for name in ('num_attention_heads', 'o_groups', 'index_n_heads', 'vocab_size'):
+        if c[name] % tp:
+            raise ValueError(f'{name} must be divisible by TP')
+    if c['num_attention_heads'] % c['o_groups']:
+        raise ValueError('Attention heads must form complete output groups')
+    if c.get('n_shared_experts', 1) != 1 or c.get('quantization_config'):
+        raise ValueError('Only unquantized weights with one shared expert are supported')
+    if c.get('tie_word_embeddings', False):
+        raise ValueError('Tied embedding/head is not supported')
+    if not 1 <= c['index_topk'] <= 512:
+        raise ValueError('Sparse kernel requires index_topk in [1, 512]')
+    resolve_window_size(c)
+    return layer_plan(c)
+
+
+def attention_shapes(c, plan):
+    """Logical shape and TP axis; replication is explicit, never shape-guessed."""
+    d, h, hd = c['hidden_size'], c['num_attention_heads'], c['head_dim']
+    qr, groups, rank = c['q_lora_rank'], c['o_groups'], c['o_lora_rank']
+    ih, dim = c['index_n_heads'], c['index_head_dim']
+    result = {
+        'wq_a.weight': ((qr, d), None), 'q_norm.weight': ((qr,), None),
+        'wq_b.weight': ((h * hd, qr), 0),
+        'wo_a.weight': ((groups * rank, h * hd // groups), 0),
+        'wo_b.weight': ((d, groups * rank), 1),
+        'wkv.weight': ((hd, d), None), 'kv_norm.weight': ((hd,), None),
+        'attn_sink': ((h,), 0),
+    }
+    if plan.owns_kv:
+        result.update({'compressor.wkv.weight': ((hd, d), None),
+                       'compressor.norm.weight': ((hd,), None),
+                       'indexer.wk.weight': ((dim, hd), None),
+                       'indexer.k_norm.weight': ((dim,), None)})
+        if plan.ratio == 2:
+            result['compressor.wgate.weight'] = ((hd, d), None)
+    if plan.owns_indexer:
+        result.update({'indexer.wq_b.weight': ((ih * dim, qr), 0),
+                       'indexer.weights_proj.weight': ((ih, d), 0)})
+    return result
+
+
+def checkpoint_names(name):
+    direct = {'embedding.word_embeddings.weight': 'embed.weight',
+              'final_layernorm.weight': 'norm.weight', 'output_layer.weight': 'head.weight'}
+    if name in direct:
+        return [direct[name]]
+    match = re.fullmatch(r'decoder.layers.(\d+)\.(.+)', name)
+    if not match:
+        raise ValueError(f'Unmapped native V4.1 parameter: {name}')
+    layer, suffix = match.groups()
+    prefix = f'layers.{layer}.'
+    if suffix.startswith('self_attention.'):
+        return [prefix + 'attn.' + suffix[len('self_attention.'):]]
+    if suffix in ('input_layernorm.weight', 'pre_mlp_layernorm.weight'):
+        return [prefix + ('attn_norm.weight' if suffix.startswith('input') else 'ffn_norm.weight')]
+    for kind, source in [('attn_mhc', 'attn'), ('mlp_mhc', 'ffn')]:
+        if suffix.startswith(kind + '.'):
+            tail = {'hc_fn.weight': 'fn', 'hc_base': 'base', 'hc_scale': 'scale'}[suffix[len(kind)+1:]]
+            return [prefix + f'hc_{source}_{tail}']
+    if suffix.startswith('engram.'):
+        return [prefix + suffix]
+    if suffix in ('mlp.router.weight', 'mlp.router.expert_bias'):
+        return [prefix + 'ffn.gate.' + ('weight' if suffix.endswith('weight') else 'bias')]
+    expert = re.fullmatch(r'mlp\.(experts.local_experts.\d+|shared_experts)\.linear_fc([12]).weight', suffix)
+    if expert:
+        owner, fc = expert.groups()
+        owner = owner.replace('experts.local_experts.', 'experts.')
+        return [prefix + f'ffn.{owner}.{w}.weight' for w in (('w1', 'w3') if fc == '1' else ('w2',))]
+    raise ValueError(f'Unmapped native V4.1 parameter: {name}')
