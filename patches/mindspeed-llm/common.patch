@@ -0,0 +1,89 @@
+"""Unquantized single-rank MoE for training bring-up.
+
+Matches local inference Gate/Expert equations. Correction bias is a checkpointed
+buffer used only for selection; no invented load-balancing update or auxiliary
+objective. No EP, token dropping, quantization, vision bias or MTP support.
+"""
+import math
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+def linear(module,x,dtype):
+    return F.linear(x if dtype is None else x.to(dtype),
+                    module.weight if dtype is None else module.weight.to(dtype))
+
+
+class Gate(nn.Module):
+    def __init__(self,dim,experts,topk,*,score_func,gate_temp,norm_topk_prob,route_scale):
+        super().__init__()
+        if not 1<=topk<=experts or dim<1:raise ValueError('invalid MoE dimensions/topk')
+        if score_func not in ('softmax','sigmoid','sqrtsoftplus'):raise ValueError('invalid score_func')
+        if not math.isfinite(gate_temp) or gate_temp<=0 or not math.isfinite(route_scale) or route_scale<=0:
+            raise ValueError('gate_temp and route_scale must be finite and positive')
+        self.weight=nn.Parameter(torch.empty(experts,dim));nn.init.normal_(self.weight,std=dim**-.5)
+        self.register_buffer('bias',torch.zeros(experts))
+        self.topk,self.score_func,self.gate_temp=topk,score_func,gate_temp
+        self.norm_topk_prob,self.route_scale=norm_topk_prob,route_scale
+
+    def forward(self,x):
+        dtype=torch.float64 if x.dtype==torch.float64 else torch.float32
+        scores=F.linear(x.to(dtype),self.weight.to(dtype))/self.gate_temp
+        if self.score_func=='softmax':scores=scores.softmax(-1)
+        elif self.score_func=='sigmoid':scores=scores.sigmoid()
+        else:scores=F.softplus(scores).sqrt()
+        # Deterministic lower-expert-id tie rule; inference topk leaves ties unspecified.
+        indices=torch.argsort(scores+self.bias,dim=-1,descending=True,stable=True)[...,:self.topk]
+        weights=scores.gather(-1,indices)
+        if self.norm_topk_prob and self.topk>1:weights=weights/(weights.sum(-1,keepdim=True)+1e-20)
+        return weights*self.route_scale,indices
+
+
+class Expert(nn.Module):
+    def __init__(self,dim,inter_dim,*,compute_dtype=None,swiglu_limit=0.):
+        super().__init__()
+        if min(dim,inter_dim)<1 or not math.isfinite(swiglu_limit) or swiglu_limit<0:
+            raise ValueError('invalid expert dimensions or clamp')
+        self.w1=nn.Linear(dim,inter_dim,bias=False)
+        self.w2=nn.Linear(inter_dim,dim,bias=False)
+        self.w3=nn.Linear(dim,inter_dim,bias=False)
+        self.compute_dtype,self.limit=compute_dtype,swiglu_limit
+
+    def forward(self,x,weights=None):
+        dtype=torch.float64 if x.dtype==torch.float64 else torch.float32
+        gate=linear(self.w1,x,self.compute_dtype).to(dtype)
+        up=linear(self.w3,x,self.compute_dtype).to(dtype)
+        if self.limit>0:
+            gate=gate.clamp(max=self.limit);up=up.clamp(-self.limit,self.limit)
+        hidden=F.silu(gate)*up
+        if weights is not None:hidden=hidden*weights
+        return linear(self.w2,hidden,self.compute_dtype)
+
+
+class SingleRankMoE(nn.Module):
+    def __init__(self,config,*,precision='float32'):
+        super().__init__()
+        if config['n_shared_experts']!=1:raise ValueError('one shared expert required')
+        if precision not in ('float32','bfloat16'):raise ValueError('unsupported MoE precision')
+        if config.get('expert_dtype') is not None:raise ValueError('quantized expert weights are unsupported')
+        self.dim=config['dim'];self.n_experts=config['n_routed_experts']
+        self.gate=Gate(self.dim,self.n_experts,config['n_activated_experts'],
+            **{k:config[k] for k in ('score_func','gate_temp','norm_topk_prob','route_scale')})
+        options=dict(compute_dtype=torch.bfloat16 if precision=='bfloat16' else None,
+                     swiglu_limit=config['swiglu_limit'])
+        self.experts=nn.ModuleList([Expert(self.dim,config['moe_inter_dim'],**options) for _ in range(self.n_experts)])
+        self.shared_experts=Expert(self.dim,config['moe_inter_dim'],**options)
+
+    def forward(self,x):
+        shape=x.shape
+        flat=x.reshape(-1,self.dim)
+        weights,indices=self.gate(flat)
+        output=torch.zeros_like(flat)
+        for i,expert in enumerate(self.experts):
+            tokens,slots=torch.where(indices==i)
+            if not tokens.numel():continue
+            contribution=expert(flat[tokens],weights[tokens,slots,None]).to(output.dtype)
+            output=output.index_add(0,tokens,contribution)
+        output=output+self.shared_experts(flat).to(output.dtype)
+        return output.reshape(shape)
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/native_config.py b/mindspeed_llm/tasks/models/transformer/deepseek41/native_config.py
new file mode 100644
index 0000000000000000000000000000000000000000..195ae83f6807fe0dcbae72fa3bfd1d31c8fd34fd
