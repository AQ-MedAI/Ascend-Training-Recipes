+++ b/mindspeed_llm/ops/triton/dsv41_native_sparse_mla.py
@@ -0,0 +1,165 @@
+"""Opt-in adapter to the rollout SparseFlashMla forward (A2/A3 BF16 PA).
+
+No vLLM engine is created. Metadata and pages are built per call, so no cached
+activation pointers survive offload/recompute. The caller owns autograd.
+"""
+import os
+from contextlib import contextmanager
+from contextvars import ContextVar
+from functools import lru_cache
+import torch
+from torch.nn import functional as F
+
+
+_METADATA_CACHE = ContextVar('v41_metadata_cache', default=None)
+
+@contextmanager
+def metadata_scope(cache):
+    token = _METADATA_CACHE.set(cache)
+    try:
+        yield
+    finally:
+        _METADATA_CACHE.reset(token)
+
+
+def page_kv(kv, page_size=64):
+    """BS1D -> independent per-batch pages and an INT32 logical block table."""
+    b, t, n, d = kv.shape
+    if n != 1 or t < 1:
+        raise ValueError('Native KV must be nonempty BS1D')
+    blocks = (t + page_size - 1) // page_size
+    # Pad each sequence separately; never let the next batch fill its last page.
+    pages = F.pad(kv, (0, 0, 0, 0, 0, blocks * page_size - t)).reshape(
+        b * blocks, page_size, 1, d).contiguous()
+    table = torch.arange(b * blocks, dtype=torch.int32, device=kv.device).reshape(b, blocks)
+    return pages, table
+
+
+def native_arguments(q, ori, cmp, indices, sink, ratio, window, scale, query_start):
+    b, s, h, d = q.shape
+    if q.dtype != torch.bfloat16 or d != 512 or window != 128:
+        raise ValueError('Native CSA2 requires BF16, D=512 and window=128')
+    if h < 1 or h > 128 or h & (h - 1):
+        raise ValueError('Native CSA2 heads must be a power of two in [1,128]')
+    if ratio not in (1, 2, 4):
+        raise ValueError('Native CSA2 requires ratio 1/2/4')
+    end = query_start + s
+    if query_start < 0 or end > ori.shape[1] or ori.shape[1] >= 2**31:
+        raise ValueError('Native query range/INT32 length invalid')
+    has_cmp = cmp.shape[1] > 0 and indices.shape[-1] > 0
+    k = indices.shape[-1]
+    if has_cmp and k > 1024:
+        raise ValueError('Native CSA2 supports at most 1024 indices')
+    topk = (512 if k <= 512 else 1024) if has_cmp else 0
+    pages, table = page_kv(ori)
+    cmp_pages, cmp_table = page_kv(cmp) if has_cmp else (None, None)
+    # Native query positions are inferred as used_kv_length - query_length + i.
+    # Using the full CP cache length here would silently shift the front partition.
+    cu_q = torch.arange(b + 1, dtype=torch.int32, device=q.device) * s
+    used_ori = torch.full((b,), end, dtype=torch.int32, device=q.device)
+    used_cmp = torch.full_like(used_ori, end // ratio) if has_cmp else None
+    residual = torch.full_like(used_ori, end % ratio) if has_cmp else None
+    selected = None
+    if has_cmp:
+        selected = F.pad(indices.to(torch.int32), (0, topk-k), value=-1).reshape(b*s, 1, topk).contiguous()
+    common = dict(cu_seqlens_q=cu_q, seqused_ori_kv=used_ori,
+                  seqused_cmp_kv=used_cmp, cmp_residual_kv=residual,
+                  cmp_ratio=ratio if has_cmp else 0, ori_mask_mode=4,
+                  cmp_mask_mode=3 if has_cmp else 0, ori_win_left=127,
+                  ori_win_right=0, layout_q='TND', layout_kv='PA_BBND')
+    meta = dict(common, batch_size=b, max_seqlen_q=s, max_seqlen_ori_kv=end,
+                max_seqlen_cmp_kv=end//ratio if has_cmp else 0, ori_topk=0,
+                cmp_topk=topk, has_ori_kv=True, has_cmp_kv=has_cmp)
+    call = dict(common, ori_kv=pages, cmp_kv=cmp_pages, ori_block_table=table,
+                cmp_block_table=cmp_table, cmp_sparse_indices=selected, sinks=sink,
+                softmax_scale=scale, topk_value_mode=1, return_softmax_lse=True)
+    return q.reshape(b*s, h, d).contiguous(), meta, call
+
+
+@lru_cache(maxsize=1)
+def load_native_library():
+    library = os.environ.get('V41_CSA2_NATIVE_LIBRARY')
+    if library:
+        # Load registered Torch operators without importing the rollout Python stack.
+        torch.ops.load_library(library)
+
+
+def native_forward(q, ori, cmp, indices, sink, *, ratio, window, scale, query_start):
+    load_native_library()
+    # Reuse the rollout package's environment/bootstrap and operator registration.
+    # Import only on explicit selection; the default training path stays isolated.
+    if not hasattr(torch.ops._C_ascend, 'npu_sparse_flash_mla'):
+        from vllm_ascend.utils import enable_custom_op
+        enable_custom_op()
+    if not (hasattr(torch.ops._C_ascend, 'npu_sparse_flash_mla') and
+            hasattr(torch.ops._C_ascend, 'npu_sparse_flash_mla_metadata')):
+        raise RuntimeError('Native SparseFlashMla and metadata are unavailable; use the V4.1 rollout operator environment')
+    flat_q, meta, call = native_arguments(q, ori, cmp, indices, sink, ratio, window, scale, query_start)
+    cache = _METADATA_CACHE.get()
+    # All tensor-valued metadata inputs above are generated solely from this
+    # geometry (uniform batch lengths). No Q/KV/indices or their addresses cached.
+    key = (str(q.device), tuple(q.shape), ratio, window, query_start,
+           tuple(sorted((k, v) for k, v in meta.items() if not isinstance(v, torch.Tensor))))
+    metadata = cache.get(key) if cache is not None else None
+    if metadata is None:
+        metadata = torch.ops._C_ascend.npu_sparse_flash_mla_metadata(q.shape[2], 1, q.shape[3], **meta)
+        if cache is not None:
+            cache[key] = metadata
+    out, lse = torch.ops._C_ascend.npu_sparse_flash_mla(flat_q, metadata=metadata, **call)
+    b, s, h, d = q.shape
+    if out.shape != flat_q.shape or out.dtype != q.dtype or lse.shape != (1, b*s, h) or lse.dtype != torch.float32:
+        raise RuntimeError(f'Unexpected native output/LSE contract: {out.shape}/{out.dtype}, {lse.shape}/{lse.dtype}')
+    return out.reshape(b, s, h, d), lse.reshape(b, s, h).contiguous()
+
+
+def backward_arguments(q, ori, cmp, indices, sink, *, ratio, window, scale, query_start):
+    """Use physical KV prefixes so right-down alignment works on older runtimes too."""
+    b, s, h, d = q.shape
+    if q.dtype != torch.bfloat16 or d != 512 or window != 128:
+        raise ValueError('Native backward requires BF16 D512 window128')
+    end = query_start + s
+    if ratio not in (1, 2, 4) or query_start < 0 or end > ori.shape[1]:
+        raise ValueError('Invalid native backward ratio/query range')
+    has_cmp = cmp.shape[1] > 0 and indices.shape[-1] > 0 and end // ratio > 0
+    selected = None
+    if has_cmp:
+        positions = torch.arange(query_start, end, device=q.device)[None, :, None]
+        valid = (indices >= 0) & ((indices.long() + 1) * ratio <= positions + 1)
+        # A2/A3 SCFA reads a count-derived prefix; it does not skip -1 holes.
+        count = ((positions + 1) // ratio).clamp(max=min(indices.shape[-1], end // ratio))
+        active = torch.arange(indices.shape[-1], device=q.device)[None, None, :] < count
+        if bool((active != valid).any()):
+            raise ValueError('Native backward requires a dense valid index prefix of '
+                             'min(topk_width, visible_cmp_count); -1 holes/short selections '
+                             'inside that prefix are unsupported. Use the actual topk width '
+                             'or the Triton backward backend.')
+        selected = torch.where(valid, indices, -1).to(torch.int32).unsqueeze(2).contiguous()
+    return dict(ori_kv=ori[:, :end].contiguous(),
+                cmp_kv=cmp[:, :end//ratio].contiguous() if has_cmp else None,
+                cmp_sparse_indices=selected, sinks=sink,
+                cmp_residual_kv=torch.full((b,), end % ratio, dtype=torch.int32, device=q.device) if has_cmp else None,
+                softmax_scale=scale, cmp_ratio=ratio, ori_mask_mode=4,
+                cmp_mask_mode=3 if has_cmp else 0, ori_win_left=127, ori_win_right=0,
+                layout_q='BSND', layout_kv='BSND')
+
+
+def native_backward(q, ori, cmp, indices, sink, output, lse, dout, **options):
+    # Reuse the CANN training binding; do not build another C++ wrapper.
+    from cann_ops_transformer import sparse_flash_mla_grad
+    call = backward_arguments(q, ori, cmp, indices, sink, **options)
+    native_lse = lse.unsqueeze(1).contiguous()  # B,S,H -> B,1,S,H
+    result = sparse_flash_mla_grad(q.contiguous(), dout.contiguous(),
+                                  output.to(q.dtype).contiguous(), native_lse, **call)
+    dq, dori, dcmp, dsink = result[:4]
+    if dq.shape != q.shape or dori.shape != call['ori_kv'].shape:
+        raise RuntimeError('Unexpected native backward Q/original KV gradient shape')
+    dori = F.pad(dori, (0, 0, 0, 0, 0, ori.shape[1]-dori.shape[1]))
+    if call['cmp_kv'] is None:
+        dcmp = torch.zeros_like(cmp)
+    else:
+        if dcmp.shape != call['cmp_kv'].shape:
+            raise RuntimeError('Unexpected native compressed KV gradient shape')
+        dcmp = F.pad(dcmp, (0, 0, 0, 0, 0, cmp.shape[1]-dcmp.shape[1]))
+    if sink is not None and dsink.shape != sink.shape:
+        raise RuntimeError('Unexpected native sink gradient shape')
+    return dq.to(q.dtype), dori.to(ori.dtype), dcmp.to(cmp.dtype), dsink if sink is not None else None
