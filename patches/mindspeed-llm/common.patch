+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/full_engram_io.py
@@ -0,0 +1,76 @@
+"""Bounded BF16 table IO. No full-table materialization or alternative transport."""
+import json
+from pathlib import Path
+from safetensors import safe_open
+
+CHUNK_ROWS = 65536
+
+
+def index(root):
+    root = Path(root)
+    for name in ('model.safetensors.index.json', 'quant_model_weights.safetensors.index.json'):
+        if (root / name).is_file():
+            return json.loads((root / name).read_text())['weight_map']
+    raise FileNotFoundError('No safetensors index in ' + str(root))
+
+
+def source_file(root, name):
+    root = Path(root).resolve()
+    path = (root / index(root)[name]).resolve()
+    path.relative_to(root)
+    return path
+
+
+def header(root, name):
+    with safe_open(source_file(root, name), framework='pt', device='cpu') as f:
+        value = f.get_slice(name)
+        return value.get_shape(), value.get_dtype()
+
+
+def chunks(rows):
+    for start in range(0, rows, CHUNK_ROWS):
+        yield start, min(start + CHUNK_ROWS, rows)
+
+
+def chunk_name(layer, start, end):
+    return f'engram/{layer}.embed.weight.rows.{start}.{end}'
+
+
+def load_table(table, root, layer):
+    name = f'layers.{layer}.engram.embed.weight'
+    with safe_open(source_file(root, name), framework='pt', device='cpu') as f:
+        value = f.get_slice(name)
+        if value.get_dtype() != 'BF16':
+            raise ValueError('Full trainable Engram currently requires BF16 source tables')
+        table.load_slice(value, CHUNK_ROWS)
+
+
+def small_table_metadata(root):
+    """Explicit test fixture marker; normal full checkpoints have no row map."""
+    path = Path(root) / 'small_engram.json'
+    if not path.exists():
+        return None
+    meta = json.loads(path.read_text())
+    if meta.get('schema') != 1 or meta.get('status') != 'prepared':
+        raise ValueError('Incomplete small Engram fixture')
+    import hashlib
+    if hashlib.sha256((Path(root)/'config.json').read_bytes()).hexdigest() != meta['source_config_sha256']:
+        raise ValueError('Small-table hash configuration identity mismatch')
+    return meta
+
+
+def original_ids(root, layer):
+    meta = small_table_metadata(root)
+    if meta is None:
+        return None
+    import hashlib
+    import torch
+    key = f'layers.{layer}.engram.embed.original_ids'
+    with safe_open(source_file(root, key), framework='pt', device='cpu') as f:
+        ids = f.get_tensor(key)
+    spec = meta['layers'][str(layer)]
+    if ids.dtype != torch.int64 or ids.shape != (spec['rows'],) or bool((ids < 0).any()) or bool((ids[1:] <= ids[:-1]).any()):
+        raise ValueError('Invalid small-table original IDs')
+    if hashlib.sha256(ids.contiguous().numpy().tobytes()).hexdigest() != spec['original_ids_sha256']:
+        raise ValueError('Small-table row-map checksum mismatch')
+    return ids
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/full_engram_table.py b/mindspeed_llm/tasks/models/transformer/deepseek41/full_engram_table.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e594f5bb7a87bd9e0fb487e0b6e7885f08b1d1a
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/full_engram_table.py
@@ -0,0 +1,128 @@
+"""Row-sharded full Engram lookup primitive.
+
+The caller owns the process group and optimizer integration. This is not a
+standalone registration with MCore DDP: table owners must not be treated as
+replicas by its gradient reducer. CPU storage and device communication may be
+selected independently. Full tables are never gathered.
+"""
+import torch
+import torch.distributed as dist
+from torch import nn
+from torch.nn import functional as F
+from torch.distributed.nn.functional import all_to_all_single
+
+
+class FullEngramTable(nn.Module):
+    def __init__(self, rows, width, *, group, storage_device, communication_device,
+                 trainable=True, dtype=torch.bfloat16, original_ids=None):
+        super().__init__()
+        if rows <= 0 or width <= 0:
+            raise ValueError('Engram dimensions must be positive')
+        self.group = group
+        self.rank = dist.get_rank(group)
+        self.world = dist.get_world_size(group)
+        if self.world > rows:
+            raise ValueError('Engram row count must cover all table owners')
+        self.original_ids = None
+        if original_ids is not None:
+            ids = original_ids.detach().cpu()
+            if ids.dtype != torch.int64 or ids.shape != (rows,) or bool((ids < 0).any()) or bool((ids[1:] <= ids[:-1]).any()):
+                raise ValueError('Small-table original IDs must be sorted unique int64 [rows]')
+            # Integer, frozen metadata: retained by native checkpoint and mbridge.
+            self.original_ids = nn.Parameter(ids.clone(), requires_grad=False)
+        self.rows, self.width = rows, width
+        # Fixed-size padded shards match MCore's checkpoint geometry. Padding is
+        # never addressable by a valid hash and is excluded from weight export.
+        self.shard_rows = (rows + self.world - 1) // self.world
+        self.start = self.shard_rows * self.rank
+        self.end = min(self.start + self.shard_rows, rows)
+        self.communication_device = torch.device(communication_device)
+        self.weight = nn.Parameter(torch.zeros(self.shard_rows, width,
+            dtype=dtype, device=storage_device), requires_grad=trainable)
+
+    @torch.no_grad()
+    def load_slice(self, tensor_slice, chunk_rows=65536):
+        """Read only owned rows from a safetensors get_slice object."""
+        if list(tensor_slice.get_shape()) != [self.rows, self.width]:
+            raise ValueError('Full Engram source shape differs from configured table')
+        if chunk_rows <= 0:
+            raise ValueError('chunk_rows must be positive')
+        for start in range(self.start, self.end, chunk_rows):
+            end = min(start + chunk_rows, self.end)
+            self.weight[start-self.start:end-self.start].copy_(tensor_slice[start:end])
+
+    def forward(self, ids):
+        if ids.dtype != torch.int64:
+            raise TypeError('Engram row IDs must be int64')
+        missing = None
+        if self.original_ids is not None:
+            keys = self.original_ids.detach().to(ids.device)
+            compact = torch.searchsorted(keys, ids.contiguous())
+            safe = compact.clamp(max=self.rows-1)
+            missing = (compact >= self.rows) | (keys[safe] != ids)
+            ids = safe.masked_fill(missing, 0)
+        flat = ids.reshape(-1).to(self.communication_device)
+        # Propagate invalid IDs before any rank enters the lookup collectives.
+        bad = ((flat < 0) | (flat >= self.rows)).any().to(torch.int32)
+        dist.all_reduce(bad, op=dist.ReduceOp.MAX, group=self.group)
+        if bad.item():
+            raise ValueError('Engram row ID outside full table')
+        # Send each query only to its owner; no world-sized copy of lookup rows.
+        owners = torch.div(flat, self.shard_rows, rounding_mode='floor')
+        order = torch.argsort(owners, stable=True)
+        send_counts = torch.bincount(owners, minlength=self.world).to(torch.int64)
+        recv_counts = torch.empty_like(send_counts)
+        dist.all_to_all_single(recv_counts, send_counts, group=self.group)
+        send_sizes, recv_sizes = send_counts.tolist(), recv_counts.tolist()
+        requests = torch.empty(sum(recv_sizes), device=self.communication_device, dtype=torch.int64)
+        dist.all_to_all_single(requests, flat[order].contiguous(),
+            output_split_sizes=recv_sizes, input_split_sizes=send_sizes, group=self.group)
+        local_ids = (requests - self.start).to(self.weight.device)
+        # Autograd moves lookup gradients back to storage when devices differ.
+        local = F.embedding(local_ids, self.weight).to(self.communication_device)
+        output = torch.empty((flat.numel(), self.width), device=self.communication_device, dtype=local.dtype)
+        if self.weight.requires_grad and torch.is_grad_enabled():
+            output = all_to_all_single(output, local.contiguous(),
+                output_split_sizes=send_sizes, input_split_sizes=recv_sizes, group=self.group)
+        else:
+            dist.all_to_all_single(output, local.contiguous(),
+                output_split_sizes=send_sizes, input_split_sizes=recv_sizes, group=self.group)
+        # order is a permutation: invert it directly, without an integer sort
+        # that falls back to AiCPU on Ascend. Empty requests are supported.
+        inverse = torch.empty_like(order)
+        inverse.scatter_(0, order, torch.arange(order.numel(), device=order.device, dtype=order.dtype))
+        result = output[inverse].reshape(*ids.shape, self.width)
+        if missing is not None:
+            result = result.masked_fill(missing.to(result.device)[..., None], 0)
+        return result
+
+    def _load_from_state_dict(self, state_dict, prefix, *args, **kwargs):
+        saved = state_dict.get(prefix + 'original_ids')
+        if self.original_ids is not None and (saved is None or not torch.equal(saved.cpu(), self.original_ids.detach().cpu())):
+            raise ValueError('Checkpoint Engram row-map identity mismatch')
+        super()._load_from_state_dict(state_dict, prefix, *args, **kwargs)
+
+    def sharded_state_dict(self, prefix='', sharded_offsets=(), metadata=None):
+        from megatron.core.dist_checkpointing.mapping import ShardedTensor
+        if sharded_offsets:
+            raise ValueError('Full Engram requires PP=1')
+        # Native DistributedOptimizer requires (PP, TP, DP) replica coordinates.
+        # WORLD owners have distinct row offsets, so every table shard is primary.
+        result = {prefix + 'weight': ShardedTensor.from_rank_offsets(
+            prefix + 'weight', self.weight, (0, self.rank, self.world), replica_id=(0, 0, 0))}
+        if getattr(self, 'original_ids', None) is not None:
+            result[prefix + 'original_ids'] = ShardedTensor.from_rank_offsets(
+                prefix + 'original_ids', self.original_ids, replica_id=(0, 0, self.rank))
+        return result
+
+
+def owner_groups():
+    """One optimizer owner per rank; lookup itself uses the existing WORLD group."""
+    # Called once per model construction, collectively and in rank order.
+    local = local_cpu = None
+    for rank in range(dist.get_world_size()):
+        group = dist.new_group([rank])
+        cpu = dist.new_group([rank], backend='gloo')
+        if rank == dist.get_rank():
+            local, local_cpu = group, cpu
+    return local, local_cpu
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/grpo_objective.py b/mindspeed_llm/tasks/models/transformer/deepseek41/grpo_objective.py
new file mode 100644
index 0000000000000000000000000000000000000000..c225ebbf774ee2a715880fe1328ebe76425475b7
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/grpo_objective.py
@@ -0,0 +1,53 @@
+"""Fixed grouped-rollout GRPO using verl advantages and clipped policy loss.
+
+Global response-token mean. CP partitions contribute sums; TP replicas do not
+multiply the loss. No critic, entropy, reference KL, or online generation.
+"""
+import numpy as np
+import torch
+
+
+def load_algorithms():
+    from verl.trainer.ppo.core_algos import compute_grpo_outcome_advantage, compute_policy_loss_vanilla
+    from verl.workers.config import ActorConfig
+    config = ActorConfig(strategy='megatron', rollout_n=2,
+                         ppo_micro_batch_size_per_gpu=1, clip_ratio=.2,
+                         clip_ratio_low=.2, clip_ratio_high=.2, clip_ratio_c=3.)
+    return compute_grpo_outcome_advantage, compute_policy_loss_vanilla, config
+
+
+def prepare(fixture, tokens, advantage_fn):
+    masks = torch.tensor(fixture['response_mask'], dtype=torch.float32)
+    rewards = torch.tensor(fixture['rewards'], dtype=torch.float32)
+    groups = np.asarray(fixture['group_ids'])
+    prompt = fixture['prompt_tokens']
+    if tokens.ndim != 2 or masks.shape != (len(tokens), tokens.shape[1]-1):
+        raise ValueError('response mask must align with next-token labels')
+    if prompt < 1 or prompt >= tokens.shape[1] or rewards.shape != (len(tokens),) or len(groups) != len(tokens):
+        raise ValueError('invalid grouped rollout dimensions')
+    if not torch.isfinite(rewards).all() or not ((masks == 0) | (masks == 1)).all():
+        raise ValueError('finite rewards and binary masks required')
+    if masks[:, :prompt-1].any() or not masks[:, prompt-1:].all():
+        raise ValueError('this probe requires unpadded complete response suffixes')
+    for group in set(groups):
+        ids = np.flatnonzero(groups == group)
+        if len(ids) < 2 or not torch.equal(tokens[ids, :prompt], tokens[ids[0], :prompt].expand(len(ids), -1)):
+            raise ValueError('each GRPO group requires >=2 completions of the SAME prompt')
+    token_rewards = torch.zeros_like(masks)
+    token_rewards[:, -1] = rewards
+    advantage, _ = advantage_fn(token_rewards, masks, groups, norm_adv_by_std_in_grpo=True)
+    if not torch.isfinite(advantage).all() or not advantage.any():
+        raise ValueError('degenerate GRPO rewards: no training signal')
+    return masks, advantage.detach()
+
+
+def contribution(log_prob, old, advantage, mask, global_tokens, policy_fn, config):
+    if not torch.isfinite(log_prob).all() or old.requires_grad or advantage.requires_grad:
+        raise ValueError('invalid policy inputs')
+    config.global_batch_info.clear()
+    config.global_batch_info.update(dp_size=1, batch_num_tokens=global_tokens)
+    if not mask.any():
+        return log_prob.sum()*0
+    loss, _ = policy_fn(old_log_prob=old, log_prob=log_prob, advantages=advantage,
+                       response_mask=mask, loss_agg_mode='token-mean', config=config)
+    return loss
