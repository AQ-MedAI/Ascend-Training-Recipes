+            probs = torch.cat((scores, sink_logits), dim=-1).softmax(-1)[..., :-1]
+        else:
+            probs = scores.softmax(-1)
+        results.append(torch.einsum("bchk,bckd->bchd", probs, selected))
+    return torch.cat(results, dim=1).to(q.dtype)
