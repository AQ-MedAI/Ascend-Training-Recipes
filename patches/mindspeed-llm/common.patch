index 0000000000000000000000000000000000000000..7e9bacaab1133f6351ba6be61ea7d8428e99705d
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/native_engram.py
@@ -0,0 +1,91 @@
+"""Persistent cropped Engram: original hash semantics, zero for absent rows."""
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+from torch import nn
+from safetensors import safe_open
+from .training_engram import TrainingEngramGate
+from .cropped_engram_lookup import lookup_cropped_rows, remap_original_ids
+
+
+def file_sha(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as f:
+        for block in iter(lambda: f.read(8 * 1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+class CroppedEngram(TrainingEngramGate):
+    def __init__(self, c, rows, original_ids, columns):
+        super().__init__(c['hidden_size'], c['hc_mult'], columns * rows.shape[-1], c['rms_norm_eps'])
+        self.rows = nn.Parameter(torch.empty_like(rows))
+        self.register_buffer('original_ids', original_ids)
+
+    def forward(self, residual, hashes):
+        indices = remap_original_ids(self.original_ids, hashes).to(residual.device)
+        rows = lookup_cropped_rows(self.rows, indices)
+        output = super().forward(residual, rows)
+        observer = getattr(self, '_diagnostic_observer', None)
+        if observer is not None:
+            observer(indices, rows, residual, output)
+        return output
+
+
+class EngramResources:
+    """CPU hashing state stays outside the model and optimizer state dict."""
+    def __init__(self, model_path, crop_path, source_path, hash_source, max_length):
+        from transformers import AutoTokenizer
+
+        self.crop = Path(crop_path)
+        self.manifest = meta = json.loads((self.crop / 'manifest.json').read_text())
+        source = Path(source_path)
+        if meta.get('schema') != 1 or meta.get('status') != 'prepared':
+            raise ValueError('Incomplete Engram crop')
+        for path, field in [(Path(model_path)/'config.json', 'model_config_sha256'),
+                            (source/'config.json', 'source_config_sha256'),
+                            (self.crop/'engram.safetensors', 'payload_sha256'),
+                            (Path(hash_source), 'hash_source_sha256')]:
+            if file_sha(path) != meta[field]:
+                raise ValueError(f'Engram identity mismatch: {field}')
+        raw = json.loads((source/'config.json').read_text())
+        c = raw.get('text_config', raw)
+        values = {k: v for k, v in c.items() if k.startswith('engram_')}
+        values['engram_pad_id'] = c.get('engram_pad_token_id', c.get('engram_pad_id', 2))
+        args = SimpleNamespace(**values, max_batch_size=1, max_seq_len=max_length)
+        spec = importlib.util.spec_from_file_location('dsv41_original_engram_hash', hash_source)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = module
+        spec.loader.exec_module(module)
+        tokenizer = AutoTokenizer.from_pretrained(source, local_files_only=True, trust_remote_code=False)
+        with torch.device('cpu'):
+            self.layout = module.EngramLayout.from_args(args)
+            self.hasher = module.NgramHashState(args, self.layout, tokenizer)
+        if set(self.layout.layer_ids) != {x['layer'] for x in meta['layers']}:
+            raise ValueError('Engram crop does not cover the source layer inventory')
+
+    def build(self, c, layer):
+        with safe_open(self.crop/'engram.safetensors', framework='pt', device='cpu') as f:
+            prefix = str(layer) + '.'
+            rows = f.get_tensor(prefix+'rows')
+            ids = f.get_tensor(prefix+'original_ids')
+            columns = f.get_slice(prefix+'indices').get_shape()[-1]
+            if ids.ndim != 1 or len(ids) != len(rows) or bool((ids[1:] <= ids[:-1]).any()):
+                raise ValueError('Engram original IDs must be sorted and unique')
+            return CroppedEngram(c, rows, ids, columns)
+
+    def hashes(self, full_tokens):
+        if full_tokens.shape[1] > self.hasher.cache.shape[1]:
+            raise ValueError('Sequence exceeds configured Engram hash capacity')
+        if full_tokens.shape[0] > self.hasher.cache.shape[0]:
+            # Training hashes complete sequences at start_pos=0, so no history
+            # needs copying when the dynamic microbatch grows.
+            self.hasher.cache = self.hasher.cache.new_empty(
+                full_tokens.shape[0], self.hasher.cache.shape[1])
+        values = self.hasher(full_tokens.detach().cpu(), 0)
+        return {layer: values[:, :, i].clone() for i, layer in enumerate(self.layout.layer_ids)}
