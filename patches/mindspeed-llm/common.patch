+"""Fixed-rollout PPO bridge to verl's loss registry, not a registered verl worker.
+
+Only unpadded equal-length prompt+response, TP=PP=CP=1, data world size 1/2, EP=1/2.
+No rollout generation, entropy bonus, reference-policy KL or importance weights.
+"""
+import copy
+import math
+import torch
+from .schedule_adapter import validate_schedule
+
+
+def validate_batch(batch):
+    required={'input_ids','responses','response_mask','old_log_probs','advantages'}
+    if set(batch)!=required:
+        raise ValueError('fixed rollout requires exactly '+str(sorted(required)))
+    ids,response=batch['input_ids'],batch['responses']
+    if ids.ndim!=2 or response.ndim!=2 or ids.shape[0]!=response.shape[0] or ids.shape[0]<1 or not 0<response.shape[1]<ids.shape[1]:
+        raise ValueError('nonempty prompt and response required')
+    if ids.dtype!=torch.int64 or response.dtype!=torch.int64 or not torch.equal(ids[:,-response.shape[1]:],response):
+        raise ValueError('responses must be the int64 input_ids suffix')
+    for key in required:
+        value=batch[key]
+        if value.device!=ids.device or (key!='input_ids' and value.shape!=response.shape):
+            raise ValueError('rollout shape/device mismatch: '+key)
+        if value.requires_grad or not bool(torch.isfinite(value).all()):
+            raise ValueError('rollout must be detached and finite: '+key)
+    if not bool(((batch['response_mask']==0)|(batch['response_mask']==1)).all()):
+        raise ValueError('response_mask must be binary')
+    if not batch['old_log_probs'].is_floating_point() or not batch['advantages'].is_floating_point():
+        raise ValueError('old_log_probs and advantages must be floating point')
+
+
+def response_log_probs(logits,responses,*,temperature=1.):
+    if not math.isfinite(temperature) or temperature<=0:
+        raise ValueError('temperature must be finite and positive')
+    if logits.ndim!=3 or responses.ndim!=2 or logits.shape[0]!=responses.shape[0] or not 0<responses.shape[1]<logits.shape[1]:
+        raise ValueError('invalid logits/response shape')
+    # Position P-1 predicts response[0]; final input position has no target here.
+    selected=logits[:,-responses.shape[1]-1:-1,:].float()/temperature
+    return selected.log_softmax(-1).gather(-1,responses.long().unsqueeze(-1)).squeeze(-1)
+
+
+def load_verl_policy():
+    # No fallback: the NPU integration probe must exercise the installed code.
+    from verl.trainer.ppo.core_algos import get_policy_loss_fn
+    from verl.workers.config import ActorConfig
+    config=ActorConfig(strategy='megatron',rollout_n=1,ppo_micro_batch_size_per_gpu=1,clip_ratio=.2,clip_ratio_low=.2,clip_ratio_high=.2,clip_ratio_c=3.)
+    return get_policy_loss_fn('vanilla'),config
+
+
+def objective(model,piece,*,policy_loss,actor_config,total_tokens,total_queries,temperature=1.):
+    output=model(piece['input_ids'])
+    log_prob=response_log_probs(output.logits,piece['responses'],temperature=temperature)
+    config=copy.deepcopy(actor_config)
+    config.global_batch_info.clear()
+    config.global_batch_info.update(dp_size=1,batch_num_tokens=max(total_tokens,1))
+    # verl's masked metrics divide by zero on an empty microbatch. Keep a zero
+    # actor gradient path while still training the Indexer auxiliary objective.
+    if bool(piece['response_mask'].any()):
+        pg,_=policy_loss(old_log_prob=piece['old_log_probs'],log_prob=log_prob,
+            advantages=piece['advantages'],response_mask=piece['response_mask'],
+            loss_agg_mode='token-mean',config=config)
+    else:
+        pg=log_prob.sum()*0
+    auxiliary=output.auxiliary*piece['input_ids'].numel()/total_queries
+    return pg+auxiliary,dict(log_probs=log_prob,policy=pg.detach(),auxiliary=auxiliary.detach())
+
+
+def prepare_actor_step(batch,*,policy_loss,actor_config,temperature=1.,normalization=None):
+    validate_batch(batch)
+    count=int(batch['response_mask'].sum());queries=batch['input_ids'].numel()
+    dp=1
+    if normalization is not None:
+        nt,nq,dp=normalization
+        if any(type(v) is not int for v in (nt,nq,dp)) or dp not in (1,2) or nt<count or nq<queries:
+            raise ValueError('invalid global actor normalizers')
+        count,queries=nt,nq
+    pieces=[{k:v[i:i+1] for k,v in batch.items()} for i in range(batch['input_ids'].shape[0])]
+    def forward_step(data_iterator,model):
+        validate_schedule(model.config)
+        if getattr(model.config,'dsv41_data_parallel_size',1)!=dp:
+            raise ValueError('actor normalizer DP size mismatch')
+        loss,_=objective(model,next(data_iterator),policy_loss=policy_loss,actor_config=actor_config,
+                         total_tokens=count,total_queries=queries,temperature=temperature)
+        def reduce_loss(value):
+            return value,{'objective_contribution':loss.detach()}
+        # verl receives dp_size=1; compensate native DDP averaging exactly here.
+        return loss*len(pieces)*dp,reduce_loss
+    return pieces,forward_step
