@@ -0,0 +1,148 @@
+"""Opt-in in-process verl actor/worker contracts for the DSV4.1 prototype.
+
+Creates a real BasePPOActor and exchanges real DataProto objects. Not a Ray
+ActorRolloutRefWorker: no generation, offload, HF loading or weight transport.
+Call all ranks together; only equal local batch/sequence sizes are supported.
+"""
+import math
+import torch
+from . import actor_adapter
+from .megatron_runtime import DataParallelRuntime
+
+
+def rollout_tensors(data, *, training):
+    """Validate supported verl fields without modifying caller tensors/metadata."""
+    required={'input_ids','responses','attention_mask','position_ids'}
+    if training:required|={'response_mask','old_log_probs','advantages'}
+    allowed=required|{'response_mask','old_log_probs','advantages'}
+    if data.batch is None or not required<=set(data.batch.keys()) or set(data.batch.keys())-allowed:
+        raise ValueError('unsupported or missing DataProto tensor fields')
+    if data.non_tensor_batch:raise ValueError('non-tensor rollout fields are unsupported')
+    meta=data.meta_info
+    if meta.get('use_dynamic_bsz',False) or meta.get('micro_batch_size',1)!=1:
+        raise ValueError('only fixed micro_batch_size=1 is supported')
+    temperature=meta.get('temperature')
+    if not isinstance(temperature,(float,int)) or not math.isfinite(temperature) or temperature<=0:
+        raise ValueError('explicit positive temperature is required')
+    ids=data.batch['input_ids'];response=data.batch['responses']
+    if ids.ndim!=2 or ids.shape[0]<1 or response.ndim!=2 or ids.shape[0]!=response.shape[0] or not 0<response.shape[1]<ids.shape[1]:
+        raise ValueError('nonempty equal-length prompt/response batches required')
+    mask=data.batch['attention_mask'];pos=data.batch['position_ids']
+    if mask.shape!=ids.shape or not bool((mask==1).all()):raise ValueError('padding/packing is unsupported')
+    expected=torch.arange(ids.shape[1],device=pos.device).expand_as(pos)
+    if pos.shape!=ids.shape or pos.dtype not in (torch.int32,torch.int64) or not torch.equal(pos,expected):
+        raise ValueError('position_ids must start at zero and be contiguous')
+    result={k:data.batch[k] for k in ('input_ids','responses')}
+    if training:
+        result.update({k:data.batch[k] for k in ('response_mask','old_log_probs','advantages')})
+    else:
+        result.update(response_mask=torch.ones_like(response),old_log_probs=torch.zeros_like(response,dtype=torch.float32),
+                      advantages=torch.zeros_like(response,dtype=torch.float32))
+    actor_adapter.validate_batch(result)
+    return result,float(temperature)
+
+
+def backward_actor(rt,schedule,batch,*,policy_loss,actor_config,temperature):
+    """Previously device-validated PPO schedule path, owned by framework code."""
+    rt.optimizer.zero_grad(set_to_none=True);rt.ddp.zero_grad_buffer()
+    actor_adapter.validate_batch(batch)
+    local_count=int(batch['response_mask'].sum())
+    counts=torch.tensor([local_count,batch['input_ids'].numel()],device=batch['input_ids'].device,dtype=torch.int64)
+    torch.distributed.all_reduce(counts,group=rt.dp_group)
+    rt.last_normalization=dict(local_response_tokens=local_count,global_response_tokens=int(counts[0]),global_queries=int(counts[1]),dp_size=rt.dp_size)
+    pieces,fn=actor_adapter.prepare_actor_step(batch,normalization=(int(counts[0]),int(counts[1]),rt.dp_size),
+        policy_loss=policy_loss,actor_config=actor_config,temperature=temperature)
+    previous=rt.model.config.no_sync_func;rt.model.config.no_sync_func=rt.ddp.no_sync
+    try:
+        logs=schedule(forward_step_func=fn,data_iterator=iter(pieces),model=[rt.ddp],
+            num_microbatches=len(pieces),seq_length=batch['input_ids'].shape[1],micro_batch_size=1,forward_only=False)
+        rt.ddp.finish_grad_sync()
+    finally:rt.model.config.no_sync_func=previous
+    if any(not bool(torch.isfinite(p.main_grad).all()) for p in rt.model.parameters()):
+        raise RuntimeError('nonfinite actor main_grad')
+    return sum(float(item['objective_contribution']) for item in logs)
+
+
+class ActorCore:
+    def __init__(self,runtime,schedule,policy_loss,config):
+        self.runtime=runtime;self.schedule=schedule;self.policy_loss=policy_loss;self.config=config
+
+    def _prepare(self,data,training):
+        # Synchronize validation failures before entering EP forward collectives.
+        error=None;batch=None;temperature=None
+        try:batch,temperature=rollout_tensors(data,training=training)
+        except (ValueError,TypeError,KeyError,RuntimeError) as exc:error=str(exc)
+        device=next(self.runtime.model.parameters()).device
+        flag=torch.tensor(int(error is None),device=device,dtype=torch.int32)
+        torch.distributed.all_reduce(flag,op=torch.distributed.ReduceOp.MIN,group=self.runtime.dp_group)
+        if not bool(flag):raise ValueError(error or 'rollout rejected on another data rank')
+        shape=torch.tensor([*batch['input_ids'].shape,batch['responses'].shape[1]],device=device,dtype=torch.int64)
+        gathered=[torch.empty_like(shape) for _ in range(self.runtime.dp_size)]
+        torch.distributed.all_gather(gathered,shape,group=self.runtime.dp_group)
+        if any(not torch.equal(shape,other) for other in gathered):raise ValueError('all ranks require equal batch/sequence/response sizes')
+        temps=torch.tensor([temperature],device=device,dtype=torch.float32)
+        lo=temps.clone();hi=temps.clone()
+        torch.distributed.all_reduce(lo,op=torch.distributed.ReduceOp.MIN,group=self.runtime.dp_group)
+        torch.distributed.all_reduce(hi,op=torch.distributed.ReduceOp.MAX,group=self.runtime.dp_group)
+        if not torch.equal(lo,hi):raise ValueError('temperature differs between ranks')
+        return {k:v.to(device) for k,v in batch.items()},temperature
+
+    @torch.no_grad()
+    def compute_log_prob(self,data,calculate_entropy=False):
+        if calculate_entropy:raise ValueError('entropy is not implemented')
+        batch,temp=self._prepare(data,False);model=self.runtime.model
+        was_training=model.training;model.eval()
+        try:
+            values=[actor_adapter.response_log_probs(model(piece).logits,batch['responses'][i:i+1],temperature=temp)
+                    for i,piece in enumerate(batch['input_ids'].split(1))]
+            return torch.cat(values),None,None
+        finally:model.train(was_training)
+
+    def update_policy(self,dataloader,enable_mtp=False):
+        if enable_mtp:raise ValueError('MTP is not implemented')
+        batches=list(dataloader)
+        count=torch.tensor(len(batches),device=next(self.runtime.model.parameters()).device,dtype=torch.int64)
+        lo=count.clone();hi=count.clone()
+        for value,op in ((lo,torch.distributed.ReduceOp.MIN),(hi,torch.distributed.ReduceOp.MAX)):
+            torch.distributed.all_reduce(value,op=op,group=self.runtime.dp_group)
+        if not torch.equal(lo,hi) or int(lo)<1:raise ValueError('same nonempty minibatch count required on all ranks')
+        prepared=[self._prepare(data,True) for data in batches]
+        metrics={'actor/loss':[],'actor/global_response_tokens':[],'actor/global_queries':[]}
+        model=self.runtime.model;was_training=model.training;model.train()
+        try:
+            for batch,temp in prepared:
+                loss=backward_actor(self.runtime,self.schedule,batch,policy_loss=self.policy_loss,actor_config=self.config,temperature=temp)
+                global_loss=torch.tensor(loss,device=batch['input_ids'].device)
+                torch.distributed.all_reduce(global_loss,group=self.runtime.dp_group)
+                self.runtime.step()
+                metrics['actor/loss'].append(float(global_loss))
+                metrics['actor/global_response_tokens'].append(self.runtime.last_normalization['global_response_tokens'])
+                metrics['actor/global_queries'].append(self.runtime.last_normalization['global_queries'])
+        finally:model.train(was_training)
+        return metrics
+
+
+class ActorWorker:
+    """In-process worker API; deliberately not registered as an ActorRollout role."""
+    def __init__(self,actor):self.actor=actor
+
+    def compute_log_prob(self,data):
+        from verl import DataProto
+        log_probs,_,_=self.actor.compute_log_prob(data)
+        return DataProto.from_dict(tensors={'old_log_probs':log_probs.cpu()},meta_info={'temperature':data.meta_info['temperature']})
+
+    def update_actor(self,data):
+        from verl import DataProto
+        return DataProto(meta_info={'metrics':self.actor.update_policy([data])})
+
+
+def create_worker(model_name,*,model_provider,schedule,device):
+    """Explicit model selection without patching verl's legacy global registries."""
+    if model_name!='deepseek41':raise ValueError('unsupported actor model: '+model_name)
+    from verl.workers.actor.base import BasePPOActor
+    class DeepSeek41PPOActor(ActorCore,BasePPOActor):
+        pass
+    policy,config=actor_adapter.load_verl_policy()
+    rt=DataParallelRuntime(model_provider().to(device));rt.ddp.broadcast_params()
+    for buffer in rt.model.buffers():torch.distributed.broadcast(buffer,src=0)
+    return ActorWorker(DeepSeek41PPOActor(rt,schedule,policy,config))
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/vocabulary_parallel.py b/mindspeed_llm/tasks/models/transformer/deepseek41/vocabulary_parallel.py
