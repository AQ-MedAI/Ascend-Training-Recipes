+"""Single-rank SBH training entry and scoped logical-weight loader.
+
+Not a Megatron ModuleSpec or registered model, not a complete checkpoint loader.
+Preserves the verified backbone's per-forward cross-layer graph. Dense FFN or opt-in single-rank MoE.
+"""
+from collections.abc import Mapping
+import torch
+from torch import nn
+from .reference_backbone import ReferenceBackbone
+
+
+class SingleRankTrainingAdapter(nn.Module):
+    def __init__(self, config, *, operator, teacher, coefficient, precision='float32',
+                 tensor_parallel_size=1, pipeline_parallel_size=1, context_parallel_size=1, data_parallel_size=1):
+        super().__init__()
+        if (tensor_parallel_size, pipeline_parallel_size, context_parallel_size) != (1, 1, 1):
+            raise ValueError('adapter only supports TP=PP=CP=1')
+        if data_parallel_size not in (1,2):raise ValueError('only DP=1 or explicit DP=2 supported')
+        if torch.distributed.is_initialized() and torch.distributed.get_world_size() != data_parallel_size:
+            raise ValueError('world_size must match explicit data_parallel_size')
+        if not callable(operator):
+            raise TypeError('an explicit attention operator is required')
+        self.backbone = ReferenceBackbone(config, teacher=teacher, coefficient=coefficient, precision=precision)
+        self.operator, self.hidden_size = operator, config['dim']
+
+    @property
+    def layers(self):
+        """Megatron schedule microbatch bookkeeping; avoids duplicate module registration."""
+        return self.backbone.layers
+
+    def forward(self, hidden_states, attention_mask=None, *, packed_seq_params=None,
+                inference_context=None, position_ids=None):
+        """Full equal-length position-zero SBH sequences -> (SBH hidden, aux loss)."""
+        if any(value is not None for value in (attention_mask, packed_seq_params, inference_context, position_ids)):
+            raise ValueError('only unpacked, position-zero full sequences with implicit causal masking are supported')
+        if hidden_states.ndim != 3 or hidden_states.shape[-1] != self.hidden_size:
+            raise ValueError('expected [sequence, batch, hidden_size]')
+        hidden = hidden_states.transpose(0, 1).contiguous()
+        output, auxiliary = self.backbone(hidden, self.operator)
+        return output.transpose(0, 1).contiguous(), auxiliary
+
+    def load_attention_mhc(self, source, mappings):
+        """Load the complete attention/mHC mapping scope without changing others.
+
+        Call before optimizer creation. Validate every entry and materialize every
+        cast before copying any parameter, so invalid inputs cause no partial load.
+        Extra source keys are reported, not interpreted as FFN/MoE/head weights.
+        """
+        if not isinstance(source, Mapping):
+            raise TypeError('source must map logical names to floating tensors')
+        entries = tuple(mappings)
+        parameters = dict(self.named_parameters())
+        excluded = {'backbone.norm.weight'} | {
+            f'backbone.layers.{i}.{name}.weight' for i in range(len(self.backbone.layers)) for name in ('up', 'down')}
+        excluded |= {name for name in parameters if ".moe." in name}
+        excluded &= set(parameters)
+        expected = set(parameters) - excluded
+        names = [entry.destination for entry in entries]
+        sources = [entry.source for entry in entries]
+        if len(set(names)) != len(names) or len(set(sources)) != len(sources):
+            raise ValueError('duplicate mapping source or destination')
+        if set(names) != expected:
+            raise ValueError(f'mapping scope mismatch: missing={sorted(expected-set(names))}, unexpected={sorted(set(names)-expected)}')
+        staged = []
+        for entry in entries:
+            if entry.source not in source:
+                raise ValueError(f'missing source weight: {entry.source}')
+            value, target = source[entry.source], parameters[entry.destination]
+            if not isinstance(value, torch.Tensor) or value.layout != torch.strided or not value.is_floating_point():
+                raise ValueError(f'expected unquantized floating tensor: {entry.source}')
+            if tuple(value.shape) != tuple(entry.shape) or tuple(target.shape) != tuple(entry.shape):
+                raise ValueError(f'shape mismatch: {entry.source} -> {entry.destination}')
+            if value.device.type == 'meta' or not bool(torch.isfinite(value).all()):
+                raise ValueError(f'nonfinite or unmaterialized weight: {entry.source}')
+            # clone also prevents source/target aliasing from changing later copies.
+            converted = value.detach().to(device=target.device, dtype=target.dtype).clone()
+            if not bool(torch.isfinite(converted).all()):
+                raise ValueError(f'nonfinite weight after conversion: {entry.source}')
+            staged.append((target, converted))
+        with torch.no_grad():
+            for target, value in staged:
+                target.copy_(value)
+        return dict(loaded_parameters=len(entries), excluded_destinations=sorted(excluded),
+                    ignored_source_keys=sorted(set(source)-set(sources)))
