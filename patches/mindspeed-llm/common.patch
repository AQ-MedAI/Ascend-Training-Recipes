+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/native_indexer.py
@@ -0,0 +1,122 @@
+"""Training adapter for rollout's INT8 QLI V3, including candidate blocks.
+
+Discrete selection is detached. The existing score path owns auxiliary gradients.
+No engine, persistent activation-pointer cache, or per-rank partial top-k.
+"""
+import os
+import torch
+import torch.distributed as dist
+from .candidate_mask import expand_candidate_mask
+
+
+def quantize_query(query):
+    # Same FP16-rounded scale and round-to-even contract as rollout's
+    # quantize_indexer_query. Torch form avoids importing a second vLLM stack.
+    value = query.float()
+    scale = (value.abs().amax(-1) / 127).half().clamp_min(2.0**-24)
+    quantized = (value / scale.float().unsqueeze(-1)).round().clamp(-127, 127).to(torch.int8)
+    return quantized, scale
+
+
+def gather_heads(query, weights, group):
+    size = dist.get_world_size(group)
+    if size == 1:
+        return query, weights
+    parts = [torch.empty_like(query) for _ in range(size)]
+    dist.all_gather(parts, query.contiguous(), group=group)
+    query = torch.cat(parts, dim=2)
+    parts = [torch.empty_like(weights) for _ in range(size)]
+    dist.all_gather(parts, weights.contiguous(), group=group)
+    return query, torch.cat(parts, dim=2)
+
+
+def candidate_validity(candidates, block_size, valid):
+    b, s, c = valid.shape
+    blocks = (c + block_size - 1) // block_size
+    ids = candidates.reshape(b, s, -1).long()
+    if blocks == 0:
+        return valid
+    count = torch.zeros((b, s, blocks), dtype=torch.int32, device=valid.device)
+    ok = (ids >= 0) & (ids < blocks)
+    count.scatter_add_(-1, ids.clamp(0, blocks - 1), ok.int())
+    return expand_candidate_mask(count > 0, block_size, valid)
+
+
+def native_ops():
+    from mindspeed_llm.ops.triton.dsv41_native_sparse_mla import load_native_library
+    load_native_library()
+    ops = torch.ops._C_ascend
+    required = ('npu_quant_lightning_indexer_v3', 'npu_quant_lightning_indexer_v2_metadata')
+    missing = [name for name in required if not hasattr(ops, name)]
+    if missing:
+        library = os.environ.get('V41_CSA2_NATIVE_LIBRARY')
+        if not library:
+            raise RuntimeError('QLI library was not configured. Run '
+                'bash workspace/tests/dsv41/run_native_lightning_indexer.sh '
+                'to prepare the native library and vendor paths before torchrun.')
+        raise RuntimeError(f'Loaded native library {library!r}, but missing {missing}; '
+                           'rebuild/install V4.1 rollout operators. No reference fallback.')
+    return ops
+
+
+def paged_keys(keys):
+    import torch_npu
+    from mindspeed_llm.ops.triton.dsv41_native_sparse_mla import page_kv
+    # Reuse rollout's K dynamic quantization and FP16 stored scales.
+    quantized, scales = torch_npu.npu_dynamic_quant(keys.bfloat16().unsqueeze(2), dst_type=torch.int8)
+    pages, table = page_kv(quantized)
+    scale_pages, _ = page_kv(scales.half().unsqueeze(-1))
+    return pages, scale_pages.squeeze(-1), table
+
+
+@torch.no_grad()
+def lightning_indices(query, keys, weights, *, group, ratio, query_start, topk,
+                      candidate_source=False, candidates=None, candidate_blocks=2048,
+                      candidate_block_size=8):
+    b, s, heads, dim = query.shape
+    if ratio not in (1, 2) or query_start < 0 or not 1 <= topk <= 2048 or dim != 128:
+        raise ValueError('Unsupported V4.1 QLI geometry')
+    if keys.ndim != 3 or keys.shape[0] != b or keys.shape[-1] != dim or weights.shape != (b, s, heads):
+        raise ValueError('Indexer Q/K/weights shape mismatch')
+    if candidate_source and candidates is not None:
+        raise ValueError('Candidate source must use unfiltered top-k')
+    candidate_mode = 1 if candidate_source else 2 if candidates is not None else 3
+    if candidate_mode != 3 and (candidate_block_size != 8 or not 0 < candidate_blocks <= 2048 or candidate_blocks % 64):
+        raise ValueError('QLI candidates require block_size=8 and a multiple-of-64 block count <=2048')
+    if candidates is not None and (candidates.shape != (b*s, 1, candidate_blocks) or candidates.dtype != torch.int32):
+        raise ValueError('Candidate consumer requires INT32 block IDs')
+    end = query_start + s
+    used = end // ratio
+    if used > keys.shape[1]:
+        raise ValueError('CP key prefix is incomplete')
+    if used == 0:
+        ids = torch.full((b, s, topk), -1, dtype=torch.long, device=query.device)
+        pool = torch.full((b*s, 1, candidate_blocks), -1, dtype=torch.int32, device=query.device) if candidate_source else candidates
+        return ids, pool
+    query, weights = gather_heads(query, weights, group)
+    heads = query.shape[2]
+    if heads not in (32, 64):
+        raise ValueError('QLI requires 32 or 64 global Indexer heads')
+    # All heads participate BEFORE top-k. Weights already carry global scaling.
+    q, q_scale = quantize_query(query.reshape(b*s, heads, dim))
+    k, k_scale, table = paged_keys(keys[:, :used].contiguous())
+    ops = native_ops()
+    common = dict(cu_seqlens_q=torch.arange(b+1, device=query.device, dtype=torch.int32)*s,
+                  seqused_k=torch.full((b,), used, device=query.device, dtype=torch.int32),
+                  cmp_residual_k=(torch.full((b,), end % ratio, device=query.device, dtype=torch.int32)
+                                  if ratio > 1 else None),
+                  max_seqlen_q=s, layout_q='TND', layout_k='PA_BBND', mask_mode=3, cmp_ratio=ratio)
+    metadata = ops.npu_quant_lightning_indexer_v2_metadata(heads, 1, dim, topk, 2,
+        batch_size=b, max_seqlen_k=used, **common)
+    selected, _, pool = ops.npu_quant_lightning_indexer_v3(q, k, weights.reshape(b*s, heads).half(),
+        q_scale, k_scale, topk, 2, block_table=table, metadata=metadata,
+        candidate_topk_index=candidates, candidate_mode=candidate_mode,
+        candidate_topk_blocks=candidate_blocks, candidate_block_size=candidate_block_size, **common)
+    if selected.shape != (b*s, 1, topk) or selected.dtype != torch.int32:
+        raise ValueError('Unexpected QLI index shape/dtype')
+    if candidate_source and (pool.shape != (b*s, 1, candidate_blocks) or pool.dtype != torch.int32):
+        raise ValueError('Unexpected QLI candidate shape/dtype')
+    selected = selected.reshape(b, s, topk)
+    visible = (torch.arange(query_start, end, device=query.device) + 1) // ratio
+    selected = torch.where((selected >= 0) & (selected < visible[None, :, None]), selected, -1)
+    return selected.long(), pool if candidate_source else candidates
