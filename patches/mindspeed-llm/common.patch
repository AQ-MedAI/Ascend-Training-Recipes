+        valid = torch.cat((local_valid, global_valid), dim=-1)
+        selected = kv[batch, gather_idx]  # [B, query_chunk, window+K, D]
+        scores = torch.einsum("bchd,bckd->bchk", q_work[:, start:stop], selected) * scale
