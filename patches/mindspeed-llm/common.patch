+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/cropped_engram_lookup.py
@@ -0,0 +1,36 @@
+"""Original hash ID -> cropped row; absent rows are zero, never modulo-remapped."""
+import torch
+from torch.nn import functional as F
+
+
+def validate_original_ids(original_ids, row_count):
+    ids=original_ids.detach().cpu()
+    if ids.dtype!=torch.int64 or ids.ndim!=1 or ids.numel()!=row_count:
+        raise ValueError('original row IDs must be int64 [selected_rows]')
+    if bool((ids<0).any()) or (len(ids)>1 and not bool((ids[1:]>ids[:-1]).all())):
+        raise ValueError('original row IDs must be nonnegative, sorted and unique')
+    return ids.clone()
+
+
+def remap_original_ids(original_ids, hashes):
+    """CPU metadata operation; -1 explicitly marks an absent original row."""
+    if hashes.dtype!=torch.int64:raise ValueError('hash IDs must be int64')
+    hashes=hashes.detach().cpu();ids=original_ids.detach().cpu()
+    if ids.numel()==0:return torch.full_like(hashes,-1)
+    positions=torch.searchsorted(ids,hashes.contiguous())
+    safe=positions.clamp(max=len(ids)-1)
+    hit=(positions<len(ids)) & (ids[safe]==hashes)
+    return safe.masked_fill(~hit,-1)
+
+
+def lookup_cropped_rows(rows, indices):
+    """Differentiable lookup. Missing entries return exact zero with zero row grad."""
+    if indices.dtype!=torch.int64:raise ValueError('row indices must be int64')
+    if bool(((indices < -1) | (indices >= len(rows))).any()):
+        raise ValueError('cropped row outside [-1, selected_rows)')
+    indices=indices.to(rows.device)
+    if len(rows)==0:
+        return rows.new_zeros((*indices.shape,rows.shape[-1]))+rows.sum()*0
+    valid=indices>=0
+    values=F.embedding(indices.clamp_min(0),rows)
+    return values.masked_fill(~valid[...,None],0)
