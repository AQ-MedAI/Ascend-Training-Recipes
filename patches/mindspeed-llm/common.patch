index 0000000000000000000000000000000000000000..2857bc7f0dd11ba0f047c7da74766b8f84cdc263
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/megatron_runtime.py
@@ -0,0 +1,99 @@
+"""DP=1/2 native MCore DDP + FP32Optimizer, explicit torch AdamW backend.
+
+No optimizer factory monkeypatch, clipping, distributed optimizer. EP=2 uses native expert groups and AllGather dispatch.
+Unused experts have zero main_grad and participate in AdamW, unlike grad=None.
+"""
+import torch
+from .schedule_adapter import validate_schedule, prepare_step
+
+
+def adamw_groups(model,weight_decay):
+    decay=[];no_decay=[]
+    for name,p in model.named_parameters():
+        if p.requires_grad:(no_decay if name.endswith('.bias') or p.ndim==1 else decay).append(p)
+    return [dict(params=decay,weight_decay=weight_decay),dict(params=no_decay,weight_decay=0.)]
+
+
+def make_torch_adamw(model,*,lr=1e-3,eps=1e-8,weight_decay=.01):
+    return torch.optim.AdamW(adamw_groups(model,weight_decay),lr=lr,eps=eps,betas=(.9,.999),foreach=False)
+
+
+def materialize_unused_gradients(model):
+    """Manual comparison only: reproduce zero main_grad semantics of DDP."""
+    names=[]
+    for name,p in model.named_parameters():
+        if p.requires_grad and p.grad is None:
+            names.append(name);p.grad=torch.zeros_like(p)
+    return names
+
+
+class DataParallelRuntime:
+    def __init__(self,model):
+        from megatron.core.distributed import DistributedDataParallel, DistributedDataParallelConfig
+        from megatron.core.optimizer.optimizer import FP32Optimizer
+        from megatron.core.optimizer.optimizer_config import OptimizerConfig
+        validate_schedule(model.config)
+        from megatron.core import parallel_state
+        dp=getattr(model.config,'dsv41_data_parallel_size',1)
+        if not torch.distributed.is_initialized() or torch.distributed.get_world_size()!=dp:
+            raise ValueError('initialize configured DP world size before constructing runtime')
+        for getter in (parallel_state.get_tensor_model_parallel_world_size,parallel_state.get_pipeline_model_parallel_world_size,parallel_state.get_context_parallel_world_size):
+            if getter()!=1:raise ValueError('runtime requires actual TP=PP=CP=1')
+        ep=getattr(model.config,'expert_model_parallel_size',1)
+        if parallel_state.get_expert_model_parallel_world_size()!=ep:raise ValueError('EP configuration/group mismatch')
+        self.dp_group=parallel_state.get_data_parallel_group()
+        if torch.distributed.get_world_size(self.dp_group)!=dp:raise ValueError('DP group does not cover world')
+        self.dp_size=dp
+        self.model=model
+        self.ddp=DistributedDataParallel(model.config,DistributedDataParallelConfig(
+            grad_reduce_in_fp32=True,overlap_grad_reduce=False,use_distributed_optimizer=False),model)
+        config=OptimizerConfig(lr=1e-3,min_lr=0.,adam_eps=1e-8,weight_decay=.01,
+            params_dtype=torch.float32,fp16=False,bf16=False,clip_grad=0.,log_num_zeros_in_grad=False)
+        self.optimizer=FP32Optimizer(make_torch_adamw(model),config,None)
+
+    def backward(self,schedule,batch):
+        self.optimizer.zero_grad(set_to_none=True)
+        self.ddp.zero_grad_buffer()
+        if any(bool(p.main_grad.count_nonzero()) for p in self.model.parameters() if p.requires_grad):
+            raise RuntimeError('main_grad buffer was not reset')
+        from .language_model import effective_loss_mask
+        local_valid=int(effective_loss_mask(batch['labels'],batch.get('loss_mask')).sum())
+        counts=torch.tensor([local_valid,batch['tokens'].numel()],dtype=torch.int64,device=batch['tokens'].device)
+        torch.distributed.all_reduce(counts,group=self.dp_group)
+        self.last_normalization=dict(local_valid_tokens=local_valid,global_valid_tokens=int(counts[0]),global_queries=int(counts[1]),dp_size=self.dp_size)
+        pieces,forward_step=prepare_step(batch,normalization=(int(counts[0]),int(counts[1]),self.dp_size))
+        previous=self.model.config.no_sync_func
+        self.model.config.no_sync_func=self.ddp.no_sync
+        try:
+            logs=schedule(forward_step_func=forward_step,data_iterator=iter(pieces),model=[self.ddp],
+                num_microbatches=len(pieces),seq_length=batch['tokens'].shape[1],micro_batch_size=1,forward_only=False)
+            self.ddp.finish_grad_sync()
+        finally:self.model.config.no_sync_func=previous
+        for p in self.model.parameters():
+            if p.requires_grad and (p.main_grad.dtype!=torch.float32 or not bool(torch.isfinite(p.main_grad).all())):
+                raise RuntimeError('invalid main_grad')
+        return sum(float(item['objective_contribution']) for item in logs)
+
+    def gradients(self):
+        return {name:p.main_grad.detach().cpu().clone() for name,p in self.model.named_parameters() if p.requires_grad}
+
+    def step(self):
+        success,_,_=self.optimizer.step()
+        if not success:raise RuntimeError('Megatron optimizer skipped the update')
+        if any(not bool(torch.isfinite(p).all()) for p in self.model.parameters()):raise RuntimeError('nonfinite parameters')
+        for state in self.optimizer.optimizer.state.values():
+            for key in ('exp_avg','exp_avg_sq'):
+                if state[key].dtype!=torch.float32 or not bool(torch.isfinite(state[key]).all()):raise RuntimeError('invalid AdamW moments')
+
+    def state_dict(self):
+        return dict(model=self.model.state_dict_for_save_checkpoint(),optimizer=self.optimizer.state_dict())
+
+    def load_state_dict(self,payload):
+        self.model.load_state_dict(payload['model'],strict=True)
+        self.optimizer.load_state_dict(payload['optimizer'])
+
+
+class SingleRankRuntime(DataParallelRuntime):
+    def __init__(self,model):
+        if getattr(model.config,'dsv41_data_parallel_size',1)!=1:raise ValueError('SingleRankRuntime requires DP=1')
+        super().__init__(model)
