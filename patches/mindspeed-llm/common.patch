+        stop = min(s, start + query_chunk_size)
+        positions = torch.arange(start, stop, device=q.device)
+        local = positions[:, None] - offsets[None, :]
+        local_valid = (local >= 0)[None].expand(b, -1, -1)
+        local = local.clamp_min(0)[None].expand(b, -1, -1)
+        global_idx = indices[:, start:stop].long()
+        global_valid = (global_idx >= 0) & ((global_idx + 1) * ratio <= positions[None, :, None] + 1)
+        # Invalid slots point to local position 0 but get zero softmax weight.
+        global_gather = torch.where(global_idx >= 0, global_idx + s, 0)
