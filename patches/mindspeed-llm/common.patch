+"""V4.1 equations using MCore linears, expert container and AllToAll dispatcher.
+
+Only scoring and the FP32 clamped/weighted SwiGLU are model-specific. There is
+no optimizer, custom process group, token transport or gradient synchronization.
+"""
+from copy import deepcopy
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+from megatron.core.tensor_parallel import ColumnParallelLinear, RowParallelLinear
+from megatron.core.transformer.module import MegatronModule
+from megatron.core.transformer.mlp import MLP, MLPSubmodules
+from megatron.core.transformer.moe.experts import SequentialMLP
+from megatron.core.transformer.moe.moe_layer import BaseMoELayer, MoELayer
+from megatron.core.transformer.moe.token_dispatcher import MoEAlltoAllTokenDispatcher
+from .moe import Gate
+
+
+class V41Router(MegatronModule):
+    def __init__(self, config, c):
+        super().__init__(config)
+        gate = Gate(c['hidden_size'], c['n_routed_experts'], c['num_experts_per_tok'],
+                    score_func=c['scoring_func'], gate_temp=c.get('gate_temp', 1.0),
+                    norm_topk_prob=c['norm_topk_prob'], route_scale=c['routed_scaling_factor'])
+        self.weight = gate.weight
+        self.weight.sequence_parallel = config.sequence_parallel
+        self.register_buffer('expert_bias', gate.bias)
+        self.topk, self.score_func, self.gate_temp = gate.topk, gate.score_func, gate.gate_temp
+        self.norm_topk_prob, self.route_scale = gate.norm_topk_prob, gate.route_scale
+        self.layer_number = None
+
+    @property
+    def bias(self):
+        return self.expert_bias
+
+    def set_layer_number(self, layer_number):
+        self.layer_number = layer_number
+
+    def forward(self, hidden_states, input_ids=None):
+        weights, indices = Gate.forward(self, hidden_states.reshape(-1, hidden_states.shape[-1]))
+        shape = (indices.shape[0], self.weight.shape[0])
+        probs = weights.new_zeros(shape).scatter(1, indices, weights)
+        routing = torch.zeros(shape, dtype=torch.bool, device=indices.device).scatter(1, indices, True)
+        return probs, routing
+
+
+class V41MLP(MLP):
+    def forward(self, hidden_states, per_token_scale=None):
+        projected, bias = self.linear_fc1(hidden_states)
+        if bias is not None:
+            raise ValueError('V4.1 requires bias-free expert linears')
+        gate, up = projected.float().chunk(2, -1)
+        limit = self.config.v41_swiglu_limit
+        if limit > 0:
+            gate, up = gate.clamp(max=limit), up.clamp(-limit, limit)
+        intermediate = F.silu(gate) * up
+        if per_token_scale is not None:
+            intermediate = intermediate * per_token_scale.unsqueeze(-1)
+        return self.linear_fc2(intermediate.to(projected.dtype))
+
+
+class V41Experts(SequentialMLP):
+    def __init__(self, num_local_experts, config):
+        config = deepcopy(config)
+        config.ffn_hidden_size = config.moe_ffn_hidden_size
+        MegatronModule.__init__(self, config)
+        self.add_bias = False
+        self.num_local_experts = num_local_experts
+        spec = MLPSubmodules(linear_fc1=ColumnParallelLinear, linear_fc2=RowParallelLinear)
+        self.local_experts = nn.ModuleList([V41MLP(config, spec, is_expert=True)
+                                           for _ in range(num_local_experts)])
+
+
+class V41SharedExpert(V41MLP):
+    def __init__(self, config):
+        config = deepcopy(config)
+        config.ffn_hidden_size = config.moe_shared_expert_intermediate_size
+        super().__init__(config, MLPSubmodules(linear_fc1=ColumnParallelLinear,
+                                             linear_fc2=RowParallelLinear))
+
+    def forward(self, hidden_states):
+        return super().forward(hidden_states)[0]
+
+
+class V41MoE(MoELayer):
+    def __init__(self, config, c, layer_number):
+        BaseMoELayer.__init__(self, config, layer_number)
+        self.moe_layer_recompute = False  # whole-block recompute is owned by the model
+        self.router = V41Router(config, c)
+        self.token_dispatcher = MoEAlltoAllTokenDispatcher(
+            self.num_local_experts, self.local_expert_indices, config=config)
+        self.experts = V41Experts(self.num_local_experts, config)
+        self.shared_experts = V41SharedExpert(config)
+        self.set_layer_number(layer_number)
