+"""Complete two-block TP + replicated-input EP bring-up, not CP or distinct-DP dispatch."""
+import torch
+from torch import nn
+from torch.nn import functional as F
+import torch.distributed as dist
+from .tensor_parallel_attention import TPAttentionPair,Copy,Sum
+from .attention_geometry import Norm,rope_angles,rotary_tail
+from .indexer import select_indices,causal_mask,masked_teacher_kl
+from .mhc import SinglePassMHC,collapse
+from .moe import Gate,Expert
+
+
+class ReplicatedInputEP(nn.Module):
+    """Each EP owner computes its experts for the same replicated token batch.
+
+    No token gathering: caller must supply identical inputs on every EP rank.
+    Output sums and backward input/router sums each occur exactly once.
+    """
+    def __init__(self,c,group,device):
+        super().__init__();self.group=group;rank=dist.get_rank(group);size=dist.get_world_size(group)
+        if c['n_routed_experts']%size:raise ValueError('experts must divide EP')
+        if c['n_shared_experts']!=1 or c.get('num_hash_layers',0) or c.get('n_group',1)!=1:raise ValueError('unsupported routing')
+        count=c['n_routed_experts']//size;self.ids=list(range(rank*count,(rank+1)*count))
+        with torch.device('meta'):
+            self.gate=Gate(c['hidden_size'],c['n_routed_experts'],c['num_experts_per_tok'],score_func=c['scoring_func'],gate_temp=c.get('gate_temp',1.),norm_topk_prob=c['norm_topk_prob'],route_scale=c['routed_scaling_factor'])
+            kw=dict(compute_dtype=torch.bfloat16,swiglu_limit=c['swiglu_limit'])
+            self.experts=nn.ModuleDict({str(i):Expert(c['hidden_size'],c['moe_intermediate_size'],**kw) for i in self.ids})
+            self.shared_experts=Expert(c['hidden_size'],c['moe_intermediate_size'],**kw)
+        self.to_empty(device=device)
+        for p in self.experts.parameters():p.allreduce=False
+        self.counts={}
+
+    def forward(self,x):
+        # Fail closed if replicas differ: this path is not an arbitrary-DP dispatcher.
+        baseline=x.detach().clone();dist.broadcast(baseline,src=dist.get_global_rank(self.group,0),group=self.group)
+        same=torch.tensor(int(torch.equal(x,baseline)),device=x.device);dist.all_reduce(same,op=dist.ReduceOp.MIN,group=self.group)
+        if not same.item():raise ValueError('replicated-input EP received different hidden states')
+        flat=x.reshape(-1,x.shape[-1]);routed_input=Copy.apply(flat.float(),self.group)
+        weights,indices=torch.func.functional_call(self.gate,{'weight':Copy.apply(self.gate.weight,self.group)},(routed_input,))
+        out=routed_input*0+weights.sum()*0;self.counts={}
+        for i in self.ids:
+            tokens,slots=torch.where(indices==i);self.counts[str(i)]=tokens.numel()
+            if tokens.numel():out=out.index_add(0,tokens,self.experts[str(i)](routed_input[tokens],weights[tokens,slots,None]).float())
+            else:
+                # Zero gradients participate in the MCore optimizer on empty owners.
+                out=out+sum(p.sum()*0 for p in self.experts[str(i)].parameters())
+        return (Sum.apply(out,self.group)+self.shared_experts(flat).float()).reshape_as(x)
+
+
+class TPFullPair(TPAttentionPair):
+    def __init__(self,model,operator,*,group,ep_group,device,precision='bfloat16'):
+        if precision!='bfloat16':raise ValueError('full pair currently requires BF16')
+        super().__init__(model,operator,group=group,device=device,precision=precision)
+        from pathlib import Path
+        import json
+        from safetensors import safe_open
+        c=self.c;self.blocks=nn.ModuleDict()
+        model=Path(model).resolve();mapping=json.loads((model/'model.safetensors.index.json').read_text())['weight_map']
+        for layer in (20,21):
+            with torch.device('meta'):
+                block=nn.ModuleDict({n:SinglePassMHC(c['hidden_size'],c['hc_mult'],iters=c['hc_sinkhorn_iters'],norm_eps=c['rms_norm_eps'],eps=c['hc_eps']) for n in ('attn_mhc','ffn_mhc')})
+                block['attn_norm']=Norm(c['hidden_size'],c['rms_norm_eps']);block['ffn_norm']=Norm(c['hidden_size'],c['rms_norm_eps'])
+            block.to_empty(device=device);block['moe']=ReplicatedInputEP(c,ep_group,device)
+            names={f'{kind}_mhc.{name}':f'hc_{kind}_{suffix}' for kind in ('attn','ffn') for name,suffix in [('hc_fn.weight','fn'),('hc_scale','scale'),('hc_base','base')]}
+            for name,p in list(block.named_parameters())+list(block.named_buffers()):
+                suffix=names.get(name,'ffn.'+name[4:] if name.startswith('moe.') else name)
+                key=f'layers.{layer}.{suffix}';path=(model/mapping[key]).resolve();path.relative_to(model)
+                with safe_open(path,framework='pt',device='cpu') as f:w=f.get_tensor(key)
+                if w.shape!=p.shape or not torch.isfinite(w).all():raise ValueError(key)
+                with torch.no_grad():p.copy_(w)
+            self.blocks[str(layer)]=block
+
+    def forward(self,x,teacher):
+        self.last={};cache=None;aux=x.sum()*0
+        # Synthetic initial streams; subsequent pre coefficients stay connected.
+        residual=x.unsqueeze(-2).expand(*x.shape[:-1],self.c['hc_mult'],x.shape[-1]).contiguous()
+        incoming=torch.full(residual.shape[:-1],1/self.c['hc_mult'],device=x.device)
+        for layer in (20,21):
+            block=self.blocks[str(layer)]
+            def attend(z):
+                nonlocal cache,aux
+                out,part,cache=self.attention(block['attn_norm'](z),teacher,layer,cache);aux=aux+part
+                return out
+            residual,incoming=block['attn_mhc'](residual,incoming,attend)
+            residual,incoming=block['ffn_mhc'](residual,incoming,lambda z:block['moe'](block['ffn_norm'](z)))
+            for name,t in [('residual',residual),('next_pre',incoming)]:
+                if t.requires_grad:t.retain_grad()
+                self.last[f'mhc_edge:{layer}:{name}']=t
+        return collapse(residual,incoming),aux
+
+    def attention(self,x,teacher,layer,cache):
+        c=self.c;b,s,_=x.shape
+        y=c['rope_scaling'];angles=rope_angles(torch.arange(s,device=x.device),c['qk_rope_head_dim'],base=c['compress_rope_theta'],original_seq_len=y['original_max_position_embeddings'],factor=y['factor'],beta_fast=y['beta_fast'],beta_slow=y['beta_slow'])
+        aux=x.float().sum()*0
+        w=lambda n:self.w(layer,n)
+        # Copy boundaries are FP32, so head gradient contributions sum before BF16 rounding.
+        qr=Copy.apply(self.norm(self.linear(x,w('wq_a.weight')),w('q_norm.weight')).float(),self.group)
+        local=rotary_tail(self.norm(self.linear(x,w('wkv.weight')),w('kv_norm.weight')),angles).unsqueeze(2)
+        if layer==20:
+            latent=self.norm(self.linear(x,w('compressor.wkv.weight')),w('compressor.norm.weight'))
+            global_kv=rotary_tail(latent,angles).unsqueeze(2).float()
+            ik=rotary_tail(self.norm(self.linear(latent,w('indexer.wk.weight')),w('indexer.k_norm.weight')),angles).float()
+            ih=c['index_n_heads']//self.tp;dim=c['index_head_dim']
+            iq=rotary_tail(self.linear(qr,w('indexer.wq_b.weight')).reshape(b,s,ih,dim),angles)
+            iw=self.linear(Copy.apply(x.float(),self.group),w('indexer.weights_proj.weight')).float()*(dim*c['index_n_heads'])**-.5
+            scores=Sum.apply((torch.einsum('bshd,bcd->bshc',iq.float(),Copy.apply(ik,self.group)).relu()*iw.unsqueeze(-1)).sum(2),self.group)
+            indices=F.pad(select_indices(scores,1,3),(0,512-min(3,s)),value=-1).long()
+            aux=masked_teacher_kl(scores,teacher,causal_mask(scores,1),coefficient=.1)
+            cache=(global_kv,indices)
+            self.last['source_kv']=global_kv;self.last['source_indices']=indices
+            if global_kv.requires_grad:global_kv.retain_grad()
+        else:
+            global_kv,indices=cache
+            self.last['same_kv_object']=global_kv is self.last['source_kv']
+            self.last['same_indices_object']=indices is self.last['source_indices']
+        dtype=torch.bfloat16 if self.precision=='bfloat16' else torch.float32
+        q=rotary_tail(self.linear(qr,w('wq_b.weight')).reshape(b,s,c['num_attention_heads']//self.tp,c['head_dim']),angles)
+        gkv=Copy.apply(global_kv,self.group).to(dtype)
+        if gkv.requires_grad:gkv.retain_grad()
+        self.last[f'{layer}_kv_edge']=gkv
+        out=self.operator(q,Copy.apply(local.float(),self.group).to(dtype),gkv,indices,w('attn_sink'),ratio=1,window=3)
+        groups=c['o_groups']//self.tp
+        a=rotary_tail(out,angles,inverse=True).reshape(b,s,groups,-1)
+        o=torch.einsum('bsgd,grd->bsgr',a,w('wo_a.weight').to(dtype).reshape(groups,c['o_lora_rank'],-1)).flatten(-2)
+        projected=self.linear(o,w('wo_b.weight')).float()
+        x=Sum.apply(projected,self.group)
+        self.last['output_dtype']=str(x.dtype)
+        self.last['attention_dtype']=str(q.dtype)
+        self.last['scores_dtype']='torch.float32'
+        return x,aux,cache
