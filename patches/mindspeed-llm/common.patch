index 0000000000000000000000000000000000000000..ccd8d751248d5311a3a55e43d4061923734546a8
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/native_model.py
@@ -0,0 +1,304 @@
+"""V4.1 model provider for the existing MindSpeed/verl training engine.
+
+PP1, real sequence-parallel MoE, contiguous CP attention. The engine owns DDP,
+optimizer/offload, scheduling and checkpoints. No legacy runtime is imported.
+"""
+import os
+from copy import copy
+from pathlib import Path
+from functools import partial
+
+import torch
+from torch import nn
+import torch.distributed as dist
+from megatron.core import parallel_state as mpu, tensor_parallel
+from megatron.core.enums import ModelType
+from megatron.core.tensor_parallel.mappings import (
+    gather_from_sequence_parallel_region, scatter_to_sequence_parallel_region,
+)
+from megatron.core.transformer.module import MegatronModule
+from megatron.core.transformer.utils import make_sharded_tensors_for_checkpoint
+from megatron.core.transformer.moe.moe_utils import MoEAuxLossAutoScaler
+
+from .native_config import attention_shapes, text_config, validate
+from .native_engram import EngramResources
+from .native_moe import V41MoE
+from .attention_geometry import Norm
+from .context_expert_parallel import Gather, gather
+from .indexer import masked_teacher_kl
+from .mhc import SinglePassMHC, collapse, initial_pre
+from .plan_parallel_backbone import PlanParallelBackbone, resolve_window_size
+from .tensor_parallel_attention import TPAttentionPair
+
+
+def replicated_sequence_parameters(module):
+    # Norm/mHC/Engram operate on disjoint SP tokens. MCore finalize_model_grads
+    # SUMs these partial parameter gradients over TP exactly once.
+    for param in module.parameters():
+        param.sequence_parallel = not getattr(param, "engram_row_sharded", False)
+
+
+class CheckpointLayerList(nn.ModuleList):
+    """Preserve each block's native TP/EP checkpoint metadata."""
+
+    def sharded_state_dict(self, prefix='', sharded_offsets=(), metadata=None):
+        state = {}
+        for index, layer in enumerate(self):
+            state.update(layer.sharded_state_dict(
+                prefix=f'{prefix}{index}.',
+                sharded_offsets=sharded_offsets,
+                metadata=metadata,
+            ))
+        return state
+
+
+class AttentionWeights(MegatronModule):
+    def __init__(self, config, c, plan):
+        super().__init__(config)
+        self.axes = {}
+        tp = mpu.get_tensor_model_parallel_world_size()
+        for name, (shape, axis) in attention_shapes(c, plan).items():
+            local_shape = list(shape)
+            if axis is not None:
+                local_shape[axis] //= tp
+                self.axes[name] = axis
+            module = self
+            *parents, leaf = name.split('.')
+            for parent in parents:
+                if not hasattr(module, parent):
+                    module.add_module(parent, nn.Module())
+                module = getattr(module, parent)
+            # Loading is delegated to mbridge after MCore creates/wraps the model.
+            param = nn.Parameter(torch.zeros(local_shape, dtype=config.params_dtype))
+            param.tensor_model_parallel = axis is not None
+            param.partition_dim = axis if axis is not None else -1
+            param.partition_stride = 1
+            module.register_parameter(leaf, param)
+
+    def sharded_state_dict(self, prefix='', sharded_offsets=(), metadata=None):
+        return make_sharded_tensors_for_checkpoint(
+            self.state_dict(keep_vars=True), prefix,
+            tensor_parallel_layers_axis_map=self.axes, sharded_offsets=sharded_offsets)
+
+
+class V41Block(MegatronModule):
+    def __init__(self, config, c, plan, engram):
+        super().__init__(config)
+        self.layer_number = plan.layer_id + 1
+        self.self_attention = AttentionWeights(config, c, plan)
+        self.input_layernorm = Norm(c['hidden_size'], c['rms_norm_eps'])
+        self.pre_mlp_layernorm = Norm(c['hidden_size'], c['rms_norm_eps'])
+        options = dict(iters=c['hc_sinkhorn_iters'], norm_eps=c['rms_norm_eps'], eps=c['hc_eps'])
+        self.attn_mhc = SinglePassMHC(c['hidden_size'], c['hc_mult'], **options)
+        self.mlp_mhc = SinglePassMHC(c['hidden_size'], c['hc_mult'], **options)
+        for module in (self.input_layernorm, self.pre_mlp_layernorm, self.attn_mhc, self.mlp_mhc):
+            replicated_sequence_parameters(module)
+        self.mlp = V41MoE(config, c, self.layer_number)
+        self.engram = engram
+        if engram is not None:
+            replicated_sequence_parameters(engram)
+
+
+class DeepseekV41Model(MegatronModule):
+    linear = TPAttentionPair.linear
+    norm = TPAttentionPair.norm
+    angles = PlanParallelBackbone.angles
+    attention = PlanParallelBackbone.attention
+
+    def __init__(self, config, hf_config, *, model_path, engram_crop=None,
+                 engram_source=None, hash_source=None, max_sequence_length=2048,
+                 engram_table_trainable=True):
+        super().__init__(config)
+        if not isinstance(engram_table_trainable, bool):
+            raise TypeError('v41_engram_table_trainable must be a boolean')
+        self.c = c = text_config(hf_config)
+        self.plans = validate(c, tp=config.tensor_model_parallel_size,
+                              cp=config.context_parallel_size, pp=config.pipeline_model_parallel_size,
+                              ep=config.expert_model_parallel_size, etp=config.expert_tensor_parallel_size)
+        if not config.sequence_parallel and config.tensor_model_parallel_size > 1:
+            raise ValueError('Native V4.1 TP+EP requires sequence_parallel=True')
+        if config.moe_shared_expert_overlap or config.moe_token_dispatcher_type != 'alltoall':
+            raise ValueError('Native V4.1 requires AllToAll and shared_expert_overlap=False')
+        self.group = mpu.get_tensor_model_parallel_group()
+        self.cp_group = mpu.get_context_parallel_group()
+        self.tp, self.rank = dist.get_world_size(self.group), dist.get_rank(self.group)
+        self.cp, self.cp_rank = dist.get_world_size(self.cp_group), dist.get_rank(self.cp_group)
+        self.precision = 'bfloat16'
+        self.topk, self.window = c['index_topk'], resolve_window_size(c)
+        self.pre_process = self.post_process = True
+        self.share_embeddings_and_output_weights = False
+        self.model_type = ModelType.encoder_or_decoder
+        self.max_sequence_length = max_sequence_length
+        from mindspeed_llm.ops.triton.dsv41_sparse_mla_offset import sparse_mla
+        self.operator = sparse_mla
+        self.hash_resources = None
+        if engram_crop:
+            if not engram_source or not hash_source:
+                raise ValueError('Cropped Engram requires original source and hash implementation')
+            self.hash_resources = EngramResources(model_path, engram_crop, engram_source,
+                                                  hash_source, max_sequence_length)
+        elif c.get('engram_layer_ids') or (engram_source and Path(engram_source, 'small_engram.json').is_file()):
+            from .full_engram import FullEngramResources
+            if not hash_source:
+                hash_source = Path(__file__).resolve().parents[6] / 'workspace/inference/engram.py'
+            self.hash_resources = FullEngramResources(engram_source or model_path,
+                hash_source, max_sequence_length, engram_table_trainable, model_path=model_path)
+        self.embedding = nn.Module()
+        emb_config = copy(config)
+        emb_config.sequence_parallel = False
+        self.embedding.word_embeddings = tensor_parallel.VocabParallelEmbedding(
+            c['vocab_size'], c['hidden_size'], config=emb_config, init_method=config.init_method)
+        self.decoder = MegatronModule(config)
+        self.decoder.layers = CheckpointLayerList()
+        for plan in self.plans:
+            engram = None
+            if self.hash_resources and plan.layer_id in self.hash_resources.layout.layer_ids:
+                engram = self.hash_resources.build(c, plan.layer_id)
+                if engram_crop:
+                    engram.rows.requires_grad_(engram_table_trainable)
+            self.decoder.layers.append(V41Block(config, c, plan, engram))
+        self.final_layernorm = Norm(c['hidden_size'], c['rms_norm_eps'])
+        replicated_sequence_parameters(self.final_layernorm)
+        self.output_layer = tensor_parallel.ColumnParallelLinear(
+            c['hidden_size'], c['vocab_size'], config=config, init_method=config.init_method,
+            bias=False, gather_output=False)
+        self.last = {}
+
+    def set_input_tensor(self, tensors):
+        if any(x is not None for x in (tensors if isinstance(tensors, list) else [tensors])):
+            raise ValueError('V4.1 cross-layer state transport across PP is not implemented')
+
+    def w(self, layer, name):
+        return self.decoder.layers[layer].self_attention.get_parameter(name)
+
+    def indexer_auxiliary(self, q, kv, indices, scores, valid, positions):
+        if self.config.v41_indexer_coefficient == 0:
+            return q.sum() * 0
+        # Detached selected-global teacher, averaged across ALL attention heads.
+        # This is an explicit training objective, not the fused QLI inference target.
+        with torch.no_grad():
+            selected = torch.zeros_like(scores, dtype=torch.int32)
+            selected.scatter_add_(-1, indices.clamp_min(0), (indices >= 0).int())
+            selected = (selected > 0) & valid
+            selected &= (positions[None, :] < self.valid_lengths[:, None])[:, :, None]
+            logits = torch.einsum('bshd,bcd->bshc', q.float(), kv[:, :, 0].float()) * q.shape[-1]**-.5
+            logits = logits.masked_fill(~selected[:, :, None], -torch.inf)
+            logits = torch.where(selected.any(-1)[:, :, None, None], logits, torch.zeros_like(logits))
+            mass = logits.softmax(-1).mean(2).masked_fill(~selected, 0)
+            dist.all_reduce(mass, group=self.group)
+            mass /= self.tp
+        # DDP averages over CP as in the existing engine. Compensate CP while
+        # normalizing by actual (not alignment-padding) queries in the sequence.
+        loss = masked_teacher_kl(scores, mass, valid, coefficient=self.config.v41_indexer_coefficient)
+        return loss * (scores.shape[0] * scores.shape[1] * self.cp / self.valid_length)
+
+    def _block(self, plan, cache_meta, hashes, constants, *inputs):
+        from mindspeed_llm.ops.triton.dsv41_sparse_mla_offset import _native_adapter
+        with _native_adapter().metadata_scope(constants['metadata']):
+            return self._block_impl(plan, cache_meta, hashes, constants['rope'], *inputs)
+
+    def _block_impl(self, plan, cache_meta, hashes, rope_cache, residual, pre, kv, keys, indices, pool):
+        block = self.decoder.layers[plan.layer_id]
+        if block.engram is not None:
+            residual = block.engram(residual, hashes)
+        state = None if cache_meta is None else dict(cache_meta, kv=kv, keys=keys,
+                                                    indices=indices, pool=None if pool.numel()==0 else pool)
+        aux = residual.float().sum() * 0
+
+        def attend(x):
+            nonlocal state, aux
+            # Input is SP. Attention uses complete CP-local queries and head TP.
+            x = gather_from_sequence_parallel_region(x.transpose(0, 1).contiguous(),
+                                                     tensor_parallel_output_grad=False).transpose(0, 1)
+            output, aux, state = self.attention(x, plan, state, rope_cache=rope_cache)
+            return scatter_to_sequence_parallel_region(output.transpose(0, 1).contiguous()).transpose(0, 1).bfloat16()
+
+        residual, pre = block.attn_mhc(residual, pre, lambda x: attend(block.input_layernorm(x)))
+        def feedforward(x):
+            output, bias = block.mlp(block.pre_mlp_layernorm(x).transpose(0, 1).contiguous().bfloat16())
+            if bias is not None:
+                raise ValueError('Unexpected MoE bias')
+            return output.transpose(0, 1)
+        residual, pre = block.mlp_mhc(residual, pre, feedforward)
+        empty = residual.new_empty(0)
+        if state is None:
+            return residual, pre, aux, empty, empty, empty.long(), empty.bool()
+        return residual, pre, aux, state['kv'], state['keys'], state['indices'], (empty.bool() if state['pool'] is None else state['pool'])
+
+    def forward(self, input_ids, position_ids=None, attention_mask=None, packed_seq_params=None, **kwargs):
+        if packed_seq_params is not None or input_ids.ndim != 2 or input_ids.shape[0] < 1:
+            raise ValueError('Native V4.1 requires a nonempty batch of unpacked sequences')
+        if position_ids is None or position_ids.shape != input_ids.shape:
+            raise ValueError('Explicit global positions are required for CP')
+        if not torch.equal(position_ids, position_ids[:1].expand_as(position_ids)):
+            raise ValueError('Padded sequences must share the same CP position grid')
+        local_length = input_ids.shape[1]
+        if local_length % (2 * self.tp):
+            raise ValueError('Local CP length must be divisible by 2*TP')
+        positions = gather(position_ids[0], self.cp_group)
+        order = positions.argsort()
+        if not torch.equal(positions[order], torch.arange(len(positions), device=positions.device)):
+            raise ValueError('CP positions do not form one complete sequence')
+        full_tokens = gather(input_ids.transpose(0, 1).contiguous(), self.cp_group)[order].transpose(0, 1)
+        if attention_mask is None:
+            raise ValueError('Validity mask is required to exclude auxiliary padding queries')
+        mask = attention_mask
+        if mask.ndim == 4:
+            mask = ~mask.diagonal(dim1=-2, dim2=-1).squeeze(1).bool()
+        if mask.shape != input_ids.shape:
+            raise ValueError('Unsupported validity mask shape')
+        full_valid = gather(mask.bool().transpose(0, 1).contiguous(), self.cp_group)[order].transpose(0, 1)
+        self.valid_lengths = full_valid.sum(dim=1)
+        expected = torch.arange(len(positions), device=positions.device)[None, :] < self.valid_lengths[:, None]
+        if bool((self.valid_lengths < 1).any()) or not torch.equal(full_valid, expected):
+            raise ValueError('Only nonempty right-padded sequences are supported')
+        self.valid_length = int(self.valid_lengths.sum())
+        start = self.cp_rank * local_length
+        hashes = self.hash_resources.hashes(full_tokens) if self.hash_resources else {}
+        x = self.embedding.word_embeddings(full_tokens[:, start:start+local_length])
+        x = scatter_to_sequence_parallel_region(x.transpose(0, 1).contiguous()).transpose(0, 1)
+        residual = x.unsqueeze(-2).expand(*x.shape[:-1], self.c['hc_mult'], x.shape[-1]).contiguous()
+        pre = initial_pre(residual)
+        empty = x.new_empty(0)
+        cache = (empty, empty, empty.long(), empty.bool())
+        meta = None
+        auxiliary = x.float().sum() * 0
+        self.last = {'layers': []}
+        # Owned by checkpoint closures, never reused by another batch.
+        constants = dict(rope={} if os.environ.get('V41_ROPE_CACHE', '1') == '1' else None,
+                         metadata={} if os.environ.get('V41_CSA2_METADATA_CACHE', '1') == '1' else None)
+        for plan in self.plans:
+            sp_start = start + self.rank * (local_length // self.tp)
+            h = hashes.get(plan.layer_id)
+            if h is not None:
+                h = h[:, sp_start:sp_start+local_length//self.tp].to(x.device)
+            function = partial(self._block, plan, meta, h, constants)
+            # KV/K are shared across checkpoint nodes; detached inputs alias them.
+            function.preserve_checkpoint_input_storage = True
+            if self.training and self.config.recompute_granularity == 'full':
+                result = tensor_parallel.checkpoint(function, False, residual, pre, *cache)
+            else:
+                result = function(residual, pre, *cache)
+            residual, pre, part, *cache = result
+            auxiliary = auxiliary + part
+            if plan.owns_kv:
+                meta = dict(kv_source=plan.layer_id, index_source=plan.layer_id)
+            elif plan.owns_indexer:
+                meta = dict(meta, index_source=plan.layer_id)
+        hidden = self.final_layernorm(collapse(residual, pre))
+        if self.training:
+            hidden = MoEAuxLossAutoScaler.apply(hidden, auxiliary)
+        # Adapt contiguous attention CP back to verl's mirrored CP ordering,
+        # communicating hidden states, never the full vocabulary logits.
+        hidden = gather_from_sequence_parallel_region(hidden.transpose(0, 1).contiguous(),
+                                                      tensor_parallel_output_grad=False)
+        hidden = Gather.apply(hidden, self.cp_group, True)[position_ids[0]]
+        hidden = scatter_to_sequence_parallel_region(hidden.contiguous())
+        logits, _ = self.output_layer(hidden.bfloat16())
+        return logits.transpose(0, 1).contiguous()
+
+
+def model_provider(pre_process=True, post_process=True, *, config, hf_config, **kwargs):
+    if not pre_process or not post_process:
+        raise ValueError('Native V4.1 provider currently requires PP=1')
+    return DeepseekV41Model(config, hf_config, **kwargs)
