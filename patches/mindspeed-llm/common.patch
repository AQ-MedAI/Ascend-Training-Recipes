@@ -0,0 +1,83 @@
+"""Dependency-free V4.1 backbone plan, using inference/config.json field names.
+
+Not a Megatron ModuleSpec or an HF-config converter. Indices are global and
+zero-based; PP-local/one-based layer numbers must be translated by the caller.
+MTP entries in compress_ratios are excluded from the backbone plan.
+"""
+from dataclasses import dataclass
+from enum import Enum
+
+
+class AttentionMode(str, Enum):
+    SWA = "swa"
+    FULL = "full"
+    REINDEX = "reindex"
+    REUSE = "reuse"
+
+
+@dataclass(frozen=True)
+class LayerPlan:
+    layer_id: int
+    ratio: int
+    mode: AttentionMode
+    kv_source: int | None
+    index_source: int | None
+    candidate_source: int | None
+
+    @property
+    def owns_kv(self):
+        return self.mode == AttentionMode.FULL
+
+    @property
+    def owns_indexer(self):
+        return self.mode in (AttentionMode.FULL, AttentionMode.REINDEX)
+
+
+def build_layer_plan(config):
+    """Validate producer/consumer ordering before constructing model weights."""
+    n = config["n_layers"]
+    ratios = config["compress_ratios"]
+    if n <= 0 or len(ratios) < n:
+        raise ValueError("compress_ratios must cover all backbone layers")
+
+    def source_set(name):
+        values = list(config[name])
+        if len(values) != len(set(values)) or any(x < 0 or x >= n for x in values):
+            raise ValueError(f"{name}: duplicate or out-of-backbone layer")
+        return set(values)
+
+    kv_sources = source_set("kv_source_layers")
+    index_sources = source_set("index_source_layers")
+    if not kv_sources <= index_sources:
+        raise ValueError("each new KV source must also refresh index keys and indices")
+    candidate = config.get("candidate_source_layer", -1)
+    if candidate >= 0:
+        if candidate not in kv_sources:
+            raise ValueError("candidate source must own global KV and an indexer")
+        if config.get("candidate_topk_blocks", 0) <= 0 or config.get("candidate_block_size", 0) <= 0:
+            raise ValueError("candidate pool sizes must be positive")
+    plans = []
+    active_kv = active_index = None
+    for i, ratio in enumerate(ratios[:n]):
+        if ratio not in (0, 1, 2):
+            raise ValueError(f"layer {i}: unsupported V4.1 ratio {ratio}")
+        if ratio == 0:
+            if i in kv_sources or i in index_sources:
+                raise ValueError(f"layer {i}: SWA-only layer cannot be a global source")
+            plans.append(LayerPlan(i, ratio, AttentionMode.SWA, None, None, None))
+            continue
+        if i in kv_sources:
+            active_kv = i
+        if active_kv is None or ratios[active_kv] != ratio:
+            raise ValueError(f"layer {i}: no preceding KV source with matching ratio")
+        if i in index_sources:
+            active_index = i
+        if active_index is None or active_index < active_kv:
+            raise ValueError(f"layer {i}: missing fresh indices for current KV source")
+        pool = candidate if candidate >= 0 and i >= candidate else None
+        if pool is not None and active_kv != candidate:
+            raise ValueError("candidate pool cannot silently survive a change of global KV source")
+        mode = (AttentionMode.FULL if i in kv_sources else
+                AttentionMode.REINDEX if i in index_sources else AttentionMode.REUSE)
+        plans.append(LayerPlan(i, ratio, mode, active_kv, active_index, pool))
+    return tuple(plans)
diff --git a/mindspeed_llm/tasks/models/transformer/deepseek41/attention_geometry.py b/mindspeed_llm/tasks/models/transformer/deepseek41/attention_geometry.py
new file mode 100644
index 0000000000000000000000000000000000000000..468cbc29455d22051e1731dca1673aa440f22a3c
--- /dev/null
+++ b/mindspeed_llm/tasks/models/transformer/deepseek41/attention_geometry.py
@@ -0,0 +1,133 @@
+"""Unquantized, single-rank attention geometry from inference/model.py.
+
+Adjacent-pair RoPE on the tail, group-start global positions, inverse output
+RoPE, low-rank Q and grouped low-rank output. Not a complete model or Indexer.
+"""
+import math
+import os
+import torch
+from torch import nn
+
+
+def rope_angles(positions, dim, *, base=160000., original_seq_len=65536,
+                factor=16., beta_fast=32., beta_slow=1.):
+    if dim < 2 or dim % 2 or base <= 1 or factor <= 0 or min(beta_fast, beta_slow) <= 0:
+        raise ValueError("invalid rotary configuration")
+    frequencies = 1 / base ** (torch.arange(0, dim, 2, device=positions.device, dtype=torch.float32) / dim)
+    if original_seq_len > 0:
+        def corrected(rotations):
+            return dim * math.log(original_seq_len / (rotations*2*math.pi)) / (2*math.log(base))
+        low, high = max(math.floor(corrected(beta_fast)), 0), min(math.ceil(corrected(beta_slow)), dim-1)
+        ramp = ((torch.arange(dim//2, device=positions.device) - low) / max(high-low, 1e-3)).clamp(0, 1)
+        frequencies = frequencies / factor * ramp + frequencies * (1-ramp)
+    return positions.float()[:, None] * frequencies[None, :]
+
+
+def rms_norm(x, weight, eps):
+    backend = os.environ.get('V41_RMSNORM_BACKEND', 'native')
+    if backend not in ('native', 'reference'):
+        raise ValueError('V41_RMSNORM_BACKEND must be native or reference')
+    work = torch.float64 if x.dtype == torch.float64 else torch.float32
+    y = x.to(work)
+    if backend == 'native' and x.device.type == 'npu' and work == torch.float32:
+        import torch_npu
+        # Preserve reference FP32 normalization AND weight multiplication before
+        # rounding to the activation dtype. Casts retain parameter gradients.
+        return torch_npu.npu_rms_norm(y, weight.float(), epsilon=eps)[0].to(x.dtype)
+    return (y * torch.rsqrt(y.square().mean(-1, keepdim=True) + eps) * weight).to(x.dtype)
+
+
+def _rotary_reference(x, angles, inverse=False):
+    cached = isinstance(angles, tuple)
+    base = angles[0] if cached else angles
+    rd = base.shape[-1]*2
+    if x.ndim not in (3, 4) or rd > x.shape[-1] or x.shape[1] != base.shape[0]:
+        raise ValueError("rotary shape mismatch")
+    work = torch.float64 if x.dtype == torch.float64 else torch.float32
+    tail = x[..., -rd:].to(work).unflatten(-1, (-1, 2))
+    shape = (1, x.shape[1]) + (1,) * (x.ndim-3) + (rd//2,)
+    if cached:
+        cos, sin = (v.to(work).reshape(shape) for v in angles)
+    else:
+        cos, sin = angles.to(work).cos().reshape(shape), angles.to(work).sin().reshape(shape)
+    if inverse:
+        sin = -sin
+    a, b = tail[..., 0], tail[..., 1]
+    rotated = torch.stack((a*cos-b*sin, a*sin+b*cos), -1).flatten(-2)
+    return torch.cat((x[..., :-rd], rotated.to(x.dtype)), -1)
+
+
+class _RotaryTail(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, cos, sin, inverse):
+        ctx.save_for_backward(cos, sin)
+        ctx.inverse = inverse
+        return _rotary_reference(x, (cos, sin), inverse)
+
+    @staticmethod
+    def backward(ctx, grad):
+        cos, sin = ctx.saved_tensors
+        # The transpose of the rotation is the opposite rotation, including
+        # the identity prefix. Avoid SelectBackward strided gradient writes.
+        return _rotary_reference(grad, (cos, sin), not ctx.inverse), None, None, None
+
+
+def rotary_tail(x, angles, inverse=False):
+    if os.environ.get('V41_ROPE_BACKWARD', 'explicit') == 'reference':
+        return _rotary_reference(x, angles, inverse)
+    values = angles if isinstance(angles, tuple) else (angles,)
+    if any(v.requires_grad for v in values):
+        return _rotary_reference(x, angles, inverse)
+    work = torch.float64 if x.dtype == torch.float64 else torch.float32
+    cos, sin = angles if isinstance(angles, tuple) else (angles.to(work).cos(), angles.to(work).sin())
+    return _RotaryTail.apply(x, cos, sin, inverse)
+
+
+class Norm(nn.Module):
+    def __init__(self, dim, eps):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(dim))
+        self.eps = eps
+
+    def forward(self, x):
+        return rms_norm(x, self.weight, self.eps)
+
+
+class AttentionGeometry(nn.Module):
+    def __init__(self, dim, heads, head_dim, q_rank, groups, o_rank, rope_dim, eps=1e-20):
+        super().__init__()
+        if min(dim, heads, head_dim, q_rank, groups, o_rank) < 1 or heads % groups or rope_dim > head_dim or rope_dim < 2 or rope_dim % 2:
+            raise ValueError("invalid attention dimensions")
+        self.heads, self.head_dim, self.groups, self.o_rank, self.rope_dim = heads, head_dim, groups, o_rank, rope_dim
+        self.wq_a, self.wq_b = nn.Linear(dim, q_rank, bias=False), nn.Linear(q_rank, heads*head_dim, bias=False)
+        self.q_norm, self.kv_norm = Norm(q_rank, eps), Norm(head_dim, eps)
+        self.wkv = nn.Linear(dim, head_dim, bias=False)
+        self.wo_a = nn.Linear(heads*head_dim//groups, groups*o_rank, bias=False)
+        self.wo_b = nn.Linear(groups*o_rank, dim, bias=False)
+        self.attn_sink = nn.Parameter(torch.zeros(heads))
+
+    def project_output(self, output, *, compute_dtype=None):
+        grouped = output.flatten(-2).unflatten(-1, (self.groups, -1))
+        weights = self.wo_a.weight.reshape(self.groups, self.o_rank, -1)
+        if compute_dtype is not None:
+            grouped, weights = grouped.to(compute_dtype), weights.to(compute_dtype)
+        projected = torch.einsum("bsgd,grd->bsgr", grouped, weights).flatten(-2)
+        if compute_dtype is not None:
+            return torch.nn.functional.linear(projected, self.wo_b.weight.to(compute_dtype))
+        return self.wo_b(projected)
+
+    def forward(self, x, shared, indices, operator, *, ratio, source, select=None, observe=None):
+        angles = rope_angles(torch.arange(x.shape[1], device=x.device), self.rope_dim)
+        qr = self.q_norm(self.wq_a(x))
+        if select is not None:
+            # Source callback sees the latent BEFORE attention RoPE.
+            indices = select(x, qr, shared)
+        q = rotary_tail(self.wq_b(qr).unflatten(-1, (self.heads, self.head_dim)), angles)
+        local = rotary_tail(self.kv_norm(self.wkv(x)), angles).unsqueeze(2)
+        if source:
+            positions = torch.arange(shared.shape[1], device=x.device)*ratio
+            shared = rotary_tail(shared, rope_angles(positions, self.rope_dim))
+        if observe is not None:
+            observe(q, shared, indices)
+        output = operator(q, local, shared, indices, self.attn_sink, ratio=ratio, window=3)
+        return self.project_output(rotary_tail(output, angles, inverse=True)), shared
