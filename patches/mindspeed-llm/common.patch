@@ -0,0 +1,322 @@
+"""Local-query CSA2 diagnostic with full KV and absolute query_start offset."""
+import importlib.util
+from functools import lru_cache
+import math
+import os
+from pathlib import Path
+
+_CAPTURED = False
+
+import torch
+import torch_npu  # noqa: F401 -- register the NPU device
+import triton
+import triton.language as tl
+from torch.autograd.function import once_differentiable
+
+
+@lru_cache(maxsize=1)
+def _native_adapter():
+    # Also works when this kernel is loaded directly by the standalone probes.
+    path = Path(__file__).with_name('dsv41_native_sparse_mla.py')
+    spec = importlib.util.spec_from_file_location('dsv41_native_sparse_mla', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@triton.jit
+def _rows(Indices, batch, pos, slots, S: tl.constexpr, K: tl.constexpr,
+          W: tl.constexpr, R: tl.constexpr, T: tl.constexpr, O: tl.constexpr):
+    index = tl.load(Indices + (batch * S + pos) * K + slots - W,
+                    mask=(slots >= W) & (slots < W + K), other=-1)
+    local = pos + O - slots
+    valid = tl.where(slots < W, local >= 0,
+                     (slots < W + K) & (index >= 0) & ((index + 1) * R <= pos + O + 1))
+    row = tl.where(slots < W, local, T + index)
+    return tl.maximum(row, 0), valid
+
+
+@triton.jit
+def _forward(Q, KV, Indices, Sink, Out, LSE, S: tl.constexpr, H: tl.constexpr,
+             D: tl.constexpr, C: tl.constexpr, T: tl.constexpr, O: tl.constexpr, K: tl.constexpr, W: tl.constexpr,
+             R: tl.constexpr, SCALE: tl.constexpr, HAS_SINK: tl.constexpr,
+             BD: tl.constexpr, BK: tl.constexpr, N_TASKS: tl.constexpr, HEAD_MAJOR: tl.constexpr, SKIP_EMPTY: tl.constexpr):
+    # Bound the launch grid; each program owns disjoint query/head tasks.
+    for pid in range(tl.program_id(0), N_TASKS, tl.num_programs(0)):
+        if HEAD_MAJOR:
+            pos, head, batch = pid % S, (pid // S) % H, pid // (H * S)
+        else:
+            head, pos, batch = pid % H, (pid // H) % S, pid // (H * S)
+        # Scheduling order may change; tensor storage is always BSHD.
+        row_id = (batch * S + pos) * H + head
+        dims = tl.arange(0, BD)
+        q = tl.load(Q + row_id * D + dims, dims < D, other=0).to(tl.float32)
+        # Local slot zero is always valid, so the first tile has a finite maximum.
+        maximum = tl.full((), -float("inf"), tl.float32)
+        denominator = tl.full((), 0, tl.float32)
+        numerator = tl.full((BD,), 0, tl.float32)
+        if HAS_SINK:
+            maximum = tl.load(Sink + head).to(tl.float32)
+            denominator = tl.full((), 1, tl.float32)
+        for start in range(triton.cdiv(W + K, BK)):
+            slots = start * BK + tl.arange(0, BK)
+            rows, valid = _rows(Indices, batch, pos, slots, S, K, W, R, T, O)
+            # A tile with no valid rows contributes neither softmax mass nor gradients.
+            # Default specialization keeps the original unconditional computation.
+            active = tl.full((), True, tl.int1)
+            if SKIP_EMPTY == 1:
+                active = tl.sum(valid.to(tl.int32), 0) > 0
+            elif SKIP_EMPTY == 2:
+                # Heuristic only: later queries still retain every original mask.
+                # Arbitrary holes there are computed normally, never assumed valid.
+                if pos + O + 1 < max(W, R * K):
+                    active = tl.sum(valid.to(tl.int32), 0) > 0
+            if active:
+                values = tl.load(KV + (batch * (T + C) + rows[:, None]) * D + dims[None, :],
+                                 valid[:, None] & (dims[None, :] < D), other=0).to(tl.float32)
+                scores = tl.sum(values * q[None, :], 1) * SCALE
+                scores = tl.where(valid, scores, -float("inf"))
+                new_max = tl.maximum(maximum, tl.max(scores, 0))
+                correction = tl.exp(maximum - new_max)
+                p = tl.exp(scores - new_max)
+                numerator = numerator * correction + tl.sum(p[:, None] * values, 0)
+                denominator = denominator * correction + tl.sum(p, 0)
+                maximum = new_max
+        tl.store(Out + row_id * D + dims, numerator / denominator, dims < D)
+        tl.store(LSE + row_id, maximum + tl.log(denominator))
+
+
+@triton.jit
+def _forward_shared_heads(Q, KV, Indices, Sink, Out, LSE, S: tl.constexpr, H: tl.constexpr,
+                          D: tl.constexpr, C: tl.constexpr, T: tl.constexpr, O: tl.constexpr,
+                          K: tl.constexpr, W: tl.constexpr, R: tl.constexpr,
+                          SCALE: tl.constexpr, HAS_SINK: tl.constexpr,
+                          BD: tl.constexpr, BK: tl.constexpr, N_TASKS: tl.constexpr,
+                          HEAD_MAJOR: tl.constexpr, SKIP_EMPTY: tl.constexpr, BH: tl.constexpr):
+    # All heads of one query use identical sparse rows. Load KV once per tile,
+    # broadcast over BH Q vectors, and keep independent FP32 softmax states.
+    groups = triton.cdiv(H, BH)
+    for pid in range(tl.program_id(0), N_TASKS, tl.num_programs(0)):
+        if HEAD_MAJOR:
+            pos, group, batch = pid % S, (pid // S) % groups, pid // (groups * S)
+        else:
+            group, pos, batch = pid % groups, (pid // groups) % S, pid // (groups * S)
+        heads = group * BH + tl.arange(0, BH)
+        dims = tl.arange(0, BD)
+        row_ids = (batch * S + pos) * H + heads
+        mask_q = (heads[:, None] < H) & (dims[None, :] < D)
+        q = tl.load(Q + row_ids[:, None] * D + dims[None, :], mask_q, other=0).to(tl.float32)
+        maximum = tl.full((BH,), -float('inf'), tl.float32)
+        denominator = tl.full((BH,), 0, tl.float32)
+        numerator = tl.full((BH, BD), 0, tl.float32)
+        if HAS_SINK:
+            maximum = tl.load(Sink + heads, heads < H, other=0).to(tl.float32)
+            denominator = tl.full((BH,), 1, tl.float32)
+        for start in range(triton.cdiv(W + K, BK)):
+            slots = start * BK + tl.arange(0, BK)
+            rows, valid = _rows(Indices, batch, pos, slots, S, K, W, R, T, O)
+            active = tl.full((), True, tl.int1)
+            if SKIP_EMPTY == 1:
+                active = tl.sum(valid.to(tl.int32), 0) > 0
+            elif SKIP_EMPTY == 2:
+                if pos + O + 1 < max(W, R * K):
+                    active = tl.sum(valid.to(tl.int32), 0) > 0
+            if active:
+                values = tl.load(KV + (batch * (T + C) + rows[:, None]) * D + dims[None, :],
+                                 valid[:, None] & (dims[None, :] < D), other=0).to(tl.float32)
+                scores = tl.sum(q[:, None, :] * values[None, :, :], 2) * SCALE
+                scores = tl.where(valid[None, :], scores, -float('inf'))
+                new_max = tl.maximum(maximum, tl.max(scores, 1))
+                correction = tl.exp(maximum - new_max)
+                p = tl.exp(scores - new_max[:, None])
+                numerator = numerator * correction[:, None] + tl.sum(p[:, :, None] * values[None, :, :], 1)
+                denominator = denominator * correction + tl.sum(p, 1)
+                maximum = new_max
+        tl.store(Out + row_ids[:, None] * D + dims[None, :], numerator / denominator[:, None], mask_q)
+        tl.store(LSE + row_ids, maximum + tl.log(denominator), heads < H)
+
+
+@triton.jit
+def _backward(Q, KV, Indices, Sink, Out, LSE, DO, DQ, DKV, DSink,
+              S: tl.constexpr, H: tl.constexpr, D: tl.constexpr, C: tl.constexpr, T: tl.constexpr, O: tl.constexpr,
+              K: tl.constexpr, W: tl.constexpr, R: tl.constexpr,
+              SCALE: tl.constexpr, HAS_SINK: tl.constexpr, BD: tl.constexpr, BK: tl.constexpr, N_TASKS: tl.constexpr, HEAD_MAJOR: tl.constexpr, SKIP_EMPTY: tl.constexpr, RECOMPUTE_DELTA: tl.constexpr):
+    # Bound the launch grid; each program owns disjoint query/head tasks.
+    for pid in range(tl.program_id(0), N_TASKS, tl.num_programs(0)):
+        if HEAD_MAJOR:
+            pos, head, batch = pid % S, (pid // S) % H, pid // (H * S)
+        else:
+            head, pos, batch = pid % H, (pid // H) % S, pid // (H * S)
+        # Scheduling order may change; tensor storage is always BSHD.
+        row_id = (batch * S + pos) * H + head
+        dims = tl.arange(0, BD)
+        q = tl.load(Q + row_id * D + dims, dims < D, other=0).to(tl.float32)
+        g = tl.load(DO + row_id * D + dims, dims < D, other=0).to(tl.float32)
+        lse = tl.load(LSE + row_id)
+        if RECOMPUTE_DELTA:
+            # Native output is BF16. Reconstruct g.O = sum_j p_j (g.V_j)
+            # in FP32, rather than using the rounded output in the derivative.
+            delta = tl.full((), 0, tl.float32)
+            for start in range(triton.cdiv(W + K, BK)):
+                slots = start * BK + tl.arange(0, BK)
+                rows, valid = _rows(Indices, batch, pos, slots, S, K, W, R, T, O)
+                if tl.sum(valid.to(tl.int32), 0) > 0:
+                    values = tl.load(KV + (batch * (T + C) + rows[:, None]) * D + dims[None, :],
+                                     valid[:, None] & (dims[None, :] < D), other=0).to(tl.float32)
+                    scores = tl.sum(values * q[None, :], 1) * SCALE
+                    p = tl.where(valid, tl.exp(scores - lse), 0.)
+                    delta += tl.sum(p * tl.sum(values * g[None, :], 1), 0)
+        else:
+            out = tl.load(Out + row_id * D + dims, dims < D, other=0)
+            delta = tl.sum(g * out, 0)  # FP32 output, before BF16 cast
+        dq = tl.full((BD,), 0, tl.float32)
+        for start in range(triton.cdiv(W + K, BK)):
+            slots = start * BK + tl.arange(0, BK)
+            rows, valid = _rows(Indices, batch, pos, slots, S, K, W, R, T, O)
+            # A tile with no valid rows contributes neither softmax mass nor gradients.
+            # Default specialization keeps the original unconditional computation.
+            active = tl.full((), True, tl.int1)
+            if SKIP_EMPTY == 1:
+                active = tl.sum(valid.to(tl.int32), 0) > 0
+            elif SKIP_EMPTY == 2:
+                # Heuristic only: later queries still retain every original mask.
+                # Arbitrary holes there are computed normally, never assumed valid.
+                if pos + O + 1 < max(W, R * K):
+                    active = tl.sum(valid.to(tl.int32), 0) > 0
+            if active:
+                offsets = (batch * (T + C) + rows[:, None]) * D + dims[None, :]
+                mask = valid[:, None] & (dims[None, :] < D)
+                values = tl.load(KV + offsets, mask, other=0).to(tl.float32)
+                scores = tl.sum(values * q[None, :], 1) * SCALE
+                p = tl.where(valid, tl.exp(scores - lse), 0.)
+                dp = tl.sum(values * g[None, :], 1)
+                ds = p * (dp - delta)
+                dq += tl.sum(ds[:, None] * values, 0) * SCALE
+                dvalues = ds[:, None] * q[None, :] * SCALE + p[:, None] * g[None, :]
+                tl.atomic_add(DKV + offsets, dvalues, mask=mask)
+        tl.store(DQ + row_id * D + dims, dq, dims < D)
+        if HAS_SINK:
+            psink = tl.exp(tl.load(Sink + head).to(tl.float32) - lse)
+            tl.atomic_add(DSink + head, -psink * delta)
+
+
+class _CSA2(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, q, ori, cmp, indices, sink, ratio, window, scale, query_start):
+        b, s, h, d = q.shape
+        backend = os.environ.get('V41_CSA2_FORWARD_BACKEND', 'triton')
+        if backend not in ('triton', 'native'):
+            raise ValueError('V41_CSA2_FORWARD_BACKEND must be triton or native')
+        ctx.native_window = window
+        ctx.backward_backend = os.environ.get('V41_CSA2_BACKWARD_BACKEND', 'triton')
+        if ctx.backward_backend not in ('triton', 'native'):
+            raise ValueError('V41_CSA2_BACKWARD_BACKEND must be triton or native')
+        if ctx.backward_backend == 'native' and backend != 'native':
+            raise ValueError('Native backward requires native forward')
+        q, indices = q.contiguous(), indices.contiguous()
+        kv = torch.cat((ori, cmp), 1).squeeze(2).contiguous()
+        sink_buffer = q.new_empty(0, dtype=torch.float32) if sink is None else sink.contiguous()
+        if backend == 'triton':
+            output = torch.empty(q.shape, device=q.device, dtype=torch.float32)
+            lse = torch.empty((b, s, h), device=q.device, dtype=torch.float32)
+        heads_per_program = int(os.environ.get('V41_CSA2_FORWARD_HEADS', '1'))
+        if heads_per_program not in (1, 2):
+            raise ValueError('V41_CSA2_FORWARD_HEADS must be 1 or 2')
+        forward_bk = int(os.environ.get('V41_CSA2_FORWARD_BK', '16'))
+        backward_bk = int(os.environ.get('V41_CSA2_BACKWARD_BK', '16'))
+        order = os.environ.get('V41_CSA2_TASK_ORDER', 'query')
+        if forward_bk not in (16, 32, 64) or backward_bk not in (16, 32, 64):
+            raise ValueError('CSA2 BK must be 16, 32 or 64')
+        if order not in ('query', 'head'):
+            raise ValueError('CSA2 task order must be query or head')
+        skip_mode = int(os.environ.get('V41_CSA2_SKIP_EMPTY', '0'))
+        if skip_mode not in (0, 1, 2):
+            raise ValueError('V41_CSA2_SKIP_EMPTY must be 0 (off), 1 (all), or 2 (early queries)')
+        # Full late-query partitions use exactly the baseline specialization.
+        # This avoids paying a per-tile predicate in the CP tail partition.
+        if skip_mode == 2 and query_start + 1 >= max(min(window, ori.shape[1]), ratio * indices.shape[-1]):
+            skip_mode = 0
+        options = dict(S=s, T=ori.shape[1], O=query_start, H=h, D=d, C=cmp.shape[1], K=indices.shape[-1],
+                       W=min(window, ori.shape[1]), R=ratio, SCALE=scale, HAS_SINK=sink is not None,
+                       BD=triton.next_power_of_2(d), BK=forward_bk, N_TASKS=b*s*h, HEAD_MAJOR=order == 'head',
+                       SKIP_EMPTY=skip_mode)
+        if backend == 'native':
+            output, lse = _native_adapter().native_forward(q, ori, cmp, indices, sink, ratio=ratio,
+                                            window=window, scale=scale, query_start=query_start)
+        elif heads_per_program == 1:
+            _forward[(min(b*s*h, 65535),)](q, kv, indices, sink_buffer, output, lse, **options)
+        else:
+            # Smaller KV tile bounds the BH*BK*BD temporary. Experimental only;
+            # target compiler UB allocation still needs NPU validation.
+            tasks = b * s * triton.cdiv(h, heads_per_program)
+            shared_options = dict(options, BK=8, BH=heads_per_program, N_TASKS=tasks)
+            _forward_shared_heads[(min(tasks, 65535),)](
+                q, kv, indices, sink_buffer, output, lse, **shared_options)
+        ctx.save_for_backward(q, kv, indices, sink_buffer, output, lse)
+        ctx.options = dict(options, BK=backward_bk, RECOMPUTE_DELTA=backend == 'native')
+        return output.to(q.dtype)
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, dout):
+        q, kv, indices, sink, output, lse = ctx.saved_tensors
+        if ctx.backward_backend == 'native':
+            o = ctx.options
+            t = o['T']
+            dq, dori, dcmp, dsink = _native_adapter().native_backward(
+                q, kv[:, :t, None], kv[:, t:, None], indices,
+                sink if o['HAS_SINK'] else None, output, lse, dout,
+                ratio=o['R'], window=ctx.native_window,
+                scale=o['SCALE'], query_start=o['O'])
+            return dq, dori, dcmp, None, dsink, None, None, None, None
+        dq = torch.empty_like(q)
+        dkv = torch.zeros_like(kv, dtype=torch.float32)
+        dsink = torch.zeros_like(sink, dtype=torch.float32)
+        _backward[(min(lse.numel(), 65535),)](q, kv, indices, sink, output, lse, dout.contiguous(),
+                                 dq, dkv, dsink, **ctx.options)
+        s = ctx.options["T"]
+        return (dq, dkv[:, :s, None].to(kv.dtype), dkv[:, s:, None].to(kv.dtype), None,
+                dsink.to(sink.dtype) if ctx.options["HAS_SINK"] else None, None, None, None, None)
+
+
+def sparse_mla(q, ori, cmp, indices, sink=None, *, ratio, window=128, scale=None, query_start=0):
+    """Experimental entry; validates indices synchronously. No silent fallback."""
+    if q.ndim != 4 or min(q.shape) < 1:
+        raise ValueError("q must be nonempty BSND")
+    b, s, h, d = q.shape
+    if ratio not in (1, 2, 4) or window < 1 or d > 512:
+        raise ValueError("require ratio=1/2/4, positive window and D<=512")
+    if not isinstance(query_start,int) or query_start<0:raise ValueError('invalid query_start')
+    t=ori.shape[1]
+    if ori.shape!=(b,t,1,d) or query_start+s>t or cmp.shape not in ((b,t//ratio,1,d),(b,0,1,d)):
+        raise ValueError('KV/query range mismatch')
+    if indices.ndim != 3 or indices.shape[:2] != (b, s) or indices.dtype not in (torch.int32, torch.int64):
+        raise ValueError("indices must be integer [B,S,K]")
+    if sink is not None and (sink.shape != (h,) or sink.dtype != torch.float32):
+        raise ValueError("sink must be FP32 [H]")
+    tensors = (ori, cmp, indices) + (() if sink is None else (sink,))
+    if q.device.type != "npu" or any(t.device != q.device for t in tensors):
+        raise ValueError("all inputs must be on the same NPU")
+    if q.dtype not in (torch.float32, torch.bfloat16, torch.float16) or ori.dtype != q.dtype or cmp.dtype != q.dtype:
+        raise ValueError("q/ori/cmp must share FP32/BF16/FP16 dtype")
+    if os.environ.get('V41_CSA2_VALIDATE_INDICES', '1') != '0' and bool(((indices < -1) | (indices >= cmp.shape[1])).any()):
+        raise ValueError("global index out of bounds")
+    scale = d ** -0.5 if scale is None else float(scale)
+    if not math.isfinite(scale):
+        raise ValueError("scale must be finite")
+    if torch.are_deterministic_algorithms_enabled():
+        raise RuntimeError("experimental CSA2 uses nondeterministic FP32 atomic adds")
+    global _CAPTURED
+    capture = os.environ.get('V41_CSA2_CAPTURE_DIR')
+    rank = os.environ.get('RANK', '0')
+    ranks = os.environ.get('V41_CSA2_CAPTURE_RANKS', '0,8').split(',')
+    if capture and not _CAPTURED and rank in ranks and indices.shape[-1] > 0:
+        target = Path(capture)
+        target.mkdir(parents=True, exist_ok=True)
+        payload = {name: value.detach().cpu() if value is not None else None
+                   for name, value in zip(('q', 'ori', 'cmp', 'indices', 'sink'),
+                                          (q, ori, cmp, indices, sink))}
+        payload.update(ratio=ratio, window=window, scale=scale, query_start=query_start)
+        torch.save(payload, target / f'csa2-rank{rank}-pid{os.getpid()}.pt')
+        _CAPTURED = True
+    return _CSA2.apply(q, ori, cmp, indices, sink, ratio, window, scale, query_start)
