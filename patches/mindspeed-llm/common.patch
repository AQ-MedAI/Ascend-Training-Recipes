@@ -0,0 +1,37 @@
+"""Reuse CANN experimental Single-Pass autograd without a second backward.
+
+Audited source: hicann/ops-transformer 1461cca857ff3b2018404c0275e80e7aa13a3fc9.
+Requires the matching installed custom operator package, including backward.
+"""
+from functools import lru_cache
+from importlib import import_module
+import torch
+
+
+@lru_cache(None)
+def premix_function():
+    package = 'cann_ops_transformer_custom.ops.mhc'
+    try:
+        forward = import_module(package + '.mhc_pre_sinkhorn_premix.mhc_pre_sinkhorn_premix')
+        import_module(package + '.mhc_pre_sinkhorn_premix_backward.mhc_pre_sinkhorn_premix_backward')
+    except ImportError as exc:
+        raise RuntimeError('Install CANN experimental MhcPreSinkhornPremix and '
+                           'MhcPreSinkhornPremixBackward with their custom torch extension; '
+                           'the ordinary cann_ops_transformer MHC package is insufficient') from exc
+    return forward.MhcPreSinkhornPremixFunction
+
+
+def premix(x, weight, scale, base, incoming_pre, *, iters=20, eps=1e-6, norm_eps=1e-6):
+    if x.ndim != 4 or x.shape[-2] != 4 or iters != 20:
+        raise ValueError('A2/A3 Premix requires BSND, four streams and 20 iterations')
+    if x.dtype not in (torch.bfloat16, torch.float16):
+        raise ValueError('Premix residual must be BF16 or FP16')
+    if incoming_pre.shape != x.shape[:-1]:
+        raise ValueError('Premix incoming pre shape mismatch')
+    # Call the upstream Function directly: the public convenience wrapper drops
+    # hPre when all inputs are frozen, but Single-Pass always needs it downstream.
+    hin, post, comb, next_pre = premix_function().apply(
+        x.contiguous(), weight.float().contiguous(), scale.float().contiguous(),
+        base.float().contiguous(), incoming_pre.float().contiguous(),
+        4, iters, eps, norm_eps)
+    return hin, post, comb.reshape(*x.shape[:-1], 4), next_pre
