@@ -0,0 +1,141 @@
+"""V4.1 text bridge. Reuses mbridge TP/EP loading/export and MCore checkpoints."""
+import re
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+from megatron.core.transformer import TransformerConfig
+from ..core import LLMBridge, register_model
+from ..core.safetensor_io import SafeTensorIO
+from ..core.util import unwrap_model
+
+
+class V41TensorIO(SafeTensorIO):
+    def __init__(self, path, crop=None, engram_source=None):
+        super().__init__(path)
+        self.crop = Path(crop) if crop else None
+        self.engram_source = engram_source
+        if not self.index and (Path(path)/'quant_model_weights.safetensors.index.json').exists():
+            import json
+            self.index = json.loads((Path(path)/'quant_model_weights.safetensors.index.json').read_text())['weight_map']
+
+    def load_some_hf_weight(self, names):
+        output = {}
+        regular = []
+        for name in names:
+            match = re.fullmatch(r'layers\.(\d+)\.engram\.(.+)', name)
+            if match and self.crop is not None:
+                layer, suffix = match.groups()
+                with safe_open(self.crop/'engram.safetensors', framework='pt', device='cpu') as f:
+                    output[name] = f.get_tensor(layer + '.' + suffix)
+            elif match and self.engram_source:
+                from mindspeed_llm.tasks.models.transformer.deepseek41.full_engram_io import source_file
+                with safe_open(source_file(self.engram_source, name), framework='pt', device='cpu') as f:
+                    output[name] = f.get_tensor(name)
+            else:
+                regular.append(name)
+        if regular:
+            output.update(super().load_some_hf_weight(regular))
+        return output
+
+
+@register_model(['deepseek_v41', 'deepseek_v4_1'])
+class DeepseekV41Bridge(LLMBridge):
+    TransformerConfigClass = TransformerConfig
+    _CONFIG_MAPPING = {
+        'num_layers': 'num_hidden_layers', 'hidden_size': 'hidden_size',
+        'num_attention_heads': 'num_attention_heads', 'kv_channels': 'head_dim',
+        'layernorm_epsilon': 'rms_norm_eps',
+    }
+    _SHARED_STATE_DICT_MAPPING = {}
+
+    def _build_config(self):
+        from mindspeed_llm.tasks.models.transformer.deepseek41.native_config import text_config, validate
+        c = text_config(self.hf_config)
+        validate(c, tp=self.mpu.tp_size, cp=self.mpu.cp_size, pp=self.mpu.pp_size,
+                 ep=self.mpu.ep_size, etp=self.mpu.etp_size)
+        text_key = 'text_config' if hasattr(self.hf_config, 'text_config') else None
+        config = self._build_base_config(
+            text_config_key=text_key, num_query_groups=c['num_attention_heads'],
+            ffn_hidden_size=c['moe_intermediate_size'],
+            num_moe_experts=c['n_routed_experts'], moe_ffn_hidden_size=c['moe_intermediate_size'],
+            moe_shared_expert_intermediate_size=c['moe_intermediate_size'],
+            moe_router_topk=c['num_experts_per_tok'], moe_router_load_balancing_type='none',
+            moe_router_dtype='fp32', moe_aux_loss_coeff=0.0,
+            moe_shared_expert_overlap=False, moe_grouped_gemm=False,
+            moe_router_enable_expert_bias=False,  # frozen selection bias lives in V41Router
+            moe_token_dispatcher_type='alltoall',
+            hidden_dropout=0.0, attention_dropout=0.0,
+            gradient_accumulation_fusion=False, bias_activation_fusion=False,
+            recompute_granularity='full', recompute_method='uniform', recompute_num_layers=1)
+        config.v41_swiglu_limit = c['swiglu_limit']
+        config.v41_indexer_coefficient = c.get('indexer_aux_loss_coef', 0.1)
+        recompute = (config.recompute_granularity, config.recompute_method, config.recompute_num_layers)
+        if config.recompute_granularity is not None and recompute != ('full', 'uniform', 1):
+            raise ValueError(
+                'V4.1 supports full/uniform/one-layer recomputation or no recomputation; '
+                f'effective (granularity, method, num_layers)={recompute!r}. '
+                'Check mindspeed.override_transformer_config as well as llm_kwargs.'
+            )
+        return config
+
+    def _weight_name_mapping_mcore_to_hf(self, name):
+        from mindspeed_llm.tasks.models.transformer.deepseek41.native_config import checkpoint_names
+        return checkpoint_names(name)
+
+    def _get_safetensor_io(self, weights_path):
+        return V41TensorIO(self._get_actual_hf_path(weights_path), getattr(self, 'engram_crop', None), getattr(self, 'engram_source', None))
+
+    def _load_rank_owned_weight(self, model, name, hf_names, path, check_only=False):
+        if not name.endswith('.engram.embed.weight'):
+            return False
+        # Mapping names are unwrapped, while DDP/Float16Module named_parameters
+        # retain module prefixes. Match the same underlying parameter namespace.
+        param = dict(unwrap_model(model).named_parameters()).get(name)
+        if param is None or not getattr(param, 'engram_row_sharded', False):
+            raise ValueError('Missing rank-owned Engram parameter metadata: ' + name)
+        if check_only:
+            return True
+        from mindspeed_llm.tasks.models.transformer.deepseek41.full_engram_io import source_file, CHUNK_ROWS
+        key = hf_names[0]
+        root = getattr(self, 'engram_source', None) or path
+        with safe_open(source_file(root, key), framework='pt', device='cpu') as f:
+            value = f.get_slice(key)
+            if value.get_shape() != [param.engram_rows, param.engram_width] or value.get_dtype() != 'BF16':
+                raise ValueError('Engram shard source mismatch: ' + key)
+            with torch.no_grad():
+                param.zero_()
+                for start in range(param.engram_start, param.engram_end, CHUNK_ROWS):
+                    end = min(start + CHUNK_ROWS, param.engram_end)
+                    param[start-param.engram_start:end-param.engram_start].copy_(value[start:end])
+        return True
+
+    def _export_rank_owned_weight(self, name, param):
+        from mindspeed_llm.tasks.models.transformer.deepseek41.full_engram_io import chunks, chunk_name
+        import torch.distributed as dist
+        layer = int(name.split('decoder.layers.', 1)[1].split('.')[0])
+        rows, width = param.engram_rows, param.engram_width
+        size = (rows + dist.get_world_size() - 1) // dist.get_world_size()
+        # Reuse the native sender with bounded logical row chunks. No full-table
+        # gather, rank0 accumulator, disk export or new transport service.
+        for start, end in chunks(rows):
+            value = torch.empty((end-start, width), dtype=param.dtype, device=param.device)
+            for owner in range(start // size, (end-1) // size + 1):
+                lo, hi = max(start, owner*size), min(end, (owner+1)*size)
+                part = value[lo-start:hi-start]  # Contiguous destination view; broadcast directly into the chunk.
+                if dist.get_rank() == owner:
+                    # Export is a snapshot, not a differentiable broadcast. Detach
+                    # before copying so the temporary does not acquire CopyBackwards.
+                    part.copy_(param[lo-owner*size:hi-owner*size].detach())
+                dist.broadcast(part, src=owner)
+            yield chunk_name(layer, start, end), value
+
+    def _model_provider(self, post_model_creation_callbacks=(), **kwargs):
+        from mindspeed_llm.tasks.models.transformer.deepseek41.native_model import model_provider
+        def provide(pre_process=True, post_process=True, **unused):
+            model = model_provider(pre_process, post_process, config=self.config,
+                                   hf_config=self.hf_config, **kwargs)
+            for callback in post_model_creation_callbacks:
+                callback(model)
+            return model
+        return provide
