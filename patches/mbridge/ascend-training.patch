@@ -0,0 +1,115 @@
+"""V4.1 attention/mHC mapping contract, not a registered or complete bridge.
+
+Source namespace follows workspace/inference/model.py, NOT an asserted external
+HF checkpoint format. Shapes are unsharded logical weights. No quantization,
+TP slicing, MoE/Engram/vision/head conversion or real checkpoint loading here.
+Destination namespace is the proposed V4.1 layer contract, aligned with existing
+MindSpeed common attention names; its Megatron runtime is not yet wired. single_rank_adapter_mappings separately
+targets the executable standalone adapter namespace.
+"""
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class WeightMapping:
+    source: str
+    destination: str
+    shape: tuple[int, ...]
+
+
+def attention_mhc_mappings(config, plan):
+    d, h, hd = config["dim"], config["n_heads"], config["head_dim"]
+    qr, groups, out_rank = config["q_lora_rank"], config["o_groups"], config["o_lora_rank"]
+    ih, idim, hc = config["index_n_heads"], config["index_head_dim"], config["hc_mult"]
+    if min(d, h, hd, qr, groups, out_rank, ih, idim, hc) <= 0 or h % groups:
+        raise ValueError("positive dimensions and n_heads divisible by o_groups are required")
+    src = f"layers.{plan.layer_id}."
+    dst = f"decoder.layers.{plan.layer_id}."
+    entries = []
+
+    def add(source, destination, shape):
+        entries.append(WeightMapping(src + source, dst + destination, tuple(shape)))
+
+    for source, dest, shape in (
+        ("attn_norm.weight", "input_layernorm.weight", (d,)),
+        ("ffn_norm.weight", "pre_mlp_layernorm.weight", (d,)),
+        ("attn.attn_sink", "self_attention.attn_sink", (h,)),
+        ("attn.wq_a.weight", "self_attention.linear_q.weight", (qr, d)),
+        ("attn.q_norm.weight", "self_attention.q_layernorm.weight", (qr,)),
+        ("attn.wq_b.weight", "self_attention.linear_q_up_proj.weight", (h * hd, qr)),
+        ("attn.wkv.weight", "self_attention.linear_kv.weight", (hd, d)),
+        ("attn.kv_norm.weight", "self_attention.kv_layernorm.weight", (hd,)),
+        ("attn.wo_a.weight", "self_attention.linear_o_down_proj.weight", (groups * out_rank, h * hd // groups)),
+        ("attn.wo_b.weight", "self_attention.linear_o_up_proj.weight", (d, groups * out_rank)),
+    ):
+        add(source, dest, shape)
+    for source, destination in (("attn", "attn_mhc"), ("ffn", "mlp_mhc")):
+        mix = (2 + hc) * hc
+        add(f"hc_{source}_fn", f"{destination}.hc_fn.weight", (mix, hc * d))
+        add(f"hc_{source}_base", f"{destination}.hc_base", (mix,))
+        add(f"hc_{source}_scale", f"{destination}.hc_scale", (3,))
+    if plan.owns_kv:
+        add("attn.compressor.wkv.weight", "self_attention.compressor.wkv.weight", (hd, d))
+        add("attn.compressor.norm.weight", "self_attention.compressor.norm.weight", (hd,))
+        if plan.ratio == 2:
+            add("attn.compressor.wgate.weight", "self_attention.compressor.wgate.weight", (hd, d))
+    if plan.owns_indexer:
+        add("attn.indexer.wq_b.weight", "self_attention.indexer.wq_b.weight", (ih * idim, qr))
+        add("attn.indexer.weights_proj.weight", "self_attention.indexer.weights_proj.weight", (ih, d))
+        if plan.owns_kv:
+            add("attn.indexer.wk.weight", "self_attention.indexer.wk.weight", (idim, hd))
+            add("attn.indexer.k_norm.weight", "self_attention.indexer.k_norm.weight", (idim,))
+    return tuple(entries)
+
+
+def validate_source_shapes(mappings, shapes):
+    """Check scoped logical source shapes without allocating model parameters.
+
+    shapes maps names to dimension sequences (e.g. from checkpoint headers).
+    Extra checkpoint keys outside this mapping scope are intentionally ignored.
+    """
+    errors = []
+    for entry in mappings:
+        if entry.source not in shapes:
+            errors.append(f"missing {entry.source}")
+        elif tuple(shapes[entry.source]) != entry.shape:
+            errors.append(f"{entry.source}: expected {entry.shape}, got {tuple(shapes[entry.source])}")
+    if errors:
+        raise ValueError("\n".join(errors))
+
+
+def single_rank_adapter_mappings(config, plan):
+    """Executable attention/mHC scope for SingleRankTrainingAdapter.
+
+    Keep the proposed Megatron namespace above unchanged. This separate mapping
+    targets actual adapter parameters; FFN/final norm and other model weights
+    are deliberately outside its scope. Source format is still local inference.
+    """
+    replacements = {
+        'attn_norm.weight': 'attn_norm.weight',
+        'ffn_norm.weight': 'ffn_norm.weight',
+        'attn.attn_sink': 'attention.geometry.attn_sink',
+        'attn.wq_a.weight': 'attention.geometry.wq_a.weight',
+        'attn.q_norm.weight': 'attention.geometry.q_norm.weight',
+        'attn.wq_b.weight': 'attention.geometry.wq_b.weight',
+        'attn.wkv.weight': 'attention.geometry.wkv.weight',
+        'attn.kv_norm.weight': 'attention.geometry.kv_norm.weight',
+        'attn.wo_a.weight': 'attention.geometry.wo_a.weight',
+        'attn.wo_b.weight': 'attention.geometry.wo_b.weight',
+        'attn.compressor.norm.weight': 'attention.compressor.norm_weight',
+    }
+    for kind in ('attn', 'ffn'):
+        replacements[f'hc_{kind}_fn'] = f'{kind}_mhc.hc_fn.weight'
+        replacements[f'hc_{kind}_base'] = f'{kind}_mhc.hc_base'
+        replacements[f'hc_{kind}_scale'] = f'{kind}_mhc.hc_scale'
+    source_prefix = f'layers.{plan.layer_id}.'
+    entries = []
+    for entry in attention_mhc_mappings(config, plan):
+        suffix = entry.source[len(source_prefix):]
+        target = replacements.get(suffix)
+        if target is None and suffix.startswith(('attn.compressor.', 'attn.indexer.')):
+            target = 'attention.' + suffix[len('attn.'):]
+        if target is None:
+            raise ValueError(f'unmapped adapter parameter: {entry.source}')
+        entries.append(WeightMapping(entry.source, f'backbone.layers.{plan.layer_id}.{target}', entry.shape))
+    return tuple(entries)
