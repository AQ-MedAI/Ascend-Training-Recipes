+    def _save_file(self, states: dict[str, torch.Tensor], safetensor_file: str):
+        """Serialize in memory, then use ordinary sequential filesystem writes.
+
+        ``safetensors.serialize_file`` uses direct file operations that are not
+        supported by some shared filesystems.  The byte-oriented API produces
+        the identical safetensors format without using node-local temporary
+        files.  Write through a memoryview in chunks to avoid extra byte copies.
+        """
+        serialized = serialize(states)
+        serialized_view = memoryview(serialized)
+        try:
+            chunk_size = 16 * 1024 * 1024
+            with open(safetensor_file, "wb") as destination:
+                for offset in range(0, len(serialized_view), chunk_size):
+                    destination.write(serialized_view[offset : offset + chunk_size])
+        finally:
+            # Do not retain a complete serialized shard while the caller starts
+            # gathering tensors for the next shard.
+            serialized_view.release()
+            del serialized_view
+            del serialized
+
