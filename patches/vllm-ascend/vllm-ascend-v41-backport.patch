+/*!
+ * \file hc_pre_v41.cpp
+ * \brief
+ */
+
+#include "kernel_operator.h"
+#include "kernel_operator_intf.h"
+
+#if defined(__DAV_C310__)
+    #include "hc_pre_v41_m_k_split_core_arch35.h"
+    #include "hc_pre_v41_m_split_core_arch35.h"
+    #include "hc_pre_v41_base_arch35.h"
+    using namespace HcPreV41Ns;
+#else
+    #include "lib/matmul_intf.h"
+    #include "hc_pre_v41_m_k_split_core.h"
+    #include "hc_pre_v41_base.h"
+    using namespace HcPreV41;
+#endif
+
+using namespace AscendC;
+
+extern "C" __global__ __aicore__ void hc_pre_v41(GM_ADDR x, GM_ADDR hc_fn, GM_ADDR hc_scale, GM_ADDR hc_base,
+                                             GM_ADDR pre_mix, GM_ADDR y, GM_ADDR post, GM_ADDR comb_frag,
+                                             GM_ADDR pre, GM_ADDR workspace, GM_ADDR tiling)
+{
+    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
+    if (workspace == nullptr) {
+        return;
+    }
+
+    GM_ADDR userWs = GetUserWorkspace(workspace);
+    if (userWs == nullptr) {
+        return;
+    }
+    TPipe pipe;
+
+    // 950PR 950DT
+    #if defined(__DAV_C310__)
+        if (TILING_KEY_IS(1000)) {
+            GET_TILING_DATA_WITH_STRUCT(HcPreV41TilingData, tiling_data_in, tiling);
+            const HcPreV41TilingData *__restrict tilingData = &tiling_data_in;
+            HcPreV41Ns::HcPreV41MKSplitCorePart1<DTYPE_X> op;
+            op.Init(x, hc_fn, userWs, tilingData, &pipe);
+            op.Process();
+            pipe.Destroy();
+
+            TPipe pipeStage2;
+            HcPreV41Ns::HcPreV41MKSplitCorePart2<DTYPE_X> op2;
+            op2.Init(x, hc_scale, hc_base, y, post, comb_frag, userWs, tilingData, &pipeStage2);
+            op2.Process();
+            pipeStage2.Destroy();
+        } else if (TILING_KEY_IS(1001)) {
+            GET_TILING_DATA_WITH_STRUCT(HcPreV41TilingData, tiling_data_in, tiling);
+            const HcPreV41TilingData *__restrict tilingData = &tiling_data_in;
+            HcPreV41Ns::HcPreV41MSplitCorePart1<DTYPE_X> op;
+            op.Init(x, hc_fn, hc_scale, hc_base, y, post, comb_frag, tilingData, &pipe);
+            op.Process();
+        }
+    #else
+      // A3
+        if (TILING_KEY_IS(0)) {
+            GET_TILING_DATA_WITH_STRUCT(HcPreV41TilingData, tiling_data_in, tiling);
+            const HcPreV41TilingData *__restrict tilingData = &tiling_data_in;
+            HcPreV41::HcPreV41MembaseKSplitCorePart1<DTYPE_X> op;
+            op.Init(x, hc_fn, userWs, tilingData, &pipe);
+            op.Process();
+
+            pipe.Destroy();
+
+            TPipe pipeStage2;
+            HcPreV41::HcPreV41MembaseKSplitCorePart2<DTYPE_X> op2;
+            op2.Init(x, hc_scale, hc_base, y, post, comb_frag, pre_mix, pre, userWs, tilingData, &pipeStage2);
+            op2.Process();
+
+            pipeStage2.Destroy();
+        }
+    #endif
+}
