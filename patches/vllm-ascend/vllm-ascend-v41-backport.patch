+      <td>INT32</td>
+      <td>ND</td>
+    </tr>
+    <tr>
+      <td>cmp_topk_length</td>
+      <td>可选输入</td>
+      <td>预留输入，当前版本不支持传入非空Tensor。</td>
+      <td>INT32</td>
+      <td>ND</td>
+    </tr>
+    <tr>
+      <td>sinks</td>
+      <td>可选输入</td>
+      <td>表示attention sinks输入。</td>
