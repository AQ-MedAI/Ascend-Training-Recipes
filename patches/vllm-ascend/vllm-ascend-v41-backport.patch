+/*!
+ * \file sparse_flash_mla_v41_csa_block_cube.h
+ * \brief use 7 buffer for matmul l1, better pipeline
+ */
+#ifndef SPARSE_FLASH_MLA_V41_CSA_BLOCK_CUBE_H
+#define SPARSE_FLASH_MLA_V41_CSA_BLOCK_CUBE_H
+
+#include "kernel_operator.h"
+#include "kernel_operator_list_tensor_intf.h"
+#include "kernel_tiling/kernel_tiling.h"
+#include "lib/matmul_intf.h"
+#include "lib/matrix/matmul/tiling.h"
+#include "sparse_flash_mla_v41_common_arch22.h"
