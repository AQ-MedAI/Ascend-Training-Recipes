+    auto ret = aclrtMallocHost(&(tensor.hostAddr), size);
+    CHECK_LOG_RET(ret == ACL_SUCCESS, ret, "aclrtMallocHost failed. ERROR: %d", ret);
+    memset(tensor.hostAddr, 0, size);
