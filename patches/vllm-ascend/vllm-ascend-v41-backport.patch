+            k_shape = self.k_shape
+            k_scale_shape = [batch_size, k_seq, k_head_num]
+            if seqused_k is not None:
+                self.seqused_k = seqused_k
+                actual_seq_lengths_key = seqused_k
+                self.has_seqused_k = True
+            else:
