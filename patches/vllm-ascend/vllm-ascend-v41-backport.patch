+            slots,
+            scale.unsqueeze(-1).to(torch.float16),
+        )
+
+    def select(
+        self,
+        hidden_states,
+        qr,
+        positions,
+        cos,
+        sin,
+        source_cache,
+        source_metadata,
+        *,
