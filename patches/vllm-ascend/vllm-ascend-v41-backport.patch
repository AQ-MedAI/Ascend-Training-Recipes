+    __aicore__ inline int32_t AlignOriSparseIndexLoadCount(int32_t loadCount);
+    __aicore__ inline void LoadOriSparseIndicesGmToUb(uint64_t qTokenOffset, uint32_t n2Idx, uint32_t gmColStart,
