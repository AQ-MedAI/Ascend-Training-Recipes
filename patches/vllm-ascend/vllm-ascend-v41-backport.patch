+
+"""NPU-independent case selection, naming, and result helpers for QLI_V2 tests."""
+
+from pathlib import Path
+
+import pandas as pd
+import regex as re
+
+PARAM_NAMES = (
+    "batch_size",
+    "q_seq",
+    "k_seq",
+    "q_t_size",
+    "k_t_size",
+    "q_head_num",
+    "k_head_num",
+    "head_dim",
+    "block_size",
