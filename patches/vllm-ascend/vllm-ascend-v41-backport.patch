+
+        ## BSN1 -> BNS1   TN1 -> BNS1
+        is_weights = True
+        if self.layout_query == "TND":
+            wt_bnsd_tensor, wt_bnsd_shape = self.trans_shape_to_bnsd(
+                weights,
