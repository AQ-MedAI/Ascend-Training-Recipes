+#ifndef OP_API_INC_SCATTER_ND_UPDATE_SK_H_
+#define OP_API_INC_SCATTER_ND_UPDATE_SK_H_
+
+#include "aclnn/aclnn_base.h"
+#include "aclnn_util.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
