+__aicore__ inline void VFSigmoid(RegTensor<float> &y, RegTensor<float> &x, RegTensor<float> &one, MaskReg pregLoop)
+{
+    Muls(x, x, static_cast<float>(-1), pregLoop);
+    Exp(x, x, pregLoop);
+    Adds(x, x, static_cast<float>(1), pregLoop);
+    Div(y, one, x, pregLoop);
+}
