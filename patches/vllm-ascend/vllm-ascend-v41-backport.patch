+            gert::InferDataTypeContextFaker()
+                .NodeIoNum(13, 2)
+                .NodeOutputTd(0, ge::FORMAT_ND, ge::FORMAT_ND)
+                .NodeOutputTd(1, ge::FORMAT_ND, ge::FORMAT_ND)
