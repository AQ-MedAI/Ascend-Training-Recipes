+template <typename SMLAT>
+__aicore__ inline void SparseFlashMlaV41Csa<SMLAT>::InitBuffers()
+{
+    if ASCEND_IS_AIV {
+        vectorBlock.InitBuffers(pipe);
+    } else {
+        cubeBlock.InitBuffers(pipe);
+    }
+}
