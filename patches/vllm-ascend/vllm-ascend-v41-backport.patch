+private:
+    __aicore__ inline void GetKeyScale(const QLIV2Common::RunInfo &runInfo, const LocalTensor<half> &resUb,
+                                       int64_t batchId, int64_t startS2, int64_t getLen);
+    // candidate (two-level topk)
