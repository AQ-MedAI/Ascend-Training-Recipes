+
+        ## BSND/TND/ -> BNSD
+        if self.layout_key == "TND":
+            k_bnsd_tensor, k_bnsd_shape = self.trans_shape_to_bnsd(
+                key, k_shape, layout_key, k_head_num, self.cu_seqlens_k
