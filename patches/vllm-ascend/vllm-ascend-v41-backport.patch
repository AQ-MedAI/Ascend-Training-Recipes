+    const aclTensor *keyDequantScale,
+    const aclTensor *cuSeqLensQOptional,
+    const aclTensor *cuSeqLensKOptional,
+    const aclTensor *sequsedQOptional,
+    const aclTensor *sequsedKOptional,
+    const aclTensor *cmpResidualKOptional,
