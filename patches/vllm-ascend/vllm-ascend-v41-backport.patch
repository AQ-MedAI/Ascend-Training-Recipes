+ge::graphStatus SparseFlashMlaV41Checker::Process() const
+{
+    sparse_mla_checker::CheckerRunner runner;
+    sparse_mla_checker::RegisterCommonCheckers(runner);
+    return runner.Process(BuildContext(info_));
+}
