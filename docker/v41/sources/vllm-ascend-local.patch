@@ -82,3 +82,28 @@ def test_RMSNorm_forward_310p(mock_add_rmsnorm, mock_rmsnorm, residual, dummy_te
         expected_out_x = dummy_tensor + 1
         mock_rmsnorm.assert_called_once()
         assert torch.allclose(out_x, expected_out_x)
+
+
+@pytest.mark.parametrize("has_weight", [False, True])
+def test_rmsnorm_identity_survives_buffer_restore(default_vllm_config, has_weight):
+    from vllm_ascend.ops.layernorm import AscendRMSNorm
+
+    default_vllm_config.quant_config = None
+    layer = AscendRMSNorm(hidden_size=512, has_weight=has_weight, dtype=torch.bfloat16)
+    if has_weight:
+        assert "weight" in dict(layer.named_parameters())
+        assert "weight" in layer.state_dict()
+        assert "weight" not in dict(layer.named_buffers())
+        return
+
+    assert "weight" not in dict(layer.named_parameters())
+    assert "weight" not in layer.state_dict()
+    assert dict(layer.named_buffers())["weight"] is layer.weight
+    assert not layer.weight.requires_grad
+    # Mirror the worker's level-2 save/restore across repeated sync cycles.
+    for _ in range(2):
+        saved = {name: value.cpu().clone() for name, value in layer.named_buffers()}
+        layer.weight.zero_()  # Simulate discarded allocator storage.
+        for name, value in layer.named_buffers():
+            value.copy_(saved[name])
+        assert torch.equal(layer.weight, torch.ones(512, dtype=torch.bfloat16))
