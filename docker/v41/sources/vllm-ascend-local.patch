+                for i, tensor in enumerate(pair):
+                    self.assertEqual(tensor.data_ptr(), ptrs[i])
+                    self.assertTrue(torch.equal(tensor, saved[i]))
+                actual = self.lookup(positions)
+                for a, b in zip(actual, expected):
+                    self.assertTrue(torch.equal(a["layer0"], b))
+
+
+if __name__ == "__main__":
+    unittest.main()
