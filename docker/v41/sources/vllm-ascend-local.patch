+"""CPU-only regression for actual Worker sleep/wake methods, with runtime stubs.
+
+Run directly with Python 3.10+; no NPU/torch import is needed.
+"""
+import ast
+from pathlib import Path
+from types import SimpleNamespace as NS
+import unittest
+
+
+class Tensor:
+    def __init__(self, shape, stride=None):
+        self.shape = shape
+        self.stride = stride or (shape[1] * shape[2], shape[2], 1)
+
+    def transpose(self, a, b):
+        shape, stride = list(self.shape), list(self.stride)
+        shape[a], shape[b] = shape[b], shape[a]
+        stride[a], stride[b] = stride[b], stride[a]
+        return Tensor(tuple(shape), tuple(stride))
+
+
+class SleepLayoutTest(unittest.TestCase):
+    def setUp(self):
+        source = Path(__file__).resolve().parents[3] / "vllm_ascend/worker/worker.py"
+        tree = ast.parse(source.read_text())
+        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and
+                   any(isinstance(x, ast.FunctionDef) and x.name == "wake_up" for x in n.body))
+        methods = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name in {"sleep", "wake_up"}]
+        self.allocator = NS(sleep=lambda **kw: None, wake_up=lambda **kw: None)
+        env = {"torch": NS(npu=NS(mem_get_info=lambda: (1024, 2048)),
+                            nn=NS(Parameter=lambda value, **kw: value)),
+               "CaMemAllocator": NS(get_instance=lambda: self.allocator),
+               "get_ascend_config": lambda: NS(weight_nz_mode=0),
+               "GiB_bytes": 1024**3, "logger": NS(info=lambda *a: None)}
+        exec(compile(ast.Module(body=methods, type_ignores=[]), str(source), "exec"), env)
+        self.sleep, self.wake = env["sleep"], env["wake_up"]
+        self.experts = NS(w13_weight=Tensor((1, 4, 4)), w2_weight=Tensor((1, 2, 4)))
+        model = NS(named_parameters=lambda: [("experts." + k, v) for k, v in vars(self.experts).items()],
+                   named_buffers=lambda: [], get_submodule=lambda name: self.experts)
+        self.worker = NS(model_runner=NS(model=model), _sleep_saved_buffers={},
+                         vllm_config=NS(quant_config=None, model_config=NS(hf_text_config=NS(hidden_size=4))))
+
+    def test_level1_preserves_parameter_objects_and_layout(self):
+        before = dict(vars(self.experts))
+        for _ in range(2):
+            self.sleep(self.worker, 1)
+            self.wake(self.worker, ["weights"])
+            self.wake(self.worker, ["kv_cache"])
+            for name, value in before.items():
+                self.assertIs(getattr(self.experts, name), value)
+        self.assertEqual(self.experts.w13_weight.stride, (16, 4, 1))
+        self.assertEqual(self.experts.w2_weight.shape, (1, 2, 4))
+
+    def test_level2_retains_loading_layout_conversion_once(self):
+        self.sleep(self.worker, 2)
+        self.wake(self.worker, ["kv_cache"])
+        self.assertTrue(self.worker._moe_layout_reset_pending)
+        self.wake(self.worker, ["weights"])
+        self.assertEqual(self.experts.w13_weight.stride, (16, 1, 4))
+        self.assertEqual(self.experts.w2_weight.shape, (1, 4, 2))
+        before = dict(vars(self.experts))
+        self.wake(self.worker, ["weights"])
+        for name, value in before.items():
+            self.assertIs(getattr(self.experts, name), value)
+
+    def test_level1_all_tags(self):
+        before = self.experts.w13_weight
+        self.sleep(self.worker, 1)
