+"""CPU checks of production dispatch preprocessing; NPU audit is still required."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import patch
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+class TestDispatcherSleep(unittest.TestCase):
+    def make_dispatcher(self, local_experts, counts):
+        source = ast.parse((ROOT / "vllm_ascend/ops/fused_moe/token_dispatcher.py").read_text())
+        cls = next(n for n in source.body if isinstance(n, ast.ClassDef)
+                   and n.name == "TokenDispatcherWithAll2AllV")
+        method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "_preprocess")
+        ns = {"torch": torch, "gather_from_sequence_parallel_region": lambda value, group: counts}
+        exec(compile(ast.Module(body=[method], type_ignores=[]), "dispatcher-preprocess", "exec"), ns)
+        dispatcher = NS(num_experts=counts.shape[1], num_local_experts=local_experts,
+                        ep_size=counts.shape[0], ep_group=None,
+                        local_expert_indices=list(range(local_experts)))
+        dispatcher.preprocess = ns["_preprocess"].__get__(dispatcher)
+        return dispatcher
+
+    def test_repeated_calls_ignore_lost_device_constant(self):
+        # Two sender ranks, two local experts; include an empty expert segment.
+        counts = torch.tensor([[2, 0, 1, 1], [1, 3, 0, 0]], dtype=torch.int64)
+        dispatcher = self.make_dispatcher(2, counts)
+        ids = torch.tensor([0., 0., 2., 3.])
+        expected = torch.tensor([0, 0, 0, 1, 1, 1], dtype=torch.int32)
+        baseline = dispatcher.preprocess(ids)
+        self.assertTrue(torch.equal(baseline[3], expected))
+        for poison in (-1, 99):
+            # Even a stale/corrupt attribute from the old implementation must
+            # never influence grouping. Also corrupt the previous output.
+            dispatcher.expert_ids_per_ep_rank = torch.full((4,), poison, dtype=torch.int32)
+            baseline[3].fill_(poison)
+            result = dispatcher.preprocess(ids)
+            self.assertTrue(torch.equal(result[3], expected))
+            self.assertTrue(torch.equal(result[0], torch.tensor([3, 3])))
+            self.assertEqual(result[1].tolist(), [2, 2])
+            self.assertEqual(result[2].tolist(), [2, 4])
+            self.assertEqual(result[4], 4)
+            baseline = result
+
+    def test_empty_received_tokens(self):
+        counts = torch.zeros((2, 4), dtype=torch.int64)
+        dispatcher = self.make_dispatcher(2, counts)
+        result = dispatcher.preprocess(torch.empty(0))
+        self.assertEqual(result[3].numel(), 0)
+        self.assertEqual(result[3].dtype, torch.int32)
+
+    def test_single_expert_keeps_existing_path(self):
+        counts = torch.tensor([[2, 0], [3, 0]], dtype=torch.int64)
+        dispatcher = self.make_dispatcher(1, counts)
+        with patch.object(torch, "npu", NS(synchronize=lambda: None), create=True):
