+        wanted = {"RopeGlobalState", "RopeDataProxy", "ComplexExpRotaryEmbedding", "get_cos_and_sin_dsa"}
+        nodes = [n for n in tree.body if isinstance(n, (ast.ClassDef, ast.FunctionDef)) and n.name in wanted]
+        env = dict(torch=torch, nn=nn, Any=Any, VllmConfig=NS, current_platform=NS(device_type="cpu"))
+        exec(compile(ast.Module(body=nodes, type_ignores=[]), str(path), "exec"), env)
+        self.state = env["RopeGlobalState"]()
+        env["_ROPE_STATE"] = self.state
+        cfg = NS(speculative_config=None, scheduler_config=NS(max_num_batched_tokens=8))
+        def make(name):
+            return env["ComplexExpRotaryEmbedding"](cfg, name, 4, 4, 16, 0, 10000, 1)
+        self.model = nn.ModuleList([make("layer0"), make("layer1")])
+        self.lookup = env["get_cos_and_sin_dsa"]
+        path = ROOT / "vllm_ascend/worker/worker.py"
+        tree = ast.parse(path.read_text())
+        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and any(
+            isinstance(m, ast.FunctionDef) and m.name == "wake_up" for m in n.body))
+        methods = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name in {"sleep", "wake_up"}]
+        def discard(**kwargs):
+            self.assertEqual(kwargs["offload_tags"], ())
+            for pair in self.state.full_rope_cache.values():
+                for tensor in pair:
+                    tensor.fill_(float("nan"))
+        allocator = NS(sleep=discard, wake_up=lambda **kwargs: None)
+        worker_env = dict(torch=torch, CaMemAllocator=NS(get_instance=lambda: allocator),
+                          get_ascend_config=lambda: NS(weight_nz_mode=0),
+                          GiB_bytes=1024**3, logger=NS(info=lambda *args: None))
+        exec(compile(ast.Module(body=methods, type_ignores=[]), str(path), "exec"), worker_env)
+        self.sleep, self.wake = worker_env["sleep"], worker_env["wake_up"]
+        self.worker = NS(model_runner=NS(model=self.model), _sleep_saved_buffers={},
+                         vllm_config=NS(quant_config=None, model_config=NS(hf_text_config=NS(hidden_size=4))))
+
+    def test_shared_buffers_not_checkpoint_weights(self):
+        self.assertIs(self.model[0].full_rope_cos, self.model[1].full_rope_cos)
+        self.assertEqual(len(list(self.model.named_buffers())), 2)
+        self.assertEqual(dict(self.model.state_dict()), {})
+        pair = next(iter(self.state.full_rope_cache.values()))
+        self.assertIs(pair[0], self.model[0].full_rope_cos)
+        self.assertIs(pair[1], self.model[0].full_rope_sin)
+
+    def test_level2_restores_global_tables_and_lookup_in_place(self):
+        positions = torch.tensor([0, 1, 7, 15])
+        expected = self.lookup(positions)
+        # Snapshot expected lookup data before the backing tables are discarded.
+        expected = tuple(proxy["layer0"].clone() for proxy in expected)
+        pair = next(iter(self.state.full_rope_cache.values()))
+        saved = [t.clone() for t in pair]
+        ptrs = [t.data_ptr() for t in pair]
+        with patch.object(torch, "npu", NS(mem_get_info=lambda: (1024, 2048)), create=True):
+            for _ in range(2):
+                self.sleep(self.worker, 2)
