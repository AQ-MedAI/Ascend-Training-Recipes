new file mode 100644
index 0000000000000000000000000000000000000000..f45eaba70b455c94a53c62ade3a8c71f4b3bf05f
--- /dev/null
+++ b/tests/ut/ops/test_v4_gate_graph_reload.py
@@ -0,0 +1,55 @@
+"""CPU regression of production reload; retained tensor models a graph reference."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace as NS
+import unittest
+import torch
+
+ROOT = Path(__file__).resolve().parents[3]
+
+class GateReloadTests(unittest.TestCase):
+    def setUp(self):
+        tree = ast.parse((ROOT / "vllm_ascend/ops/linear.py").read_text())
+        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef)
+                   and n.name == "AscendUnquantizedLinearMethod")
+        cls.body = [n for n in cls.body if isinstance(n, ast.FunctionDef)
+                    and n.name == "process_weights_after_loading"]
+        class Base:
+            def process_weights_after_loading(self, layer):
+                pass
+        ns = {'torch': torch, 'UnquantizedLinearMethod': Base,
+              '_should_keep_nd_for_310p_weight': lambda w: False,
+              'maybe_trans_nz': lambda w: w}
+        exec(compile(ast.Module(body=[cls], type_ignores=[]), "linear-reload", "exec"), ns)
+        self.method = ns[cls.name]()
+        self.layer = NS(weight=torch.nn.Parameter(torch.arange(12, dtype=torch.bfloat16).reshape(3, 4)),
+                        precast_fp32_weight=True, prefix='mlp.gate')
+
+    def test_repeated_reload_updates_captured_storage(self):
+        self.method.process_weights_after_loading(self.layer)
+        captured = self.layer.weight_fp32
+        ptr = captured.data_ptr()
+        x = torch.ones(1, 4)
+        for offset in (10, 20):
+            captured.zero_()  # Simulate discarded contents after level-2 remapping.
+            self.layer.weight.data.add_(offset)
+            self.method.process_weights_after_loading(self.layer)
+            self.assertIs(self.layer.weight_fp32, captured)
+            self.assertEqual(captured.data_ptr(), ptr)
+            self.assertTrue(torch.equal(x @ captured.T, x @ self.layer.weight.float().T))
+
+    def test_shape_change_fails_without_replacing_cache(self):
+        self.method.process_weights_after_loading(self.layer)
+        captured = self.layer.weight_fp32
+        self.layer.weight = torch.nn.Parameter(torch.ones(2, 4, dtype=torch.bfloat16))
+        with self.assertRaisesRegex(ValueError, 'layout changed'):
+            self.method.process_weights_after_loading(self.layer)
+        self.assertIs(self.layer.weight_fp32, captured)
+
+    def test_non_precast_layer_does_not_create_cache(self):
+        self.layer.precast_fp32_weight = False
+        self.method.process_weights_after_loading(self.layer)
+        self.assertFalse(hasattr(self.layer, 'weight_fp32'))
+
+if __name__ == '__main__':
+    unittest.main()
