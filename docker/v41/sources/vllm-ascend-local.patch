index 0000000000000000000000000000000000000000..1a401ab30dbe6653b9f3b80fefef831d474c51b6
--- /dev/null
+++ b/tests/ut/distributed/test_weight_device_context_standalone_olmo.py
@@ -0,0 +1,59 @@
+"""Test weight-update device contexts without loading vLLM or an NPU."""
+
+import ast
+import contextlib
+import pathlib
+import types
+import unittest
+from unittest.mock import Mock
+
+SOURCE = pathlib.Path(__file__).resolve().parents[3] / "vllm_ascend/worker/worker.py"
+
+
+class RemoveImports(ast.NodeTransformer):
+    def visit_ImportFrom(self, node):
+        return ast.copy_location(ast.Pass(), node)
+
+
+class DeviceContextTests(unittest.TestCase):
+    def test_all_update_stages_pass_device_as_single_argument(self):
+        tree = ast.parse(SOURCE.read_text())
+        names = {"start_weight_update", "update_weights", "finish_weight_update"}
+        methods = [node for node in ast.walk(tree) if isinstance(node, ast.FunctionDef) and node.name in names]
+        self.assertEqual(len(methods), 3)
+        methods = [RemoveImports().visit(node) for node in methods]
+        calls = []
+
+        def device(value):
+            calls.append(value)
+            return contextlib.nullcontext()
+
+        class RuntimeDevice:
+            def __str__(self):
+                return "npu:0"
+
+        namespace = {
+            "torch": types.SimpleNamespace(device=device, npu=types.SimpleNamespace(synchronize=Mock())),
+            "diagnostics": types.SimpleNamespace(traced=lambda _: lambda f: f,
+                                                 phase=lambda _: contextlib.nullcontext()),
+            "initialize_layerwise_reload": Mock(), "finalize_layerwise_reload": Mock(),
+        }
+        exec(compile(ast.Module(body=methods, type_ignores=[]), str(SOURCE), "exec"), namespace)
+        worker = types.SimpleNamespace(
+            device=RuntimeDevice(), _check_weight_transfer_engine=Mock(), _check_nz_disabled=Mock(),
+            _weight_update_active=False, model_runner=types.SimpleNamespace(model=Mock()),
+            model_config=Mock(), weight_transfer_engine=Mock(),
+        )
+        namespace["start_weight_update"](worker)
+        self.assertTrue(worker._weight_update_active)
+        namespace["update_weights"](worker, {})
+        namespace["finish_weight_update"](worker)
+        self.assertFalse(worker._weight_update_active)
+        self.assertEqual(len(calls), 3)
+        self.assertTrue(all(value is worker.device for value in calls))
+        worker.weight_transfer_engine.receive_weights.assert_called_once()
+        namespace["torch"].npu.synchronize.assert_called_once()
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/ut/distributed/test_weight_diagnostics_standalone_olmo.py b/tests/ut/distributed/test_weight_diagnostics_standalone_olmo.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbde7cd5c7fbe1d2fdff976d0b40f4db742604c2
--- /dev/null
+++ b/tests/ut/distributed/test_weight_diagnostics_standalone_olmo.py
@@ -0,0 +1,90 @@
+"""Run with unittest directly; no NPU, torch or vLLM imports required."""
+
+import importlib.util
+import json
+import pathlib
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+from unittest.mock import patch
+
+SOURCE = pathlib.Path(__file__).resolve().parents[3] / "vllm_ascend/distributed/weight_transfer/diagnostics.py"
+
+
+def load(root):
+    envs = types.SimpleNamespace(
+        VLLM_ASCEND_WEIGHT_DIAG=True, VLLM_ASCEND_WEIGHT_DIAG_DIR=root, VLLM_ASCEND_WEIGHT_DIAG_TIMEOUT=1
+    )
+    spec = importlib.util.spec_from_file_location("diagnostics_under_test", SOURCE)
+    module = importlib.util.module_from_spec(spec)
+    with patch.dict(sys.modules, {"vllm_ascend": types.SimpleNamespace(envs=envs)}):
+        spec.loader.exec_module(module)
+    return module
+
+
+class DiagnosticsTests(unittest.TestCase):
+    def test_nested_scopes_and_exception_preserved(self):
+        with tempfile.TemporaryDirectory() as root:
+            module = load(root)
+            original = ValueError("original failure")
+            with (
+                patch.object(module.faulthandler, "dump_traceback_later") as arm,
+                patch.object(module.faulthandler, "cancel_dump_traceback_later") as cancel,
+                patch.object(module.faulthandler, "dump_traceback"),
+            ):
+                with (
+                    self.assertRaises(ValueError) as raised,
+                    module.phase("outer", model_step=606),
+                    module.phase("inner", name="embedding"),
+                ):
+                    raise original
+                self.assertIs(raised.exception, original)
+                arm.assert_called_once()
+                cancel.assert_called_once()
+            events = [json.loads(line) for line in next(pathlib.Path(root).rglob("*.jsonl")).read_text().splitlines()]
+            self.assertEqual(
+                [row["phase"] for row in events], ["outer.begin", "inner.begin", "inner.error", "outer.error"]
+            )
+            module._events.close()
+            module._stacks.close()
+
+    def test_io_failure_does_not_mask_training_error(self):
+        with tempfile.TemporaryDirectory() as root:
+            module = load(root)
+            with (
+                patch.object(module, "_open", side_effect=OSError("disk unavailable")),
+                self.assertRaisesRegex(RuntimeError, "training error"),
+                module.phase("failed_io"),
+            ):
+                raise RuntimeError("training error")
+
+    def test_disabled_no_files(self):
+        with tempfile.TemporaryDirectory() as root:
+            module = load(root)
+            module.envs.VLLM_ASCEND_WEIGHT_DIAG = False
+            with module.phase("disabled"):
+                module.event("disabled")
+            self.assertEqual(list(pathlib.Path(root).iterdir()), [])
+
+    def test_watchdog_writes_stack_without_crashing_process(self):
+        with tempfile.TemporaryDirectory() as root:
+            code = f"""
+import importlib.util, time
+spec = importlib.util.spec_from_file_location('test_helpers', {str(pathlib.Path(__file__))!r})
+helpers = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(helpers)
+module = helpers.load({root!r})
+with module.phase('blocked'):
+    time.sleep(2.2)
+"""
+            subprocess.run([sys.executable, "-c", code], check=True, timeout=15, capture_output=True)
+            stack = next(pathlib.Path(root).rglob("*.stacks.log")).read_text()
+            self.assertIn("Timeout", stack)
+            events = next(pathlib.Path(root).rglob("*.jsonl")).read_text()
+            self.assertIn("blocked.end", events)
+
+
+if __name__ == "__main__":
+    unittest.main()
