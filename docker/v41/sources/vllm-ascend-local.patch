@@ -0,0 +1,127 @@
+"""Host-side weight transfer evidence; never synchronizes the accelerator.
+
+Uses the process-wide faulthandler timer while diagnostic scopes are active.
+Do not combine with another user of dump_traceback_later in the same process.
+"""
+
+import faulthandler
+import functools
+import json
+import os
+import socket
+import sys
+import threading
+import time
+from contextlib import contextmanager
+from pathlib import Path
+
+from vllm_ascend import envs
+
+_lock = threading.RLock()
+_pid = None
+_events = None
+_stacks = None
+_active = 0
+_serial = 0
+
+
+def _open():
+    global _pid, _events, _stacks, _active
+    if _pid == os.getpid():
+        return
+    root = Path(envs.VLLM_ASCEND_WEIGHT_DIAG_DIR) / socket.gethostname()
+    root.mkdir(parents=True, exist_ok=True)
+    stem = f"{os.getpid()}-{time.time_ns()}"
+    _events = (root / f"{stem}.jsonl").open("a", buffering=1)
+    _stacks = (root / f"{stem}.stacks.log").open("a", buffering=1)
+    _pid = os.getpid()
+    _active = 0
+    print(f"[Weight diagnostics] pid={_pid} events={_events.name} stacks={_stacks.name}", file=sys.stderr)
+
+
+def event(phase, **fields):
+    """Flush each event so the last submitted operation survives a process exit."""
+    if not envs.VLLM_ASCEND_WEIGHT_DIAG:
+        return
+    try:
+        with _lock:
+            _open()
+            _events.write(
+                json.dumps(
+                    dict(
+                        time_ns=time.time_ns(),
+                        monotonic=time.monotonic(),
+                        host=socket.gethostname(),
+                        pid=os.getpid(),
+                        ppid=os.getppid(),
+                        thread=threading.get_ident(),
+                        visible_devices=os.environ.get("ASCEND_RT_VISIBLE_DEVICES"),
+                        port=os.environ.get("VLLM_PORT"),
+                        phase=phase,
+                        **fields,
+                    ),
+                    default=str,
+                )
+                + "\n"
+            )
+    except Exception as exc:
+        print(f"[Weight diagnostics unavailable] {exc!r}", file=sys.stderr)
+
+
+@contextmanager
+def phase(label, **fields):
+    global _active, _serial
+    if not envs.VLLM_ASCEND_WEIGHT_DIAG:
+        yield
+        return
+    armed = False
+    operation = None
+    start = time.monotonic()
+    try:
+        with _lock:
+            _open()
+            _serial += 1
+            operation = _serial
+            if _active == 0:
+                _stacks.write(f"\nwatchdog armed time_ns={time.time_ns()} phase={label}\n")
+                faulthandler.dump_traceback_later(
+                    max(1, envs.VLLM_ASCEND_WEIGHT_DIAG_TIMEOUT),
+                    repeat=True,
+                    file=_stacks,
+                )
+            _active += 1
+            armed = True
+    except Exception as exc:
+        print(f"[Weight watchdog unavailable] {exc!r}", file=sys.stderr)
+    event(label + ".begin", operation=operation, **fields)
+    try:
+        yield
+    except BaseException as exc:
+        event(label + ".error", operation=operation, elapsed_s=time.monotonic() - start, error=repr(exc), **fields)
+        if armed:
+            try:
+                with _lock:
+                    faulthandler.dump_traceback(file=_stacks, all_threads=True)
+            except Exception:
+                pass
+        raise
+    else:
+        event(label + ".end", operation=operation, elapsed_s=time.monotonic() - start, **fields)
+    finally:
+        if armed:
+            with _lock:
+                _active -= 1
+                if _active == 0:
+                    faulthandler.cancel_dump_traceback_later()
+
+
+def traced(name):
+    def decorate(func):
+        @functools.wraps(func)
+        def wrapped(*args, **kwargs):
+            with phase(name):
+                return func(*args, **kwargs)
+
+        return wrapped
+
+    return decorate
